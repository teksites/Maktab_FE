@page "/register/customer"

@inherits BaseFormComponent<RegisterCustomer>

@using System.Text.RegularExpressions
@using System.ComponentModel.DataAnnotations
@using MaktabDataContracts.Enums
@using MaktabDataContracts.Requests.Users

@inject IUserService UserService

<MudGrid Justify="Justify.Center">

     <MudItem xs="12" sm="7">
          <MudPaper Class="pa-4">
               <MudText Typo="Typo.h4" Class="mb-6 text-center">Register User</MudText>
               <MudForm @ref="_form" @bind-IsValid="@_isValid" OnValidSubmit="@(HandlerRegisterUser)" Validated="@(OnFormValidated)">
                    <MudTextField T="string" @bind-Value="addUserInformation.FirstName" Label="First name" Required="true" RequiredError="First name is required!" />
                    <MudTextField T="string" @bind-Value="addUserInformation.LastName" Label="Last name" Required="true" RequiredError="Last name is required!" />
                    <MudTextField T="string" @bind-Value="addUserInformation.Email" Label="Email" Required="true" RequiredError="Email is required!"
                                  Validation="@(new EmailAddressAttribute() {ErrorMessage = "The email address is invalid"})" />
                    <MudTextField T="string" @bind-Value="addUserInformation.Phone" Label="Phone" Required="true" RequiredError="Phone number is required!"
                                  Validation="@(new PhoneAttribute() { ErrorMessage = "The phone number is invalid"})" />

                    <MudSelect @bind-Value="addUserInformation.Relationship" Label="Relationship">
                         @foreach (var margin in relationShips)
                         {
                              <MudSelectItem Value="margin">@margin</MudSelectItem>
                         }
                    </MudSelect>

                    <MudTextField T="string" Label="Password" HelperText="Choose a strong password" @ref="pwField1"
                                  InputType="InputType.Password"
                                  Validation="@(new Func<string, IEnumerable<string>>(PasswordStrength))" Required="true"
                                  RequiredError="Password is required!" />
                    <MudTextField T="string"
                                  Label="Password" HelperText="Repeat the password" InputType="InputType.Password"
                                  Validation="@(new Func<string, string>(PasswordMatch))" />

                    @if (!string.IsNullOrWhiteSpace(_errorMessage))
                    {
                         <MudAlert Severity="Severity.Error" Elevation="0" Class="my-4">
                              @_errorMessage
                         </MudAlert>
                    }

                    <MudStack Direction="Row" Justify="Justify.SpaceBetween" Spacing="4" Class="mt-6">
@*                          <MudText Class="mt-2">
                              <MudLink Href="/account/login" Color="Color.Tertiary">LogIn</MudLink>
                         </MudText> *@

                         <MudCheckBox T="bool" Required="true" RequiredError="You must agree" Label="I agree to terms and conditions of Matkab!" />

                         <MudButton Type="Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!_isValid || IsRegistering)" OnClick="@(HandlerRegisterUser)">
                              @if (IsRegistering)
                              {
                                   <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                                   <span>Registering...</span>
                              }
                              else
                              {
                                   <span>Register</span>
                              }
                         </MudButton>

                         <MudButton Href="/account/login" Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(!_isValid || IsRegistering)">LogIn</MudButton>

                    </MudStack>


                    
@*                     <div class="d-flex align-center justify-space-between">
                         
                         <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!success)" Class="ml-auto">Register</MudButton>

                         @if (!string.IsNullOrWhiteSpace(_errorMessage))
                         {
                              <MudAlert Severity="Severity.Error" Elevation="0" Class="mt-2">@_errorMessage</MudAlert>
                         }
                    </div> *@
               </MudForm>
          </MudPaper>
          @* <MudPaper Class="pa-4 mt-4">
               <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false" OnClick="@(() => form.Validate())">Validate</MudButton>
               <MudButton Variant="Variant.Filled" Color="Color.Secondary" DropShadow="false" OnClick="@(() => form.ResetAsync())" Class="mx-2">Reset</MudButton>
               <MudButton Variant="Variant.Filled" DropShadow="false" OnClick="@(() => form.ResetValidation())">Reset Validation</MudButton>
          </MudPaper> *@
     </MudItem>
     @* <MudItem xs="12" sm="5">
          <MudPaper Class="pa-4 mud-height-full">
               <MudText Typo="Typo.subtitle2">@($"Errors ({errors.Length})")</MudText>
               @foreach (var error in errors)
               {
                    <MudText Color="@Color.Error">@error</MudText>
               }
          </MudPaper>
     </MudItem> *@
</MudGrid>

@code {

     AddUserInformation addUserInformation = new AddUserInformation();
     bool IsRegistering;
     MudTextField<string> pwField1;
     IEnumerable<Relationship> relationShips = Array.Empty<Relationship>();

     protected override async Task OnInitializedAsync()
     {
          await base.OnInitializedAsync();

          relationShips = Enum.GetValues(typeof(Relationship)).Cast<Relationship>().Where(x => x == Relationship.Mother || x == Relationship.Father);
     }

    
     private string PasswordMatch(string arg)
     {
          if (pwField1.Value != arg)
               return "Passwords don't match";
          return null;
     }

     private async void HandlerRegisterUser()
     {
          try
          {
               IsRegistering = true;
               RequestRender();

               await InvokeUserAction(RegisterUser);

          }
          finally
          {
               IsRegistering = false;
               RequestRender();
          }
     }

     private async Task RegisterUser()
     {
          addUserInformation.Email = addUserInformation.Email.ToLowerInvariant();
          addUserInformation.UserName = addUserInformation.Email;

          var isUserExists = await UserService.ValidateUsernameAsync(addUserInformation.UserName);
          if (isUserExists)
          {
               _errorMessage = "User is already registered with system; Please login to continue.";
               Snackbar.Add(_errorMessage, Severity.Error);
               return;
          }

          addUserInformation.Password = pwField1.Value;
          var result = await UserService.RegisterUserAsync(addUserInformation);
          if (result != null)
          {
               Snackbar.Add("User has been created.", Severity.Success);
               // Redirect after successful login
               NavigationManager.NavigateTo("/account/login");
          }
     }
}
