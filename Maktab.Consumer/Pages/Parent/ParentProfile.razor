@page "/parent/profile"
@attribute [Authorize]

@using Maktab.Consumer.Dialogs
@using MaktabDataContracts.Responses.Children
@using MaktabDataContracts.Responses.Course
@using MaktabDataContracts.Responses.OtherContacts
@using MaktabDataContracts.Responses.Users
@using Microsoft.AspNetCore.Authorization

@inherits BaseComponent<ParentProfile>

@inject IUserService UserService
@inject IChildrenService ChildrenService
@inject ICourseService CourseService
@inject ICourseEnrollmentService CourseEnrollmentService
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
     @if (isInitialized)
     {
          <MudGrid>
               <MudItem xs="12" md="12">
                    <ParentInfoCard Parent="@userInfo" OnEdit="EditProfile" />
               </MudItem>

               <MudItem xs="12" md="12">
                    <MudCard Class="mb-4 pa-4">
                         <MudStack Row="true">
                              <!-- Spouse Section -->
                              <MudText Typo="Typo.h5">Spouse</MudText>
                              @if (_SpouseInfo != null)
                              {
                                   <ParentInfoCard Parent="@_SpouseInfo" OnEdit="EditProfile" />
                              }
                              else
                              {
                                   <MudSpacer />
                                   <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddSpouseDialog" Class="mb-4">
                                        Add Spouse
                                   </MudButton>
                              }
                         </MudStack>
                    </MudCard>
               </MudItem>

               <MudItem xs="12" md="12">
                    <MudCard Class="mb-4 pa-4">
                         <MudStack Row="true">
                              <!-- Children Overview via reusable component -->
                              <MudText Typo="Typo.h5" Class="mb-4"> Children</MudText>
                              <MudSpacer />
                              <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddChildDialog" Class="mb-4">
                                   Add Child
                              </MudButton>
                         </MudStack>
                         <ChildList Children="@Children" ShowHeader="false" FamilyId="@userInfo.FamilyId" />
                    </MudCard>
               </MudItem>

               @* <CourseList Courses=@_courses />
    @* <ChildSimplifiedList Children="@Children" OnViewCourses="ViewCourses" OnAddChild="AddChild" /> *@
               @* <CourseSimplifiedTable Courses="@Courses" /> *@

               <MudItem xs="12" md="12">
                    <MudCard Class="mb-4 pa-4">
                         <MudStack Row="true">

                              <MudText Typo="Typo.h5" Class="mb-4"> Contacts</MudText>
                              <MudSpacer />

                              <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="AddContact" Class="mb-4">
                                   Add Contact
                              </MudButton>

                         </MudStack>

                         <ContactSimplifiedList ShowHeader="false" Contacts="@OtherContacts" OnAddContact="AddContact" />
                    </MudCard>
               </MudItem>

               <MudItem xs="12" md="12">
                    <MudCard Class="mb-4 pa-4">
                         <MudStack Row="true">

                              <MudText Typo="Typo.h5" Class="mb-4"> Address</MudText>
                              <MudSpacer />

                              <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="OnAddAddress" Class="mb-4">
                                   Add Address
                              </MudButton>

                         </MudStack>
                         <AddressList ShowHeader="false" />
                    </MudCard>
               </MudItem>

          </MudGrid>
     }
     else
     {
          <BusyContent DisplayText="Initializing" />
     }
</MudContainer>

@code {
     private UserInformationResponse userInfo = null;
     private UserInformationResponse _SpouseInfo = null;

     private IList<ChildResponse> Children = Array.Empty<ChildResponse>();
     private IEnumerable<CourseResponseDetailed> Courses = Enumerable.Empty<CourseResponseDetailed>();
     private IEnumerable<OtherContactResponse> OtherContacts = Enumerable.Empty<OtherContactResponse>();
     private IEnumerable<UserInformationResponse> _FamilyDetails = Enumerable.Empty<UserInformationResponse>();

     //private IEnumerable<StudentCourseEnrollmentResponse> _enrolledCourses = Enumerable.Empty<StudentCourseEnrollmentResponse>();

     bool isInitialized;
     string userFullName = string.Empty;

     protected override async Task OnInitializedAsync()
     {
          await base.OnInitializedAsync();

          var userId = await SessionService.GetLoggedInUserIdAsync();
          userInfo = await UserService.GetUserByIdAsync(userId);
          userFullName = $"{userInfo.FirstName} {userInfo.LastName}";
          Children = (await ChildrenService.GetChildrenByFamilyIdAsync(userInfo.FamilyId)).ToList();
          //notifications = await NotificationService.GetNotificationsByUserIdAsync(userInfo.UserId);
          var _courses = await CourseService.GetCurrentActiveCoursesAsync();
          var _enrolledCourses = await CourseEnrollmentService.GetCourseEnrollmentsByFamilyIdAsync(userInfo.FamilyId);

          var enrolledCourseIds = _enrolledCourses?.Select(x => x.CourseId);

          Courses = _courses.Where(x => enrolledCourseIds.Contains(x.CourseId)).ToList();

          _FamilyDetails = await UserService.GetFamilyByFamilyId(userInfo.FamilyId);

          _SpouseInfo = _FamilyDetails?.Where(x => x.UserId != this.userInfo.UserId).FirstOrDefault();

          //studentCourseTransaction = await CourseEnrollmentService.GetCoursePaymentDetailsForFamily(userInfo.FamilyId);
          isInitialized = true;
          RequestRender();
     }

     private void EditProfile(UserInformationResponse parent) { }
     private void ViewCourses(Guid id) { }
     private void AddContact() { }

     private async Task OpenAddSpouseDialog()
     {
          var parameters = new DialogParameters { ["FamilyId"] = userInfo.FamilyId };
          var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = false, CloseButton = true };

          var dialog = await DialogService.ShowAsync<AddSpouseDialog>("Add Spouse", parameters, options);
          var result = await dialog.Result;

          if (!result.Canceled && result.Data is UserInformationResponse spouse)
          {
               this._SpouseInfo = spouse;
               this.RequestRender();
          }
     }
     private void OnAddAddress()
     {

     }

     private async Task OpenAddChildDialog()
     {
          var parameters = new DialogParameters { ["FamilyId"] = userInfo.FamilyId };
          var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };

          var dialog = await DialogService.ShowAsync<AddChildDialog>("Add Child", parameters, options);
          var result = await dialog.Result;

          if (!result.Canceled && result.Data is ChildResponse child)
          {
               Children.Add(child);
          }
     }
}
