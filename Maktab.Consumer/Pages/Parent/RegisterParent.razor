@page "/parent/register"

@inherits BaseFormComponent<RegisterParent>

@using System.ComponentModel.DataAnnotations
@using MaktabDataContracts.Enums
@using MaktabDataContracts.Requests.Users
@using Maktab.Consumer.Services

@inject IUserService UserService
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-8 px-4">
     @if (isInitialized)
     {
          <MudPaper Class="pa-4 pa-sm-6" Elevation="0" Outlined="true">
               <MudText Typo="Typo.h5" Class="mb-6 text-center">@L[MaktabResources.Register_User]</MudText>
               <MudForm @ref="_form" @bind-IsValid="@_isValid" OnValidSubmit="@(HandlerRegisterUser)" Validated="@(OnFormValidated)">
                    <MudTextField T="string" @bind-Value="addUserInformation.FirstName" Label=@L[MaktabResources.First_Name] Required="true" Immediate="true" RequiredError=@L[MaktabResources.Msg_Info_Value_Is_Required, MaktabResources.First_Name] />
                    <MudTextField T="string" @bind-Value="addUserInformation.LastName" Label=@L[MaktabResources.Last_Name] Required="true" Immediate="true" RequiredError=@L[MaktabResources.Msg_Info_Value_Is_Required, MaktabResources.Last_Name] />
                    <MudTextField T="string" @bind-Value="addUserInformation.Email" Label=@L[MaktabResources.Email] Required="true" Immediate="true" RequiredError=@L[MaktabResources.Msg_Info_Value_Is_Required, MaktabResources.Email]
                                  Validation="@(new EmailAddressAttribute() {ErrorMessage = @L[MaktabResources.Msg_Error_Email_Address_Invalid]})" />
                    <MudTextField T="string" @bind-Value="addUserInformation.Phone" Immediate="true" Label=@L[MaktabResources.Phone] Required="true" RequiredError=@L[MaktabResources.Msg_Info_Value_Is_Required, MaktabResources.Phone]
                                  Validation="@(new PhoneAttribute() { ErrorMessage = @L[MaktabResources.Msg_Error_Phone_Number_Invalid]})" />

                    <MudSelect @bind-Value="addUserInformation.Relationship" Immediate="true" Label=@L[MaktabResources.Relashion_With_Children] Required="true" RequiredError=@L[MaktabResources.Msg_Info_Value_Is_Required, MaktabResources.Relashion_With_Children]>
                         @foreach (var relationship in relationShips)
                         {
                              <MudSelectItem @key="relationship" Value="relationship">@(GetRelationshipLabel(relationship))</MudSelectItem>
                         }
                    </MudSelect>

                    <MudTextField T="string" Label=@L[MaktabResources.Password]
                                  HelperText=@L[MaktabResources.Msg_Info_Password_Policy]
                                  @ref="pwField1"
                                  InputType="InputType.Password"
                                  Validation="@(new Func<string, IEnumerable<string>>(PasswordStrength))" Required="true"
                                  RequiredError=@L[MaktabResources.Msg_Info_Value_Is_Required, MaktabResources.Password] />
                    <MudTextField T="string" Immediate="true"
                                  Label=@L[MaktabResources.Password] HelperText=@L[MaktabResources.Repeat_Password_HelperText] InputType="InputType.Password"
                                  Validation="@(new Func<string, string>(PasswordMatch))" />

                    @if (!string.IsNullOrWhiteSpace(_errorMessage))
                    {
                         <MudAlert Severity="Severity.Error" Elevation="0" Class="my-4">
                              @_errorMessage
                         </MudAlert>
                    }

                    <!-- For terms & conditions -->
                         <MudCheckBox T="bool"
                                      Class="mt-4"
                                      @bind-Value="applicationTermsAccepted"
                                      UncheckedIcon="@Icons.Material.Filled.RadioButtonUnchecked"
                                      CheckedIcon="@Icons.Material.Filled.CheckCircle"
                                      ReadOnly = "true"
                                      Dense="true">
                         <MudLink Target="_blank" Color="@ApplicationTermsAcceptedColor" OnClick="@ShowApplicationTermsDialog">@L[MaktabResources.Read_Maktab_Terms_Conditions, MaktabResources.AppTitle]</MudLink>
                         </MudCheckBox>

                         <MudCheckBox T="bool"
                                      @bind-Value="companyTermsAccepted"
                                      UncheckedIcon="@Icons.Material.Filled.RadioButtonUnchecked"
                                      CheckedIcon="@Icons.Material.Filled.CheckCircle"
                                      ReadOnly = "true"
                                      Dense="true">
                         <MudLink Target="_blank" Color="@CompanyTermsAcceptedColor" OnClick="@ShowCompanyTermsDialog">@L[MaktabResources.Read_Company_Terms_Conditions, MaktabResources.App_Company]</MudLink>
                         </MudCheckBox>

                    <MudStack Row="true" Spacing="2" Class="mt-6" Justify="Justify.FlexEnd">
                         <MudButton Href="@Constants.LoginRoute" Variant="Variant.Outlined"
                                    Color="Color.Default" StartIcon="@Icons.Material.Filled.Login"
                                    Disabled="@(IsRegistering || registrationLimiter.IsLockedOut)">@L[MaktabResources.Login]</MudButton>
                         <MudButton Type="Submit" Variant="Variant.Filled" Color="Color.Primary"
                                    StartIcon="@Icons.Material.Filled.PersonAdd"
                                    Disabled="@(!_isValid || IsRegistering || registrationLimiter.IsLockedOut || !companyTermsAccepted || !applicationTermsAccepted)" OnClick="@(HandlerRegisterUser)">
                              @if (IsRegistering)
                              {
                                   <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                                   <span>@L[MaktabResources.Msg_Processing]</span>
                              }
                              else if (registrationLimiter.IsLockedOut)
                              {
                                   <span>@L[MaktabResources.Msg_Wait_For_Seconds, registrationLimiter.RemainingSeconds]</span>
                              }
                              else
                              {
                                   <span>@L[MaktabResources.Register]</span>
                              }
                         </MudButton>
                    </MudStack>

               </MudForm>
          </MudPaper>
     }
     else
     {
          <BusyContent DisplayText=@L[MaktabResources.Msg_Initializing] />
     }

</MudContainer>

@code {

     AddUserInformation addUserInformation = new AddUserInformation() { Relationship = Relationship.Unknown };
     private bool applicationTermsAccepted = false;
     private bool companyTermsAccepted = false;

     private bool isInitialized = false;
     bool IsRegistering;
     MudTextField<string> pwField1;
     IEnumerable<Relationship> relationShips = Array.Empty<Relationship>();
     private RateLimitHandler registrationLimiter = new RateLimitHandler(maxAttempts: 3, lockoutDurationSeconds: 30);

     private Color ApplicationTermsAcceptedColor => (!applicationTermsAccepted) ? Color.Error : Color.Primary;
     private Color CompanyTermsAcceptedColor => (!companyTermsAccepted) ? Color.Error : Color.Primary;

     protected override async Task OnInitializedAsync()
     {
          await base.OnInitializedAsync();

          relationShips = Enum.GetValues(typeof(Relationship)).Cast<Relationship>().Where(x => x == Relationship.Mother || x == Relationship.Father);
          isInitialized = true;
          RequestRender();
     }


     private string PasswordMatch(string arg)
     {
          if (pwField1.Value != arg)
               return L[MaktabResources.Msg_Error_Password_Not_Match];
          return null;
     }

     private async Task ShowApplicationTermsDialog()
     {
          var parameters = new DialogParameters
          {
               ["MarkupString"] = new MarkupString(L[MaktabResources.Application_Terms_And_Conditions_Content]),
          };

          var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, BackdropClick = false };
          var dialog = await DialogService.ShowAsync<TermsAndConditionsDialog>(@L[MaktabResources.Terms_And_Conditions], parameters, options);
          var result = await dialog.Result;
          if (result?.Data is bool accepted)
          {
               applicationTermsAccepted = accepted;
               RequestRender();
          }
     }

     private async Task ShowCompanyTermsDialog()
     {
          var parameters = new DialogParameters
     {
               ["MarkupString"] = new MarkupString(L[MaktabResources.Company_Terms_And_Conditions_Content]),
          };
          var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, BackdropClick = false };
          var dialog = await DialogService.ShowAsync<TermsAndConditionsDialog>(@L[MaktabResources.Terms_And_Conditions], parameters, options);
          var result = await dialog.Result;
          if (result?.Data is bool accepted)
          {
               companyTermsAccepted = accepted;
               RequestRender();
          }
     }

     private async void HandlerRegisterUser()
     {
          // Check if locked out
          if (registrationLimiter.CheckLockout())
          {
               _errorMessage = L[MaktabResources.Msg_Warning_Registration_Attempt_Wait_Seconds, registrationLimiter.RemainingSeconds];
               Snackbar.Add(_errorMessage, Severity.Warning);
               return;
          }

          try
          {
               IsRegistering = true;
               RequestRender();

               await InvokeUserAction(RegisterUser);

          }
          finally
          {
               IsRegistering = false;
               RequestRender();
          }
     }

     private async Task RegisterUser()
     {
          addUserInformation.Email = addUserInformation.Email.Trim().ToLowerInvariant();
          addUserInformation.UserName = addUserInformation.Email;

          if (addUserInformation.Relationship == Relationship.Unknown)
          {
               _errorMessage = L[MaktabResources.Msg_Error_User_Resgister_No_RelationShip_Defined];
               Snackbar.Add(_errorMessage, Severity.Error);
               return;
          }

          var isUserExists = await UserService.ValidateUsernameAsync(addUserInformation.UserName);
          if (isUserExists)
          {
               _errorMessage = L[MaktabResources.Msg_Error_User_Resgister_Already_Registered];
               Snackbar.Add(_errorMessage, Severity.Error);
               registrationLimiter.RecordFailedAttempt();
               if (registrationLimiter.IsLockedOut)
               {
                    registrationLimiter.StartCountdownTimer(() => RequestRender());
               }
               return;
          }

          addUserInformation.Password = pwField1.Value;
          var result = await UserService.RegisterUserAsync(addUserInformation);
          if (result != null)
          {
               // Clear failed attempts on successful registration
               registrationLimiter.RecordSuccess();
               _errorMessage = L[MaktabResources.Msg_Success_User_Added_To_System];
               Snackbar.Add(_errorMessage, Severity.Success);
               // Redirect after successful registration
               NavigationManager.NavigateTo(Constants.LoginRoute);
          }
          else
          {
               registrationLimiter.RecordFailedAttempt();
               if (registrationLimiter.IsLockedOut)
               {
                    _errorMessage = L[MaktabResources.Msg_Warning_Failed_Registration_Attempt_Wait_Seconds, registrationLimiter.RemainingSeconds];
                    registrationLimiter.StartCountdownTimer(() => RequestRender());
               }
          }
     }

     protected override void OnDispose()
     {
          registrationLimiter?.Dispose();
          base.OnDispose();
     }
 }