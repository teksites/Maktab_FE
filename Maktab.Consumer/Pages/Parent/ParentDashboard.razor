@page "/parent/dashboard"

@using Maktab.Consumer.Helpers
@using Maktab.Models.Models
@using MaktabDataContracts.Responses.Children
@using MaktabDataContracts.Responses.Course
@using MaktabDataContracts.Responses.Transactions
@using MaktabDataContracts.Responses.Users



@inherits BaseComponent<ParentDashboard>

@* @inject IAccountService AccountService *@
@inject IUserService UserService
@* @inject IInstitutionService InstitutionService *@
@inject IChildrenService ChildrenService
@inject INotificationService NotificationService
@inject ICourseEnrollmentService CourseEnrollmentService

<MudContainer MaxWidth="MaxWidth.Large" Class="py-6">

     @if (isInitialized)
     {

          <!-- Header -->
          <MudStack Row="true" AlignItems="AlignItems.Center" JustifyContent="space-between" Class="mb-6">
               <MudText Typo="Typo.h4">Welcome, @userInfo.FirstName</MudText>

               @* <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <!-- Notifications -->
            <MudBadge Dot="false" Color="Color.Error" Content="@(notifications.Count())">
                <MudIconButton Icon="@Icons.Material.Filled.Notifications" />
            </MudBadge>

            <!-- Profile Avatar -->
            <MudAvatar Color="Color.Primary" Size="Size.Medium">
                         @userFullName.Substring(0, 1).ToUpper()
            </MudAvatar>
        </MudStack> *@
          </MudStack>

          <!-- Summary Cards -->
          <MudGrid Class="mb-6">
               <MudItem xs="12" sm="6" md="3">
                    <MudCard Class="pa-4">
                         <MudText Typo="Typo.h6">Children</MudText>
                         <MudText Typo="Typo.h4">@(children.Count())</MudText>
                    </MudCard>
               </MudItem>
               <MudItem xs="12" sm="6" md="3">
                    <MudCard Class="pa-4">
                         <MudText Typo="Typo.h6">Registered Courses</MudText>
                         <MudText Typo="Typo.h4">0</MudText>
                    </MudCard>
               </MudItem>
               <MudItem xs="12" sm="6" md="3">
                    <MudCard Class="pa-4">
                         <MudText Typo="Typo.h6">Upcoming Classes</MudText>
                         <MudText Typo="Typo.h4">2</MudText>
                    </MudCard>
               </MudItem>
               <MudItem xs="12" sm="6" md="3">
                    <MudCard Class="pa-4">
                         <MudText Typo="Typo.h6">Amount Due</MudText>
                         <MudText Typo="Typo.h4">@AmountPayable</MudText>
                    </MudCard>
               </MudItem>
          </MudGrid>


          @if (studentCourseEnrollments?.Any() == true)
          {
               <MudPaper Class="pa-4">
                    <MudStack Row="true">
                         <MudText Typo="Typo.h5" Class="mb-4 mt-6">You have some enrollments</MudText>
                         <MudSpacer/>
                         <MudFab Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.ShoppingCart"  />
                    </MudStack>
               </MudPaper>
               
          }


          <!-- Children Overview via reusable component -->
          <MudText Typo="Typo.h5" Class="mb-4">Your Children</MudText>
          <ChildList Children="@children" FamilyId="@userInfo.FamilyId" />

          <!-- Notifications -->
          <MudText Typo="Typo.h5" Class="mb-4 mt-6">Recent Notifications</MudText>
          <MudPaper Class="pa-4">
               <MudList T="Notification" Dense="true">
                    @foreach (var note in notifications)
                    {
                         <MudListItem>
                              <MudStack Row="true">
                                   <MudIcon Icon="@Icons.Material.Filled.Event" Color="Color.Primary" Class="me-2" />
                                   <MudStack AlignItems="AlignItems.Start" Justify="Justify.FlexStart" Spacing="0"  >
                                        <MudText>@note.Message</MudText>
                                        <MudText Typo="Typo.subtitle2" >@note.Timestamp.ToShortDateString()</MudText>
                                   </MudStack>
                              </MudStack>
                         </MudListItem>
                    }
               </MudList>
          </MudPaper>

          <!-- Courses Section -->
          @* <MudText Typo="Typo.h5" Class="mt-10 mb-6">Featured Courses</MudText>
          <CourseList Courses=@_courses /> *@

     }
     else
     {
          <BusyContent DisplayText="Initializing" />
     }

</MudContainer>

@* <MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
     <MudStack Spacing="3">
          <!-- Header -->
          <MudPaper Class="pa-4 d-flex justify-space-between align-center">
               <MudText Typo="Typo.h5">Parent Dashboard</MudText>
               <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => OpenChildDialog())">
                    <MudIcon Icon="@Icons.Material.Filled.Add" Class="me-1" />
                    Add Child
               </MudButton>
          </MudPaper>

          <!-- Children List -->
         @*  <ChildList Children="@children" OnEdit="@(EditChild)" /> *-@
     </MudStack>
</MudContainer> *@




@code {
     [Inject] private IDialogService DialogService { get; set; } = default!;


     bool isInitialized;
     string userFullName = string.Empty;
     Guid userId = Guid.Empty;
     UserInformationResponse userInfo = null;
     IList<ChildResponse> children = null;
     IEnumerable<Notification> notifications = null;
     // IEnumerable<Course> _courses = Enumerable.Empty<Course>();
     IEnumerable<StudentCourseEnrollmentResponse> studentCourseEnrollments;
     StudentCourseTransactionResponse studentCourseTransaction;

     protected decimal AmountPayable
     {
          get
          {
               if (studentCourseTransaction?.TotalPayable != null)
               {
                    return studentCourseTransaction.TotalPayable;
               }
               else
               {
                    return 0;
               }
          }
     }


     protected override async Task OnInitializedAsync()
     {
          await base.OnInitializedAsync();

          userId = await SessionService.GetLoggedInUserIdAsync();
          userInfo = await UserService.GetUserByIdAsync(userId);
          userFullName = $"{userInfo.FirstName} {userInfo.LastName}";
          children = (await ChildrenService.GetChildrenByFamilyIdAsync(userInfo.FamilyId)).ToList();
          notifications = await NotificationService.GetNotificationsByUserIdAsync(userInfo.UserId);
          // _courses = await InstitutionService.GetCoursesByInstitutionIdAsync(Guid.NewGuid());

          studentCourseEnrollments = await CourseEnrollmentService.GetCourseEnrollmentsByFamilyIdAsync(userInfo.FamilyId);
          studentCourseTransaction = await CourseEnrollmentService.GetCoursePaymentDetailsForFamily(userInfo.FamilyId);
          isInitialized = true;
          RequestRender();
     }

     private async Task OpenChildDialog(ChildResponse? child = null)
     {
          var parameters = new DialogParameters { ["Child"] = child };
          var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };

          var dialog = DialogService.Show<Dialogs.AddChildDialog>(child == null ? "Add New Child" : "Edit Child", parameters, options);
          var result = await dialog.Result;

          if (!result.Canceled && result.Data is ChildResponse savedChild)
          {
               if (child == null)
               {
                    //Parent.Children.Add(savedChild);
                    Snackbar.Add("Child added successfully!", Severity.Success);
               }
               else
               {
                    // var index = Parent.Children.FindIndex(c => c.Id == savedChild.Id);
                    // if (index >= 0) Parent.Children[index] = savedChild;
                    Snackbar.Add("Child updated successfully!", Severity.Success);
               }
          }
     }

     private Task EditChild(ChildResponse child) => OpenChildDialog(child);
}
