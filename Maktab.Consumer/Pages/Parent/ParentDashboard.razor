     private async Task OpenAddChildDialog()
     {
          var dialogResult = await this.OpenAddChildDialog(DialogService, userInfo.FamilyId);
          if (dialogResult != null && !dialogResult.Canceled && dialogResult.Data is ChildResponse child)
          {
               //await LoadChildrenData(userInfo.FamilyId, true);
               await StateService.LoadChildrenData(ChildrenService, userInfo.FamilyId, true);
               RequestRender();
          }
     }

     private async Task OpenEnrollChildDialog()
     {
          var parameters = new DialogParameters { };
          var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };

          var dialog = await DialogService.ShowAsync<EnrollChildInCourseDialog>(L[MaktabResources.Enroll_Child], parameters, options);
          var result = await dialog.Result;

          if (!result.Canceled)
          {
               await StateService.LoadCourseTransactionsByCourse(
                    CourseEnrollmentTransactionService,
                    _CourseEnrollments,
                    userInfo.FamilyId,
                    true);
          }

          RequestRender();
     }

