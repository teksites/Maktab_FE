     private string GetCourseTitle(Guid courseId)
     {
          string courseName = _Courses?.FirstOrDefault(x => x.CourseId == courseId)?.Name;

          if (string.IsNullOrEmpty(courseName))
          {
               return $"Course {courseId.ToString()[..5]}";
          }

          return courseName;

     }

     private string GetChildName(Guid childId)
     {
          var child = _Children?.FirstOrDefault(x => x.ChildId == childId);

          if (child == null)
          {
               return $"Child {childId.ToString()[..5]}";
          }

          return $"{child.FirstName} {child.LastName}";
     }

     private async Task OpenZeffyPaymentDialog()
     {
          const string url = "/PaymentMethod/Payment?amount={0}&code={1}&email={2}";

          string paymentCode = _CourseTransactions.FirstOrDefault()?.PaymentCode;

          var navigationUrl = string.Format(url, AmountPayable.ToString(), paymentCode, userInfo.Email);
          NavigationManager.NavigateTo(navigationUrl, false);


