@page "/parent/adddetails"
@using MaktabDataContracts.Enums
@using MaktabDataContracts.Responses;
@using MaktabDataContracts.Responses.Addresses
@using MaktabDataContracts.Responses.Children
@using MaktabDataContracts.Responses.OtherContacts
@using MaktabDataContracts.Responses.Users

@inherits LocalizeableBaseComponent<AddParentDetails>

@* @inject ISessionService SessionService
@inject ISnackbar Snackbar*@
@inject IUserService UserService
@inject IDialogService DialogService
@inject IChildrenService ChildrenService


@* @inject IAlertService AlertService *@
@* @inject NavigationManager NavigationManager *@

<MudGrid>
     <MudItem xs="12" sm="7">
          <MudPaper Class="pa-4">
               @if (isInitialized)
               {
                    <MudStack AlignItems="AlignItems.Center" JustifyContent="Center">

                         <MudStepper @ref=@stepper OnPreviewInteraction="OnPreviewInteraction">
                              <ChildContent>
                              <MudStep Title="Add home address" SecondaryText="Step 1" HasError="@(!isFamilyAddressAdded)">
                                   <AddAddress AddressModel="@parentAddress" AddressType="AddressType.Parent" ConnectedId="@userInfo.UserId" OnSave="@(OnFamilyAddressSaved)" />
                              </MudStep>

                              <MudStep Title="Add Spouse" SecondaryText="Step 2" Skippable="true" HasError="@(!isSpouseAdded)">
                                   <MudStack AlignItems="AlignItems.Center" JustifyContent="Center">
                                        <AddSpouse FamilyId="@userInfo.FamilyId" OnSave="@(OnSpouseSaved)" />
                                   </MudStack>
                                   @* <MudSwitch @bind-Value="_step1Complete" Color="Color.Primary">Flip the switch to be able to advance to step 2</MudSwitch> *@
                              </MudStep>

                              <MudStep Title="Add RL 24" SecondaryText="Step 3" Skippable="true" HasError="@(isExtendedInfoAdded == false)">
                                   <AddExtendedInfo FamilyId="@userInfo.FamilyId" AddessId="@homeAddressId" UserId="@userId" OnSave="@(OnExtendedInfoSaved)" />
                              </MudStep>
                              <MudStep Title="Add Emergency Contact" SecondaryText="Step 4" Skippable="true" HasError="@(!isEmergencyContactAdded)">
                                   <AddContact  ContactType="ContactType.Emergency" FamilyId="@userInfo.FamilyId" OnSave="@(OnEmergencyContactSaved)" />
                              </MudStep>
@*                               <MudStep Title="Add Pickup Contact" SecondaryText="Step 5" Skippable="true"  HasError="@(!isPickupContactAdded)">
                                   <AddContact ContactType="ContactType.Pickup"  FamilyId="@userInfo.FamilyId" OnSave="@(OnPickupContactSaved)" />
                              </MudStep>  *@
                              </ChildContent>

                              <CompletedContent>
                                   <MudContainer Class="p-6 text-center" Elevation="3">
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                                 Color="Color.Success" Size="Size.Large" />

                                        <MudText Typo="Typo.h5" Class="mt-3">Registration Successful!</MudText>
                                        <MudText Typo="Typo.body1" Color="Color.Primary">
                                             Thank you @userInfo.FirstName @userInfo.LastName for registration with Maktab.
                                        </MudText>
                                        <MudSpacer />
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4"
                                                   OnClick="@NavigateToParentDasboard">
                                             Start Exploring
                                        </MudButton>
                                   </MudContainer>
                              </CompletedContent>

                         </MudStepper>

                    </MudStack>
               }
               else
               {
                    <BusyContent DisplayText="Initializing" />
               }
          </MudPaper>

     </MudItem>

</MudGrid>

@code {

     Guid userId = Guid.Empty;
     Guid homeAddressId = Guid.Empty;

     UserInformationResponse userInfo = null;
     MaktabDataContracts.Requests.Addresses.AddAddress parentAddress = new();
     bool isInitialized;
     bool isSpouseAdded;
     bool isFamilyAddressAdded;
     bool isExtendedInfoAdded = false;
     bool isEmergencyContactAdded = false;
     bool isPickupContactAdded;
     string username = string.Empty;
     MudStepper stepper;



     protected override async Task OnInitializedAsync()
     {
          await base.OnInitializedAsync();

          username = await SessionService.GetUserNameAsync();
          userId = await SessionService.GetLoggedInUserIdAsync();
          userInfo = await UserService.GetUserByIdAsync(userId);

          isInitialized = true;
          parentAddress.ConnectedId = userInfo.UserId;
          parentAddress.HomeAddress = true;
          RequestRender();
     }

     private async Task OnPreviewInteraction(StepperInteractionEventArgs arg)
     {
          if (arg.Action == StepAction.Complete)
          {
               // occurrs when clicking next
               await ControlStepCompletion(arg);
          }
          else if (arg.Action == StepAction.Activate)
          {
               // occurrs when clicking a step header with the mouse
               await ControlStepNavigation(arg);
          }
          if(arg.Action == StepAction.Skip)
          {
               await ControlStepSkip(arg);
          }
     }

     private async Task ControlStepCompletion(StepperInteractionEventArgs arg)
     {
          switch (arg.StepIndex)
          {

               case 0:
                    if (!isFamilyAddressAdded)
                    {
                         await DialogService.ShowMessageBox("Error", "Please add home address");
                         arg.Cancel = true;
                    }
                    break;
                    // case 1:
                    //      if (!isSpouseAdded)
                    //      {
                    //           await DialogService.ShowMessageBox("Error", "Please enter spouse details.");
                    //           arg.Cancel = true;
                    //      }
                    //      break;
                    // case 2:
                    //      if (!isExtendedInfoAdded)
                    //      {
                    //           await DialogService.ShowMessageBox("Error", "Please add RL 24 info");
                    //           arg.Cancel = true;
                    //      }
                    //      break;
                    // case 3:
                    //      if (!isChildAdded)
                    //      {
                    //           await DialogService.ShowMessageBox("Error", "Please add child");
                    //           arg.Cancel = true;
                    //      }
                    //      break;
          }
     }

     private async Task ControlStepNavigation(StepperInteractionEventArgs arg)
     {
          switch (arg.StepIndex)
          {
               case 1:
                    if (!isFamilyAddressAdded)
                    {
                         await DialogService.ShowMessageBox("Error", "Finish step 1");
                         arg.Cancel = true;
                    }
                    break;
                    // // case 2:
                    // //      if (!isSpouseAdded )
                    // //      {
                    // //           await DialogService.ShowMessageBox("Error", "Finish step 1 first");
                    // //           arg.Cancel = true;
                    // //      }
                    // //      break;

                    // // case 3:
                    // //      if (!isExtendedInfoAdded)
                    // //      {
                    // //           await DialogService.ShowMessageBox("Error", "Finish step 3");
                    // //           arg.Cancel = true;
                    // //      }
                    // //      break;
                    // // case 4:
                    // //      if (!isChildAdded)
                    // //      {
                    // //           await DialogService.ShowMessageBox("Error", "Finish step 4");
                    // //           arg.Cancel = true;
                    // //      }
                    // //      break;
          }
     }

     private async Task ControlStepSkip(StepperInteractionEventArgs arg)
     {
          switch (arg.StepIndex)
          {
               case 3: //Last step
                    NavigateToParentDasboard();
                    break;
          }
     }


     private async void OnSpouseSaved(UserInformationResponse spouseInfo)
     {
          if (spouseInfo != null)
          {
               isSpouseAdded = true;
               if (stepper.CanGoToNextStep)
               {
                    await stepper.NextStepAsync();
               }
          }
     }

     private async void OnFamilyAddressSaved(AddressResponse addressInfo)
     {
          if (addressInfo != null)
          {
               isFamilyAddressAdded = true;
               this.homeAddressId = addressInfo.AddressId;
               if(stepper.CanGoToNextStep)
               {
                    await stepper.NextStepAsync();
               }
          }
     }

     private async void OnExtendedInfoSaved(ExtendedUserInformationResponse extendednInfo)
     {
          if (extendednInfo != null)
          {
               isExtendedInfoAdded = true;
               if (stepper.CanGoToNextStep)
               {
                    await stepper.NextStepAsync();
               }
          }
     }

     private async void OnEmergencyContactSaved(OtherContactResponse emergencyContact)
     {
          if (emergencyContact != null)
          {
               isEmergencyContactAdded = true;
               NavigateToParentDasboard();
               // if (stepper.CanGoToNextStep)
               // {
               //      await stepper.NextStepAsync();
               // }
          }
     }

     private void OnPickupContactSaved(OtherContactResponse pickupContact)
     {
          if (pickupContact != null)
          {
               isPickupContactAdded = true;
          }
     }

     private void NavigateToParentDasboard()
     {
          NavigationManager.NavigateTo(Constants.ParentDashboardRoute);
     }

     
}