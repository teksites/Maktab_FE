@page "/parent/adddetails"
@using MaktabDataContracts.Enums
@using MaktabDataContracts.Responses;
@using MaktabDataContracts.Responses.Addresses
@using MaktabDataContracts.Responses.Children
@using MaktabDataContracts.Responses.OtherContacts
@using MaktabDataContracts.Responses.Users

@inherits LocalizeableBaseComponent<AddParentDetails>

@inject IUserService UserService
@inject IDialogService DialogService
@inject IChildrenService ChildrenService

<MudGrid>
     <MudItem xs="12" sm="12" md="12">
          <MudPaper Class="pa-4">
               @if (isInitialized)
               {
                    <MudStack AlignItems="AlignItems.Center" JustifyContent="Center">

                         <MudStepper @ref=@stepper IsCompleted="@isStepperCompleted" OnPreviewInteraction="OnPreviewInteraction">
                              <ChildContent>
                                   <!-- Step 1: Home Address (Required) -->
                                   <MudStep Title=@L[MaktabResources.Add_Home_Address] SecondaryText=@L[MaktabResources.Step_Number, "1"] @bind-Disabled="isFamilyAddressAdded" HasError="@(!isFamilyAddressAdded)">
                                        <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Outlined.Info" Class="mb-4">
                                             <MudText Typo="Typo.body2">
                                                  @L[MaktabResources.Step_Instruction_Family_Address]
                                             </MudText>
                                        </MudAlert>
                                        <AddAddress AddressModel="@parentAddress" HideAddressType="true" ConnectedId="@userInfo.UserId" OnSave="@(OnFamilyAddressSaved)" />
                                   </MudStep>

                                   <!-- Step 2: Spouse (Optional) -->
                                   <MudStep Title=@L[MaktabResources.Add_Spouse] SecondaryText=@L[MaktabResources.Step_Number, "2"] @bind-Disabled="isSpouseAdded">
                                        <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Outlined.Info" Class="mb-4">
                                             <MudText Typo="Typo.body2">
                                                  @L[MaktabResources.Step_Instruction_Spouse]
                                             </MudText>
                                        </MudAlert>
                                        <MudStack AlignItems="AlignItems.Center" JustifyContent="Center">
                                             <AddSpouse FamilyId="@userInfo.FamilyId" OnSave="@(OnSpouseSaved)" />
                                        </MudStack>
                                   </MudStep>

                                   <!-- Step 3: Extended Info - RL24 (Optional) -->
                                   <MudStep Title=@L[MaktabResources.Add_RL24] SecondaryText=@L[MaktabResources.Step_Number, "3"] Skippable="true" @bind-Disabled="isExtendedInfoAdded">
                                        <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Outlined.Info" Class="mb-4">
                                             <MudText Typo="Typo.body2">
                                                  @L[MaktabResources.Step_Instruction_Extended_Info]
                                             </MudText>
                                        </MudAlert>
                                        <AddExtendedInfo FamilyId="@userInfo.FamilyId" AddessId="@homeAddressId" UserId="@userId" OnSave="@(OnExtendedInfoSaved)" />
                                   </MudStep>

                                   <!-- Step 4: Emergency Contact (Optional) -->
                                   <MudStep Title=@L[MaktabResources.Add_Emergency_Contact] SecondaryText=@L[MaktabResources.Step_Number, "4"] >
                                        <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Outlined.Info" Class="mb-4">
                                             <MudText Typo="Typo.body2">
                                                  @L[MaktabResources.Step_Instruction_Emergency_Contact]
                                             </MudText>
                                        </MudAlert>
                                        <AddContact ContactType="ContactType.Emergency" FamilyId="@userInfo.FamilyId" OnSave="@(OnEmergencyContactSaved)" />
                                   </MudStep>
                              </ChildContent>

                              <CompletedContent>
                                   <MudContainer Class="p-6 text-center" Elevation="3">
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                                 Color="Color.Success" Size="Size.Large" />

                                        <MudText Typo="Typo.h5" Class="mt-3">@L[MaktabResources.Parent_Registration_Success]</MudText>
                                        <MudText Typo="Typo.body1" Color="Color.Primary">
                                             @L[MaktabResources.Msg_Success_Parent_Registration, @userInfo.FirstName, MaktabResources.AppTitle]
                                        </MudText>

                                        <!-- Summary of what was added -->
                                        <MudDivider Class="my-4" />
                                        <MudText Typo="Typo.subtitle2" Class="mb-3">
                                             @L[MaktabResources.Information_Added]:
                                        </MudText>
                                        <MudList T="String" Class="text-left">
                                             <MudListItem Icon="@Icons.Material.Filled.Home" IconColor="Color.Success">
                                                  <MudText Typo="Typo.body2">@L[MaktabResources.Add_Home_Address]</MudText>
                                             </MudListItem>
                                             @if (isSpouseAdded)
                                             {
                                                  <MudListItem Icon="@Icons.Material.Filled.Person" IconColor="Color.Success">
                                                       <MudText Typo="Typo.body2">@L[MaktabResources.Add_Spouse]</MudText>
                                                  </MudListItem>
                                             }
                                             @if (isExtendedInfoAdded)
                                             {
                                                  <MudListItem Icon="@Icons.Material.Filled.DocumentScanner" IconColor="Color.Success">
                                                       <MudText Typo="Typo.body2">@L[MaktabResources.Add_RL24]</MudText>
                                                  </MudListItem>
                                             }
                                             @if (isEmergencyContactAdded)
                                             {
                                                  <MudListItem Icon="@Icons.Material.Filled.ContactEmergency" IconColor="Color.Success">
                                                       <MudText Typo="Typo.body2">@L[MaktabResources.Add_Emergency_Contact]</MudText>
                                                  </MudListItem>
                                             }
                                        </MudList>

                                        @* <MudText Typo="Typo.body2" Color="Color.Tertiary" Class="mt-4">
                                             @L[MaktabResources.Information_Can_Be_Edited_Anytime]
                                        </MudText> *@

                                        <MudSpacer />
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Class="mt-4"
                                                   OnClick="@NavigateToParentDasboard">
                                             @L[MaktabResources.Start_Exploring]
                                        </MudButton>
                                   </MudContainer>
                              </CompletedContent>

                         </MudStepper>

                    </MudStack>
               }
               else
               {
                    <BusyContent DisplayText=@L[MaktabResources.Msg_Initializing] />
               }
          </MudPaper>

     </MudItem>

</MudGrid>

@code {

     Guid userId = Guid.Empty;
     Guid homeAddressId = Guid.Empty;

     UserInformationResponse userInfo = null;
     MaktabDataContracts.Requests.Addresses.AddAddress parentAddress = new() { AddressType = AddressType.Parent };
     bool isInitialized;
     bool isSpouseAdded;
     bool isFamilyAddressAdded;
     bool isExtendedInfoAdded = false;
     bool isEmergencyContactAdded = false;
     bool isPickupContactAdded;
     string username = string.Empty;
     MudStepper stepper;
     bool isStepperCompleted;

     protected override async Task OnInitializedAsync()
     {
          await base.OnInitializedAsync();

          username = await SessionService.GetUserNameAsync();
          userId = await SessionService.GetLoggedInUserIdAsync();
          userInfo = await UserService.GetUserByIdAsync(userId);

          isInitialized = true;
          parentAddress.ConnectedId = userInfo.UserId;
          parentAddress.AddressType = AddressType.Parent;
          parentAddress.HomeAddress = true;
          RequestRender();
     }

     private async Task OnPreviewInteraction(StepperInteractionEventArgs arg)
     {
          if (arg.Action == StepAction.Complete)
          {
               // occurs when clicking next
               await ControlStepCompletion(arg);
          }
          else if (arg.Action == StepAction.Activate)
          {
               // occurs when clicking a step header with the mouse
               await ControlStepNavigation(arg);
          }
          if (arg.Action == StepAction.Skip)
          {
               await ControlStepSkip(arg);
          }
     }

     private async Task ControlStepCompletion(StepperInteractionEventArgs arg)
     {
          switch (arg.StepIndex)
          {
               case 0:
                    if (!isFamilyAddressAdded)
                    {
                         await DialogService.ShowMessageBox(L[MaktabResources.Error], L[MaktabResources.Msg_Error_Add_Home_Address]);
                         arg.Cancel = true;
                    }
                    break;
               case 1:
                    if (!isSpouseAdded)
                    {
                         await DialogService.ShowMessageBox(L[MaktabResources.Error], L[MaktabResources.Msg_Error_Add_Spouse_Info]);
                         arg.Cancel = true;
                    }
                    break;
               case 3:
                    if (!isEmergencyContactAdded)
                    {
                         await DialogService.ShowMessageBox(L[MaktabResources.Error], L[MaktabResources.Msg_Error_Add_Emergency_Contact]);
                         arg.Cancel = true;
                    }
                    break;
          }
     }

     private async Task ControlStepNavigation(StepperInteractionEventArgs arg)
     {
          switch (arg.StepIndex)
          {
               case 1:
                    if (!isFamilyAddressAdded)
                    {
                         await DialogService.ShowMessageBox(L[MaktabResources.Error], L[MaktabResources.Msg_Error_Complete_Step_Number, arg.StepIndex.ToString()]);
                         arg.Cancel = true;
                    }
                    break;
               case 2:
                    if (!isSpouseAdded)
                    {
                         await DialogService.ShowMessageBox(L[MaktabResources.Error], L[MaktabResources.Msg_Error_Complete_Step_Number, arg.StepIndex.ToString()]);
                         arg.Cancel = true;
                    }
                    break;
               case 4:
                    if (!isEmergencyContactAdded)
                    {
                         await DialogService.ShowMessageBox(L[MaktabResources.Error], L[MaktabResources.Msg_Error_Complete_Step_Number, arg.StepIndex.ToString()]);
                         arg.Cancel = true;
                    }
                    break;
          }
     }

     private async Task ControlStepSkip(StepperInteractionEventArgs arg)
     {
          switch (arg.StepIndex)
          {
               // case 1: // Spouse - confirm skip
               //      var confirmedSpouse = await DialogService.ShowMessageBox(
               //           L[MaktabResources.Confirm_Skip],
               //           L[MaktabResources.Spouse_Info_Can_Be_Added_Later],
               //           yesText: L[MaktabResources.Skip_Anyway],
               //           cancelText: L[MaktabResources.Go_Back]
               //      );
               //      arg.Cancel = !confirmedSpouse.GetValueOrDefault();
               //      break;
               // case 2: // RL24 - confirm skip
               //      var confirmedRL24 = await DialogService.ShowMessageBox(
               //           L[MaktabResources.Confirm_Skip],
               //           L[MaktabResources.Extended_Info_Can_Be_Added_Later],
               //           yesText: L[MaktabResources.Skip_Anyway],
               //           cancelText: L[MaktabResources.Go_Back]
               //      );
               //      arg.Cancel = !confirmedRL24.GetValueOrDefault();
               //      break;
               case 3: // Last step - navigate to dashboard
                    NavigateToParentDasboard();
                    break;
          }
     }

     private async void OnSpouseSaved(UserInformationResponse spouseInfo)
     {
          if (spouseInfo != null)
          {
               isSpouseAdded = true;
               if (stepper.CanGoToNextStep)
               {
                    await stepper.NextStepAsync();
               }
          }
     }

     private async void OnFamilyAddressSaved(AddressResponse addressInfo)
     {
          if (addressInfo != null)
          {
               isFamilyAddressAdded = true;
               this.homeAddressId = addressInfo.AddressId;
               if (stepper.CanGoToNextStep)
               {
                    await stepper.NextStepAsync();
               }
          }
     }

     private async void OnExtendedInfoSaved(ExtendedUserInformationResponse extendednInfo)
     {
          if (extendednInfo != null)
          {
               isExtendedInfoAdded = true;
               if (stepper.CanGoToNextStep)
               {
                    await stepper.NextStepAsync();
               }
          }
     }

     private async void OnEmergencyContactSaved(OtherContactResponse emergencyContact)
     {
          if (emergencyContact != null)
          {
               isEmergencyContactAdded = true;

               if (stepper?.ActiveStep != null)
               {
                    stepper.ActiveStep.Completed = true;
                    isStepperCompleted = true;
               }

               RequestRender();
          }
     }

     private void OnPickupContactSaved(OtherContactResponse pickupContact)
     {
          if (pickupContact != null)
          {
               isPickupContactAdded = true;
          }
     }

     private void NavigateToParentDasboard()
     {
          NavigationManager.NavigateTo(Constants.ParentDashboardRoute);
     }
}
