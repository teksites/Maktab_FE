@page "/customer/dashboard"

@using Maktab.Consumer.Helpers
@using Maktab.Models.Models

@inherits BaseComponent<CustomerDashboard>

@inject IAccountService AccountService
@inject IUserService UserService
@inject IInstitutionService InstitutionService
@inject IChildrenService ChildrenService 



<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">

     @if (isInitialized.HasValue && isInitialized.Value)
     {
    <!-- Parent Info -->
    <MudPaper Class="pa-4 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
               <MudAvatar Size="Size.Large" Color="Color.Primary">@userFullName[0]</MudAvatar>
            <MudStack>
                    <MudText Typo="Typo.h6">@userFullName</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@userInfo.Email</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@userInfo.Phone</MudText>
            </MudStack>
        </MudStack>
    </MudPaper>

    <!-- Children -->
    <MudText Typo="Typo.h5" Class="mb-2">Children</MudText>
    <MudGrid>
          @foreach (var child in children)
        {
            <MudItem xs="12" sm="6">
                <MudCard>
                    <MudCardContent>
                              <MudText Typo="Typo.h6">@(child.FirstName)  @(child.LastName)</MudText>
                        <MudText Typo="Typo.subtitle2">Enrolled Courses:</MudText>
                        @* @if (child.EnrolledCourses.Any())
                        {
                            <MudChipSet T="Course" ReadOnly="true">
                                @foreach (var course in child.EnrolledCourses)
                                {
                                    <MudChip Color="Color.Primary">@course.Title</MudChip>
                                }
                            </MudChipSet>
                        }
                        else *@
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                No courses enrolled.
                            </MudText>
                        }
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Text" OnClick="@(() => GoToChildProfile(child.ChildId))">
                            View Profile
                        </MudButton>
                              <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => EnrollChild(child.ChildId))">
                            Enroll in Course
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
     }
     else
     {
     <BusyContent DisplayText="Initializing" />
     }
</MudContainer>

@code {

     bool? isInitialized;
     string userFullName = string.Empty;
     Guid userId = Guid.Empty;
     MaktabDataContracts.Responses.Users.UserInformationResponse userInfo = null;
     IEnumerable<MaktabDataContracts.Responses.Children.ChildResponse> children = null;


     protected override async Task OnInitializedAsync()
     {
          await base.OnInitializedAsync();

          userId = await SessionService.GetLoggedInUserIdAsync();
          userInfo = await UserService.GetUserByIdAsync(userId);
          userFullName = $"{userInfo.FirstName} {userInfo.LastName}";
          children = await ChildrenService.GetChildrenByFamilyIdAsync(userInfo.FamilyId);
          isInitialized = true;

          RequestRender();
     }





