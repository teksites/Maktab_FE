@page "/payment/paymentmethod/zeffy"
@using Maktab.Consumer.State
@using Maktab.Consumer.Extensions

@inherits LocalizeableBaseComponent<ZeffyPaymentMethod>

@inject ICourseEnrollmentService CourseEnrollmentService
@inject ICourseEnrollmentTransactionService CourseEnrollmentTransactionService
@inject UserStateService StateService
@inject IClipboardService ClipboardService

<MudContainer MaxWidth="MaxWidth.Large" Class="py-8">

     <!-- Page Header with Alert -->
     <MudStack Spacing="2" Class="mb-8">
          <MudText Typo="Typo.h4" Class="font-weight-bold">@L[MaktabResources.Fee_Payment] - @L[MaktabResources.Course]: @CourseName</MudText>
          <MudText Typo="Typo.h6" Style="opacity: 0.7;">
               @L[MaktabResources.Msg_Info_Zeffy_Payment_Mandatory_Fields]
          </MudText>

          @if (!string.IsNullOrEmpty(PaymentCode))
          {
               <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudText Typo="Typo.h5" Class="font-weight-bold">
                         @L[MaktabResources.Payment_Code]:
                    </MudText>
                    <MudText Typo="Typo.h4" Class="font-weight-bold">
                         @PaymentCode
                    </MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   OnClick="@(() => ClipboardService.CopyTextToClipboard(PaymentCode))" />
               </MudStack>
          }

          @if (!string.IsNullOrEmpty(UserEmail))
          {
               <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudText Typo="Typo.h5" Class="font-weight-bold">
                         @L[MaktabResources.Email]:
                    </MudText>
                    <MudText Typo="Typo.h4" Class="font-weight-bold">
                         @UserEmail
                    </MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   OnClick="@(() => ClipboardService.CopyTextToClipboard(UserEmail))" />
               </MudStack>
          }

          @if (!string.IsNullOrEmpty(UserEmail))
          {
               <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudText Typo="Typo.h5" Class="font-weight-bold">
                         @L[MaktabResources.Amount_Due]:
                    </MudText>
                    <MudText Typo="Typo.h4" Class="font-weight-bold">
                         @AmountDue
                    </MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                    Color="Color.Primary"
                    Size="Size.Small"
                    OnClick="@(() => ClipboardService.CopyTextToClipboard(AmountDue))" />
               </MudStack>
          }

          @if (!string.IsNullOrEmpty(MinimumAmountDueToKeepRegistration) && MinimumAmountDueToKeepRegistration != "-1")
          {
               <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Error">
                         @L[MaktabResources.Minimum_Amount_Due_To_Hold_Registration]:
                    </MudText>
                    <MudText Typo="Typo.h4" Class="font-weight-bold" Color="Color.Error">
                         @MinimumAmountDueToKeepRegistration
                    </MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                    Color="Color.Primary"
                    Size="Size.Small"
                    OnClick="@(() => ClipboardService.CopyTextToClipboard(MinimumAmountDueToKeepRegistration))" />
               </MudStack>
          }

          <MudStack AlignItems="AlignItems.Start" Spacing="0">
               <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Warning">
                    @L[MaktabResources.Msg_Donation_Amount_Equals_Course_Amount]
               </MudText>
               <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Warning">
                    @L[MaktabResources.Msg_Info_Zeffy_Payment_donation_section]
               </MudText>
          </MudStack>
          
     </MudStack>

     <!-- Zeffy iframe -->
     <MudPaper Height="450px" Width="100%" Class="pa-8 rounded-lg text-center mt-6" Elevation="0" Style="position:relative;overflow:hidden; margin-bottom: 40px;">
          <iframe title="Donation form powered by Zeffy"
                  style="position: absolute; border: 0; top:0;left:0;bottom:0;right:0;width:100%;height:100%"
                  src="https://www.zeffy.com/embed/donation-form/school-fees-system"
                  allow="payment"
                  allowpaymentrequest
                  allowTransparency="true">
          </iframe>
     </MudPaper>

     <MudButton Variant="Variant.Outlined"
                Color="Color.Primary"
                OnClick="@(GoBackHome)">
          @L[MaktabResources.Back_To_Dashboard]
     </MudButton>

</MudContainer>

@code {
     [Parameter] public string PaymentCode { get; set; } = string.Empty;
     [Parameter] public string CourseName { get; set; } = string.Empty;
     [Parameter] public string UserEmail { get; set; } = string.Empty;
     [Parameter] public string AmountDue { get; set; } = "0";
     [Parameter] public string MinimumAmountDueToKeepRegistration { get; set; } = "0";

     protected bool IsLoadingData = false;
     protected bool isInitialized = false;

     protected override void OnInitialized()
     {

          base.OnInitialized();
          // Parse query string
          //var uri = new Uri(NavigationManager.Uri);
          var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
          var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

          PaymentCode = query.Get("code") ?? string.Empty;
          CourseName = query.Get("course") ?? string.Empty;
          UserEmail = query.Get("email") ?? string.Empty;
          AmountDue = query.Get("amount") ?? "0";
          MinimumAmountDueToKeepRegistration = query.Get("minimumAmount") ?? "0";
     }

     protected override async Task OnInitializedAsync()
     {
          await base.OnInitializedAsync();

          var userId = await SessionService.GetLoggedInUserIdAsync();

          isInitialized = true;
     }

     private async Task GoBackHome()
     {
          await StateService.LoadCourseTransactionsByCourse(
               CourseEnrollmentTransactionService,
               StateService.ParentState.CourseEnrollments,
               StateService.ParentState.Profile.FamilyId,
               true);
          NavigationManager.NavigateTo(Constants.ParentDashboardRoute, forceLoad: false);
     }
}
