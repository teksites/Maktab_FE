@page "/landing/mainpage"
@using Maktab.Consumer.Helpers
@using Maktab.Consumer.State
@using MaktabDataContracts.Responses.Course
@using Maktab.Consumer.Extensions;
@using MaktabDataContracts.Responses.Institute

@inherits LocalizeableBaseComponent<MainPage>

@* @inject IAccountService AccountService *@
@* @inject IUserService UserService *@
@inject IInstitutionService InstitutionService
@inject ICourseService CourseService


@inject UserStateService StateService

<MudContainer Class="mt-10 mb-10" >

     <!-- Hero Section -->
     <MudPaper Class="pa-8 d-flex flex-column align-center justify-center text-center" Elevation="0">
          <MudText Typo="Typo.h3" GutterBottom="true">@L[MaktabResources.MainPage_Title]</MudText>
          <MudText Typo="Typo.subtitle1" Class="mb-6">@L[MaktabResources.MainPage_Description]</MudText>
          <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@Constants.CourseSearchRoute">@L[MaktabResources.ViewAllCourses]</MudButton>
     </MudPaper>

     <!-- Courses Section -->
     <MudText Typo="Typo.h5" Class="mt-10 mb-6">@L[MaktabResources.Activities_Offered]</MudText>
     @if (isInitialized && !isDataLoading)
     {
          <InstituteList Institutes=@_institute/>
          @* ShowCourseCount="true" /> *@
          @* <CourseList Courses=@_courses ShowProgress="false"
          /> *@
          @*  <MudGrid GutterSize="3">
        @foreach (var course in _courses)
        {
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Class="h-100 d-flex flex-column">
                    <MudCardMedia Image="@course.ImageUrl" Height="180" />
                    <MudCardContent>
                        <MudText Typo="Typo.h6">@course.Title</MudText>
                        <MudText Typo="Typo.body2" Class="mb-2">@course.Description</MudText>
                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">@(course.Category)</MudChip>
                    </MudCardContent>
                    <MudCardActions Class="mt-auto">
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="@($"/courses/{course.Id}")">
                            Learn More
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid> *@
     }
     else
     {
          <BusyContent DisplayText=@L[MaktabResources.Msg_Initializing] />
     }



</MudContainer>

