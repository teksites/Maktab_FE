@page "/landing/mainpage"
@using Maktab.Consumer.Helpers
@using MaktabDataContracts.Responses.Course

@inherits BaseComponent<MainPage>

@inject IAccountService AccountService
@inject IUserService UserService
@inject IInstitutionService InstitutionService
@inject ICourseService CourseService


@* @inject IAlertService AlertService *@

<MudContainer Class="mt-10 mb-10" >

     <!-- Hero Section -->
     <MudPaper Class="pa-8 d-flex flex-column align-center justify-center text-center" Elevation="0">
          <MudText Typo="Typo.h3" GutterBottom="true">Welcome to Our Institution</MudText>
          <MudText Typo="Typo.subtitle1" Class="mb-6">Explore our wide range of courses and programs.</MudText>
          <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/courses/search">View All Courses</MudButton>
     </MudPaper>

     <!-- Courses Section -->
     <MudText Typo="Typo.h5" Class="mt-10 mb-6">Featured Courses</MudText>
     <CourseList Courses=@_courses />
