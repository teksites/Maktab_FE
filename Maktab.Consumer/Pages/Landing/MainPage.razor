@page "/landing/mainpage"
@using Maktab.Consumer.Helpers
@using Maktab.Consumer.State
@using MaktabDataContracts.Responses.Course
@using Maktab.Consumer.Extensions
@using MaktabDataContracts.Responses.Institute

@inherits LocalizeableBaseComponent<MainPage>

@inject IInstitutionService InstitutionService
@inject ICourseService CourseService
@inject UserStateService StateService

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-8">

    @* !-- Hero Section -- *@
    <MudPaper Elevation="0"
              Class="pa-10 mb-10 rounded-lg d-flex flex-column align-center justify-center text-center"
               Style="border: 1px solid var(--mud-palette-divider);">
        <MudText Typo="Typo.h4" Class="mb-2 fw-semibold">
            @L[MaktabResources.MainPage_Title]
        </MudText>
          <MudText Typo="Typo.body1" Class="mb-6" Style="color: var(--mud-palette-text-secondary);">
            @L[MaktabResources.MainPage_Description]
        </MudText>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Medium"
                   StartIcon="@Icons.Material.Outlined.MenuBook"
                   Href="@Constants.CourseSearchRoute">
            @L[MaktabResources.ViewAllCourses]
        </MudButton>
    </MudPaper>

    @* !-- Section heading -- *@
    <div class="d-flex align-center mb-4">
          <MudText Typo="Typo.h6" Class="mb-2" Style="font-weight: 600;">
            @L[MaktabResources.School] / @L[MaktabResources.Activities_Offered]
        </MudText>
    </div>

    @* !-- Institute list or loading state -- *@
    @if (isInitialized && !isDataLoading)
    {
        <InstituteList Institutes="@_institute" />
    }
    else
    {
          <MudGrid Spacing="3">
               @for (int i = 0; i < 4; i++)
               {
                    <MudItem xs="12" sm="6" md="4" lg="3">
                         <MudCard Style="border-radius: 12px; border: 1px solid var(--mud-palette-divider);">
                              <MudCardContent Class="pa-5">
                                   <div class="d-flex align-center gap-3 mb-4">
                                        <MudSkeleton SkeletonType="SkeletonType.Rectangle"
                                                     Width="40px" Height="40px"
                                                     Style="border-radius: 10px;" />
                                        <MudSkeleton Width="60%" Height="20px" />
                                   </div>
                                   <MudSkeleton Width="100%" Height="14px" Class="mb-2" />
                                   <MudSkeleton Width="80%" Height="14px" Class="mb-2" />
                                   <MudSkeleton Width="55%" Height="14px" />
                              </MudCardContent>
                              <MudDivider />
                              <MudCardActions Class="pa-4">
                                   <MudSkeleton Width="90px" Height="32px"
                                                Style="border-radius: 6px;" />
                              </MudCardActions>
                         </MudCard>
                    </MudItem>
               }
          </MudGrid>
    }

</MudContainer>

@code {
    bool isInitialized = false;
    bool isDataLoading;

    private IReadOnlyCollection<InstituteResponse> _institute =>
        StateService.InstituteState.Institutes ?? Array.Empty<InstituteResponse>();

    protected override void OnInitialized()
    {
        base.OnInitialized();
        StateService.InstituteState.OnChange += HandleStateChange;
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await LoadData();
        isInitialized = true;
        RequestRender();
    }

    private async Task LoadData(bool forceReload = false)
    {
        isDataLoading = true;
        await StateService.LoadActiveInstitutesData(InstitutionService, forceReload);
        isDataLoading = false;
    }

    protected virtual void HandleStateChange() => RequestRender();

    public void OnDispose()
    {
        StateService.InstituteState.OnChange -= HandleStateChange;
    }
}