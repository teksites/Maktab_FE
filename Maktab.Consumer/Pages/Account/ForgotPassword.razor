@page "/account/forgotpassword"

@inherits BaseFormComponent<Login>

@inject IUserService UserService

<MudGrid Justify="Justify.Center">
     <MudItem xs="12" sm="7" md="5">
          <MudPaper Class="pa-6" Elevation="8">

               <MudText Typo="Typo.h4" Class="mb-6 text-center">@L[MaktabResources.Forgot_Password]</MudText>

               <MudForm @ref="_form" @bind-IsValid="@_isValid" Validated="@(OnFormValidated)" Spacing="3" OnValidSubmit="@(HandleChangePasswordRequest)">


                              <MudTextField T="string" Label=@L[MaktabResources.Email]
                                            @bind-Value="username"
                                            Required="true"
                                  RequiredError=@L[MaktabResources.Msg_Info_Value_Is_Required, @L[MaktabResources.Email]]
                                            Immediate="true" />
                         @if (!string.IsNullOrWhiteSpace(_errorMessage))
                         {
                                   <MudAlert Severity="Severity.Error" Elevation="0" Class="my-4">
                                        @_errorMessage
                                   </MudAlert>
                         }



                    <MudButton Type="Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!_isValid || requestingToChangePassword)" OnClick="@(HandleChangePasswordRequest)">
                                   @if (requestingToChangePassword)
                                   {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                                        <span>@L[MaktabResources.Msg_Processing]</span>
                                   }
                                   else
                                   {
                              <span>@L[MaktabResources.Submit]</span>
                                   }
                              </MudButton>

               </MudForm>

          </MudPaper>
     </MudItem>
</MudGrid>

@code {
     private bool requestingToChangePassword = false;
     private string username = string.Empty;


     private async void HandleChangePasswordRequest()
     {
          try
          {
               requestingToChangePassword = true;
               RequestRender();
               await InvokeUserAction(InitiateChangePasswordRequest);
          }
          finally
          {
               requestingToChangePassword = false;
               RequestRender();
          }

     }

     private async Task InitiateChangePasswordRequest()
     {
          var userId = await SessionService.GetLoggedInUserSessionIdAsync();

          var isUserExists = await UserService.ValidateUsernameAsync(username);
          if (!isUserExists)
          {
               _errorMessage = L[MaktabResources.Msg_Error_Email_Not_Valid];
               Snackbar.Add(_errorMessage, Severity.Error);
          }

          var result = await UserService.ForgotUserPasswordAsync(username);
          if (!result)
          {
               _errorMessage = L[MaktabResources.Msg_Error_Request_Not_Processed];
               Snackbar.Add(_errorMessage, Severity.Error);
          }
          else
          {
               NavigationManager.NavigateTo(Constants.LoginRoute);
          }
     }
}