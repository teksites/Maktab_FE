@page "/account/forgotpassword"

@inherits BaseComponent<Login>

@inject IUserService UserService

<MudGrid Justify="Justify.Center">
     <MudItem xs="12" sm="7" md="5">
          <MudPaper Class="pa-6" Elevation="8">

               <MudText Typo="Typo.h4" Class="mb-6 text-center">Forgot password</MudText>

               <MudForm @ref="form" OnValidSubmit="InitiateChangePasswordRequest" Validated="OnValidated">


                    <MudTextField T="string" Label="Username"
                                  @bind-Value="username"
                                  Required="true"
                                  RequiredError="Username is required"
                                  Immediate="true" />

                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                         <MudAlert Severity="Severity.Error" Elevation="0" Class="my-4">
                              @errorMessage
                         </MudAlert>
                    }

 

                         <MudButton Type="Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@requestingToChangePassword" OnClick="@(InitiateChangePasswordRequest)">
                              @if (requestingToChangePassword)
                              {
                                   <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                                   <span>Requesting...</span>
                              }
                              else
                              {
                                   <span>Submit</span>
                              }
                         </MudButton>

               </MudForm>

          </MudPaper>
     </MudItem>
</MudGrid>

@code {
     private MudForm form;
     private bool requestingToChangePassword = false;
     private string username = string.Empty;

     private async Task InitiateChangePasswordRequest()
     {
          errorMessage = string.Empty;
          try
          {
               requestingToChangePassword = true;
               var userId = await SessionService.GetLoggedInUserSessionIdAsync();

               var isUserExists = await UserService.ValidateUsernameAsync(username);
               if (!isUserExists)
               {
                    errorMessage = "Please provide valid username.";
                    Snackbar.Add(errorMessage, Severity.Error);
               }

               var result = await UserService.ForgotUserPasswordAsync(username);
               if (!result)
               {
                    errorMessage = "Request can not be proceesed at this time, Please try again in few minutes.";
                    Snackbar.Add(errorMessage, Severity.Error);
               }
               // Redirect after successful login
               NavigationManager.NavigateTo("/account/login");

          }
          catch (UnauthorizedAccessException)
          {
               errorMessage = "Please provide valid credentials.";
               Snackbar.Add(errorMessage, Severity.Error);
          }
          catch (Exception)
          {
               errorMessage = "An unexpected error occurred. Please try again later.";
               Snackbar.Add(errorMessage, Severity.Error);
          }
          finally
          {
               requestingToChangePassword = false;
          }
     }

     private void OnValidated()
     {
          // Clear error message when form is valid
          if (form?.IsValid == true)
          {
               errorMessage = string.Empty;
          }
     }
}