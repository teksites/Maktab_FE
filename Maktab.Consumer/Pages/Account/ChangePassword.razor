@page "/account/changepassword"

@inherits BaseFormComponent<ChangePassword>

@using System.Text.RegularExpressions

@inject IUserService UserService

<MudGrid Justify="Justify.Center">
     <MudItem xs="12" sm="7" md="5">
          <MudPaper Class="pa-6" Elevation="8">

               <MudText Typo="Typo.h4" Class="mb-6 text-center">Change Password</MudText>

               <MudForm @ref="_form" @bind-IsValid="@_isValid" OnValidSubmit="@(InitiateChangePasswordRequest)" Validated="@(OnFormValidated)">


                    <MudTextField T="string" Label="Old Password" HelperText="Provide old password" @ref="oldPwField"
                                  InputType="InputType.Password"
                                  Required="true"
                                  RequiredError="Old Password is required!" />

                    <MudTextField T="string" Label="New Password" HelperText="Choose a strong password" @ref="newPwField"
                                  InputType="InputType.Password"
                                  Validation="@(new Func<string, IEnumerable<string>>(PasswordStrength))" Required="true"
                                  RequiredError="Password is required!" />
                    <MudTextField T="string"
                                  Label="Password" HelperText="Repeat the password" InputType="InputType.Password"
                                  Validation="@(new Func<string, string>(PasswordMatch))" />

                    @if (!string.IsNullOrWhiteSpace(_errorMessage))
                    {
                         <MudAlert Severity="Severity.Error" Elevation="0" Class="my-4">
                              @_errorMessage
                         </MudAlert>
                    }

                    <MudStack Direction="Row" Justify="Justify.FlexEnd" Spacing="2" Class="mt-6">
                         

                         <MudButton Type="Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@requestingToChangePassword" OnClick="@(InitiateChangePasswordRequest)">
                              @if (requestingToChangePassword)
                              {
                                   <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                                   <span>Processing...</span>
                              }
                              else
                              {
                                   <span>Change Password</span>
                              }
                         </MudButton>
                    </MudStack>

               </MudForm>

          </MudPaper>
     </MudItem>
</MudGrid>

@code {
     private bool requestingToChangePassword = false;
     MudTextField<string> oldPwField;
     MudTextField<string> newPwField;

     private async void HandleChangePasswordRequest()
     {
          requestingToChangePassword = true;
          RequestRender();
          await InitiateChangePasswordRequest();
          requestingToChangePassword = false;
          RequestRender();
     }

     private async Task InitiateChangePasswordRequest()
     {
          var userId = await SessionService.GetLoggedInUserSessionIdAsync();

          var changeRequest = new MaktabDataContracts.Requests.Users.UpdateUserPasswordRequest
               {
                    OldPassword = oldPwField.Value,
                    NewPassword = newPwField.Value
               };

          var result = await UserService.ChangeUserPasswordAsync(userId, changeRequest);
          if (result)
          {
               // Redirect after successful login
               NavigationManager.NavigateTo(Constants.LogoutRoute);
          }
          else
          {
               _errorMessage = "Request was not processed. Please retry in few minutes.";
          }
     }

     private string PasswordNotMatch(string arg)
     {
          if (oldPwField.Value == arg)
          {
               return "Please use different new password.";
          }

          return string.Empty;
     }

     private string PasswordMatch(string arg)
     {
          if (newPwField.Value != arg)
               return "Passwords don't match";
          return string.Empty;
     }
}