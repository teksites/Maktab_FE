@page "/account/usercodevalidation"
@using Maktab.Consumer.Helpers

@inherits BaseFormComponent<LoginCodeValidator>

@inject IAccountService AccountService
@inject IUserService UserService

@* @inject IAlertService AlertService *@

<MudGrid Justify="Justify.Center">
     <MudItem xs="12" sm="7" md="5">
          <MudPaper Class="pa-6" Elevation="8">

               @if(isInitialized.HasValue && isInitialized.Value)
               {
                    <MudText Typo="Typo.h4" Class="mb-6 text-center">Validate Code</MudText>
                         <MudForm @ref="_form" @bind-IsValid="@_isValid" OnValidSubmit="@(HandleCodeValidation)" Validated="@(OnFormValidated)">
                              <MudGrid Justify="Justify.Center">
                                   <MudItem xs="12">
                                        <MudAlert Severity="Severity.Info" Elevation="0" Class="mt-2">Please enter code sent in your email.</MudAlert>
                                   </MudItem>
                                   <MudItem xs="12">
                                        <MudTextField T="string" Label="Code" @bind-Text="@emailValidationCode" Required="true" RequiredError="Please enter code!" />
                                   </MudItem>

                                     <MudItem xs="12">
                                       <MudStack Row=true >

                                            <MudButton Disabled="@isSendingCodeAgain" onclick="@(HandleSendUserCode)" Variant="Variant.Text"
                                              Color="Color.Tertiary" >
                                        @if (isSendingCodeAgain)
                                        {
                                             <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                             <MudText Class="ms-2">Sending code</MudText>
                                        }
                                        else
                                        {
                                             <MudText>Send code again</MudText>
                                        }
                                        
                                   </MudButton>

                                   @*< MudText Class="mt-3 text-center">
                                        <MudLink Href="/register/customer" Color="Color.Tertiary">
                                             Create account
                                        </MudLink>
                                   </MudText> *@

                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!_isValid || isCodeValidating)" Class="ml-auto" OnClick="@(HandleCodeValidation)">

                              @if (isCodeValidating)
                              {
                                   <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                   <MudText Class="ms-2">Validating</MudText>
                              }
                              else
                              {
                                   <MudText>Validate</MudText>
                              }
                         </MudButton>
                                   </MudStack>
                              </MudItem>
                         @if (!string.IsNullOrWhiteSpace(_errorMessage))
                         {
                              <MudItem>
                              <MudAlert Severity="Severity.Error" Elevation="0" Class="mt-2">@_errorMessage</MudAlert>
                                   </MudItem>
                         }

                         
                         
                         </MudGrid>

                    </MudForm>
               }
               else
               {
                    <BusyContent DisplayText="Initializing"/>
               }
          </MudPaper>
     </MudItem>
</MudGrid>
@code {
     string username;
     Guid userId = Guid.Empty;
     bool success;
     bool isCodeValidating = false;
     bool isSendingCodeAgain = false;
     bool? isInitialized = false;
     string emailValidationCode =string.Empty;

     protected override async Task OnInitializedAsync()
     {
          //isInitialized = true;
          await base.OnInitializedAsync();

          username = await SessionService.GetUserNameAsync();
          userId = await SessionService.GetLoggedInUserIdAsync();
          var userInfo = await UserService.GetUserByIdAsync(userId);
          isInitialized = true;
          RequestRender();

          if (userInfo == null || !userInfo.IsActive)
          {
               NavigationManager.NavigateTo(Constants.LoginRoute);
          }
          else if (!userInfo.IfTempUser)
          {
               var extendedInfo = await UserService.GetExtendedInfoByUserIdAsync(userId);
               if (extendedInfo == null)
               {
                    NavigationManager.NavigateTo(Constants.CustomerAddProfileDetailRoute);
               }
               else
               {
                    NavigationManager.NavigateTo(Constants.CustomerDashboardRoute);
               }
          }
     }

     private async void HandleCodeValidation()
     {
          try
          {
               isCodeValidating = true;
               RequestRender();

               await InvokeUserAction(ValidateUserCode);

          }
          finally
          {
               isCodeValidating = false;
               RequestRender();
          }
     }

     private async Task ValidateUserCode()
     {

          var activated = await UserService.ActivateUserByCodeAsync(userId,
               new MaktabDataContracts.Requests.Users.UserVerificationRequest()
               {
                    EmailVerificationCode = emailValidationCode,
               });

          if(activated)
          {
               NavigationManager.NavigateTo(Constants.CustomerAddProfileDetailRoute);
          }
          else
          {
               _errorMessage = "Code can not be validated.";
               Snackbar.Add(_errorMessage, Severity.Error);
          }
     }


     private async void HandleSendUserCode()
     {
          try
          {
               isSendingCodeAgain = true;
               RequestRender();
               await InvokeUserAction(SendUserCode);
          }
          finally
          {
               isSendingCodeAgain = false;
               RequestRender();
          }
     }

     private async Task SendUserCode()
     {
          var codeSent = await UserService.SendUserActivationCodeAsync(userId);
          if (!codeSent)
          {
               _errorMessage = "Can not process, please try again in few minutes.";
               Snackbar.Add(_errorMessage, Severity.Error);
          }
     }
}
