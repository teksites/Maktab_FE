@page "/account/login"

@inherits BaseFormComponent<Login>

@using System.ComponentModel.DataAnnotations


<MudGrid Justify="Justify.Center">
     <MudItem xs="12" sm="7" md="5">
          <MudPaper Class="pa-6" Elevation="8">

               <MudText Typo="Typo.h4" Class="mb-6 text-center">Login</MudText>

               <MudForm @ref="_form" @bind-IsValid="@_isValid" OnValidSubmit="@(HandleLogin)" Validated="@(OnFormValidated)">

                    <MudTextField T="string" Label="Username"
                                  @bind-Value="username"
                                  Required="true"
                                  RequiredError="Username is required"
                                  Validation="@(new EmailAddressAttribute() {ErrorMessage = "The email address is invalid"})"
                                  Immediate="true" />
                     <MudStack  Spacing="0">
                    <MudTextField T="string" Label="Password"
                                  @bind-Value="password"
                                  InputType="InputType.Password"
                                  Required="true"
                                  RequiredError="Password is required"
                                  Immediate="true" />
                         <MudText Class="mt-2" Align="Align.End">
                              <MudLink Href="/account/forgotpassword" Color="Color.Default">Forgot password</MudLink>
                         </MudText>
                    </MudStack>

                    @if (!string.IsNullOrWhiteSpace(_errorMessage))
                    {
                         <MudAlert Severity="Severity.Error" Elevation="0" Class="my-4">
                              @_errorMessage
                         </MudAlert>
                    }

                    <MudStack Direction="Row" Justify="Justify.SpaceBetween" Spacing="4" Class="mt-6">
                         <MudButton Type="Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!_isValid || authenticating)" OnClick="@(HandleLogin)">
                              @if (authenticating)
                              {
                                   <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                                   <span>Authenticating...</span>
                              }
                              else
                              {
                                   <span>Login</span>
                              }
                         </MudButton>

                         <MudButton Href="/register/customer" Variant="Variant.Outlined" Color="Color.Primary" Disabled="@authenticating">Create new account</MudButton>
                    </MudStack>

               </MudForm>

          </MudPaper>
     </MudItem>
</MudGrid>

@code {


     private string username = string.Empty;
     private string password = string.Empty;
     private bool authenticating = false;

     private async void HandleLogin()
     {

          authenticating = true;
          RequestRender();
          await InvokeUserAction(LoginToSystem);
          authenticating = false;
          RequestRender();
     }

     private async Task LoginToSystem()
     {
          var logInfo = new MaktabDataContracts.Requests.Authentication.UserLoginInformation
               {
                    UserName = username,
                    Password = password
               };

          var result = await SessionService.Login(logInfo);
          if (result)
          {
               // Redirect after successful login
               NavigationManager.NavigateTo("/account/usercodevalidation");
          }
          else
          {
               _errorMessage = "Please provide valid credentials.";
               RequestRender();
          }
     }
}
