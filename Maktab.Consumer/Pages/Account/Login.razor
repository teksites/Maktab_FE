@page "/account/login"

@inherits BaseFormComponent<Login>

@using System.ComponentModel.DataAnnotations
@using Maktab.Consumer.Helpers
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthProvider

<MudContainer MaxWidth="MaxWidth.Small" Class="py-8">
     <MudPaper Class="pa-6" Elevation="0" Outlined="true">

               @if (isInitialized)
               {
               <MudText Typo="Typo.h5" Class="mb-6 text-center">@L[MaktabResources.Login]</MudText>

                    <MudForm @ref="_form" @bind-IsValid="@_isValid" OnValidSubmit="@(HandleLogin)" Validated="@(OnFormValidated)">

                         <MudTextField T="string" Label=@L[MaktabResources.Email]
                                       @bind-Value="username"
                                       Required="true"
                                       RequiredError=@L[MaktabResources.Email_Required]
                                       Validation="@(new EmailAddressAttribute() {ErrorMessage = @L[MaktabResources.Email_Invalid]})"
                                       Immediate="true" />
                         <MudStack Spacing="0">
                              <MudTextField T="string" Label=@L[MaktabResources.Password]
                                            @bind-Value="password"
                                            InputType="InputType.Password"
                                            Required="true"
                                            RequiredError=@L[MaktabResources.Password_Required]
                                            Immediate="true"
                                            @onkeydown="@(async (KeyboardEventArgs e) => await OnKeyDown(e))" />
                              <MudText Class="mt-2" Align="Align.End">
                                   <MudLink Href="@Constants.ForgotPasswordRoute" Color="Color.Default">@L[MaktabResources.Password_Forgot]</MudLink>
                              </MudText>
                         </MudStack>

                         @if (!string.IsNullOrWhiteSpace(_errorMessage))
                         {
                              <MudAlert Severity="Severity.Error" Elevation="0" Class="my-4">
                                   @_errorMessage
                              </MudAlert>
                         }

                    <MudStack Row="true" Spacing="2" Class="mt-6" Justify="Justify.FlexEnd">
                         <MudButton Href="@Constants.RegisterParentRoute" Variant="Variant.Outlined" 
                                    Color="Color.Default" StartIcon="@Icons.Material.Filled.AppRegistration"
                                    Disabled="@authenticating">@L[MaktabResources.Create_New_Account]</MudButton>
                         <MudButton Type="Submit" Variant="Variant.Filled" Color="Color.Primary" 
                                    StartIcon="@Icons.Material.Filled.Login"
                                    Disabled="@(!_isValid || authenticating)" OnClick="@(HandleLogin)">
                                   @if (authenticating)
                                   {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                                        <span>@L[MaktabResources.Authenticating]</span>
                                   }
                                   else
                                   {
                                        <span>@L[MaktabResources.Login]</span>
                                   }
                              </MudButton>
                         </MudStack>

                    </MudForm>
               }
               else
               {
                    <BusyContent DisplayText=@L[MaktabResources.Msg_Initializing] />
               }

          </MudPaper>
</MudContainer>

@code {

     bool isInitialized = false;
     private string username = string.Empty;
     private string password = string.Empty;
     private bool authenticating = false;

     protected async override Task OnInitializedAsync()
     {
          await base.OnInitializedAsync();
          bool isAuthorized = await SessionService.IsAuthenticatedAsync();
          if (isAuthorized)
          {
               NavigationManager.NavigateTo(Constants.CodeValidationRoute);
          }

          isInitialized = true;
          RequestRender();
     }

     private async Task OnKeyDown(KeyboardEventArgs e)
     {
          if (e.Key == "Enter" && _isValid && !authenticating)
          {
               await HandleLogin();
          }
     }

     private async Task HandleLogin()
     {
          authenticating = true;
          RequestRender();
          await InvokeUserAction(LoginToSystem);
          authenticating = false;
          RequestRender();
     }

     private async Task LoginToSystem()
     {
          var logInfo = new MaktabDataContracts.Requests.Authentication.UserLoginInformation
          {
               UserName = username,
               Password = password
          };

          var result = await SessionService.Login(logInfo);
          if (result)
          {
               if (AuthProvider is AuthStateProvider asp)
               {
                    asp.NotifyUserAuthentication();
               }
               // Redirect after successful login
               NavigationManager.NavigateTo(Constants.CodeValidationRoute);
          }
          else
          {
               _errorMessage = L[MaktabResources.Provide_Valid_Credentials];
               RequestRender();
          }
     }
}
