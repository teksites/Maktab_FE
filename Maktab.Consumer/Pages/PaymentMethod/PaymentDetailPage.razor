     public class InstituteGroupViewModel
     {
          public Guid InstituteId { get; set; }
          public List<CourseGroupViewModel> Courses { get; set; } = new();
     }

     public class CourseGroupViewModel
     {
          public Guid CourseId { get; set; }
          public List<StudentCourseTransactionResponse> Transactions { get; set; } = new();
     }

     private string GetCourseName(Guid courseId)
     {
          if (courseId == Guid.Empty) return string.Empty;

          var course = _Courses.FirstOrDefault(x => x.CourseId == courseId);
          if (course != null)
          {
               if (GlobalizationService.CurrentCulture.TwoLetterISOLanguageName == "fr")
               {
                    return course.NameFr;
               }
               else
               {
                    return course.Name;
               }
          }

          return string.Empty;
     }

     private string GetInstituteName(Guid instituteId)
     {
          if (instituteId == Guid.Empty) return string.Empty;

          var institute = _Institutes.FirstOrDefault(x => x.InstituteId == instituteId);
          if (institute != null)
          {
               if (GlobalizationService.CurrentCulture.TwoLetterISOLanguageName == "fr")
               {
                    return institute.NameFr;
               }
               else
               {
                    return institute.Name;
               }
          }

          return string.Empty;
     }

     private async Task OpenZeffyPaymentDialog(StudentCourseTransactionResponse courseTransaction)
     {
          const string url = "/PaymentMethod/Payment?amount={0}&code={1}&email={2}";
          if (courseTransaction != null)
          {
               string paymentCode = courseTransaction.PaymentCode;
               decimal amountPayable = courseTransaction.TotalPayable - courseTransaction.TotalAmountPaid;

               var navigationUrl = string.Format(url, amountPayable.ToString(), paymentCode, userInfo.Email);
               NavigationManager.NavigateTo(navigationUrl, false);
          }
     }

     private void InitializeBreadcrumbs()
     {
          breadcrumbItems = new List<BreadcrumbItem>
          {
               new BreadcrumbItem( L[MaktabResources.Dashboard], Constants.ParentDashboardRoute),
               new BreadcrumbItem( L[MaktabResources.Payment_Details], null, true)
          };
     }

     private async Task OpenPaymentScheduleDialog(StudentCourseTransactionResponse studentCourseTransactionResponse)
     {
          if(studentCourseTransactionResponse == null)
          {
               return;
          }

          var parameters = new DialogParameters { ["FeeInstallments"] = studentCourseTransactionResponse.FeeInstallments };
          var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = false, CloseOnEscapeKey = true, CloseButton = true };

          var dialog = await DialogService.ShowAsync<PaymentScheduleDialog>(L[MaktabResources.Payment_Schedule], parameters, options);
          var result = await dialog.Result;
     }
}