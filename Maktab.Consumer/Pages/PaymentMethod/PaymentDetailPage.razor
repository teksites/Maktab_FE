</MudContainer>



@code {

     private bool isInitialized;
     private bool isDataLoading;
     private Guid userId = Guid.Empty;
     private UserInformationResponse userInfo => StateService.ParentState.Profile;
     private IReadOnlyCollection<StudentCourseEnrollmentResponse> _CourseEnrollments => StateService.ParentState.CourseEnrollments ?? Array.Empty<StudentCourseEnrollmentResponse>();
     private IReadOnlyCollection<StudentCourseTransactionResponse> _CourseTransactions => StateService.ParentState.CourseTransactions ?? Array.Empty<StudentCourseTransactionResponse>();
     private IReadOnlyCollection<CourseResponseDetailed> _Courses => StateService.InstituteState.Courses ?? Array.Empty<CourseResponseDetailed>();
     private IReadOnlyCollection<InstituteResponse> _Institutes => StateService.InstituteState.Institutes ?? Array.Empty<InstituteResponse>();

     private List<InstituteGroupViewModel> GroupedData = new();
     private List<BreadcrumbItem> breadcrumbItems = new();

     private decimal TotalPayable => _CourseTransactions.Sum(x => x.TotalPayable);
     private decimal TotalPaid => _CourseTransactions.Sum(x => x.TotalAmountPaid);
     private decimal TotalFeeDiscount => _CourseTransactions.Sum(x => x.FeeAmountDiscount);
     private decimal TotalDayCareFeeDiscount => _CourseTransactions.Sum(x => x.DayCareDiscount);
     private decimal Outstanding => TotalPayable - (TotalPaid + TotalFeeDiscount + TotalDayCareFeeDiscount);

     protected override void OnInitialized()
     {
          base.OnInitialized();
          StateService.ParentState.OnChange += HandleStateChange;
          StateService.InstituteState.OnChange += HandleStateChange;
          InitializeBreadcrumbs();
     }

     protected virtual void HandleStateChange()
     {
          RequestRender();
     }

     public void OnDispose()
     {
          StateService.ParentState.OnChange -= HandleStateChange;
          StateService.InstituteState.OnChange -= HandleStateChange;
     }

     protected override async Task OnInitializedAsync()
     {
          await base.OnInitializedAsync();

          userId = await SessionService.GetLoggedInUserIdAsync();
          await LoadData(userId);

          GroupData();

          isInitialized = true;
          RequestRender();
     }

     private async Task LoadData(Guid userId, bool forceReload = false)
     {
          isDataLoading = true;

          await StateService.LoadUserProfileData(UserService, userId, forceReload);
          await StateService.LoadCourseEnrollments(CourseEnrollmentService, userInfo.FamilyId, forceReload);
          await StateService.LoadActiveCoursesData(CourseService, forceReload);
          await StateService.LoadActiveInstitutesData(InstitutionService, forceReload);
          if (_CourseEnrollments?.Any() == true)
          {
               await StateService.LoadCourseTransactionsByCourse(CourseEnrollmentTransactionService, _CourseEnrollments, userInfo.FamilyId, forceReload);
          }

          isDataLoading = false;
     }

     private void GroupData()
     {
          GroupedData = new List<InstituteGroupViewModel>();
          if (_CourseTransactions == null || !_CourseTransactions.Any())
          {
               return;
          }

          var coursesVM = new List<CourseGroupViewModel>();

          foreach (var transaction in _CourseTransactions)
          {
               if (transaction.Enrollments?.Any() == true)
               {
                    var courseVM = new CourseGroupViewModel
                    {
                         CourseId = transaction.Enrollments.First().CourseId,
                         Transactions = new List<StudentCourseTransactionResponse> { transaction }
                    };

                    coursesVM.Add(courseVM);
               }
          }

          foreach (var vm in coursesVM)
          {
               var course = _Courses.FirstOrDefault(c => c.CourseId == vm.CourseId);
               if (course != null)
               {
                    var institute = _Institutes.FirstOrDefault(i => i.InstituteId == course.InstituteId);
                    if (institute != null)
                    {
                         var instituteGroup = GroupedData.FirstOrDefault(g => g.InstituteId == institute.InstituteId);
                         if (instituteGroup == null)
                         {
                              instituteGroup = new InstituteGroupViewModel
                              {
                                   InstituteId = institute.InstituteId,
                                   Courses = new List<CourseGroupViewModel> { vm }
                              };
                              GroupedData.Add(instituteGroup);
                         }
                         else
                         {
                              instituteGroup.Courses.Add(vm);
                         }
                    }
               }
          }
     }

     private Color GetStatusColor(StudentCourseTransactionResponse tx)
     {
          if (tx.IsCompletelyPaid)
               return Color.Success;

          if (tx.TotalAmountPaid > 0)
               return Color.Warning;

          return Color.Error;
     }

     private Color GetAmountDueColor(StudentCourseTransactionResponse tx)
     {
          if (tx.IsCompletelyPaid)
               return Color.Success;

          if (tx.TotalPayable - tx.TotalAmountPaid > 0)
               return Color.Error;

          return Color.Default;
     }

     private string GetStatusText(StudentCourseTransactionResponse tx)
     {
          if (tx.IsCompletelyPaid)
               return L[MaktabResources.Paid];

          if (tx.TotalAmountPaid > 0)
               return L[MaktabResources.Partially_Paid];

          return L[MaktabResources.Unpaid];
     }

