                                                                           </MudText>
                                                                      </MudStack>

                                                                      <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                                                           <MudTooltip Text=@L[MaktabResources.Amount_Paid]>
                                                                                <MudText Typo="Typo.caption" Style="opacity: 0.7;">
