@page "/courses/{CourseId:guid}"
@using Maktab.Consumer.Base
@using Maktab.Consumer.Extensions
@using Maktab.Consumer.State
@using MaktabDataContracts.Responses.Course
@using MaktabDataContracts.Responses.Institute

@inherits LocalizeableBaseComponent<CourseDetails>

@inject IInstitutionService InstitutionService
@inject ICourseService CourseService
@inject UserStateService StateService

<MudContainer  Class="mt-8 mb-8">

     @if (isInitialized && !isDataLoading)
     {
          <MudPaper Class="pa-6">
               <!-- Back Navigation -->
               @* <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="BackToCourses" Class="mb-4">
                <MudIcon Icon="@Icons.Material.Filled.ArrowBack" /> Back to Courses
            </MudButton> *@

               <MudStack>
                    <!-- Title + Category -->
                    <div class="d-flex align-start gap-3 mb-3">
                         @* <MudAvatar Size="Size.Large" Style="background-color: var(--mud-palette-primary-lighten);
                              color: var(--mud-palette-primary);"
                         Rounded="true">
                              <MudIcon Icon="@Icons.Material.Outlined.MenuBook" Size="Size.Medium" />
                         </MudAvatar> *@
                         <MudText Typo="Typo.h4" Class="fw-semibold mt-1">
                              @GetCourseName(_course)
                         </MudText>
                    </div>
                    @* <MudText Typo="Typo.h4" GutterBottom="true">@(GetCourseName())</MudText> *@
                    <MudText Typo="Typo.subtitle1" Color="Color.Info" Class="mb-2">
                         @(GetCourseDetails(_course))
                    </MudText>
                    @* <MudText Typo="Typo.subtitle1" Color="Color.Secondary" Class="mb-2">
                    @_course.Instructor
               </MudText> *@


                    <!-- Image -->
                    <MudImage Src="images/courses/quran-recitation.jpg" Alt="@_course.Name" Width="300" Class="mb-4 rounded-lg" Elevation="2" />

                    <!-- Description -->
                    <MudText Typo="Typo.body1" Class="mb-4">@(GetCourseDescription(_course))</MudText>

                    <!-- Institute -->
                    <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Center">
                         <MudIcon Icon="@Icons.Material.Filled.School" Color="Color.Info" />
                         <MudText Typo="Typo.subtitle1">
                              <b>@L[MaktabResources.School]</b> @(GetInstituteName(_institute))
                         </MudText>
                    </MudStack>

                    @if (!string.IsNullOrEmpty(_course.PolicyHyperLink))
                    {
                         <MudLink Target="" Href="@_course.PolicyHyperLink">@L[MaktabResources.Policy]</MudLink>
                    }

                    <MudDivider />

                    <!-- Dates -->
                    <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Center">
                         <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Color="Color.Info" />
                         <MudText Typo="Typo.subtitle1">
                              <b>@L[MaktabResources.Date_Start]</b> @_course.StartDate.ToString("dd MMM yyyy")
                         </MudText>
                         <MudText Typo="Typo.subtitle1">
                              <b>@L[MaktabResources.Date_End]</b> @_course.EndDate.ToString("dd MMM yyyy")
                         </MudText>

                         @if (_course.IsRegistrationOpened)
                         {
                              <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">@L[MaktabResources.Registration_Open]</MudChip>
                         }
                         else
                         {
                              <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined">@L[MaktabResources.Registration_Closed]</MudChip>
                         }
                    </MudStack>


                    <!-- Modules -->
                    @*  <CourseModules Modules="@_course.Modules" /> *@

                    <CourseGroupList CourseGroups="@_course.CourseEnrollmentGroups" />


               </MudStack>
               <!-- CTA -->

               @*                <MudChipSet T="string">
                    @foreach (var cat in _course.AcedemicGroups)
                    {
                         <MudChip Color="Color.Secondary" Variant="Variant.Outlined">@cat</MudChip>
                    }
               </MudChipSet> *@

               @*                <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined">
                    @_course.Category
               </MudChip> *@

               <!-- Actions -->
               <MudDivider />

               <MudButton Variant="Variant.Filled" Class="mt-4" Color="Color.Primary" Size="Size.Large" OnClick="@EnrollChild">
                    @L[MaktabResources.Enroll_Now]
               </MudButton>
          </MudPaper>
     }
     else
     {
          <BusyContent DisplayText="@L[MaktabResources.Msg_Loading_Course_Details]" />
     }
</MudContainer>

     @code {
     [Inject] private IDialogService DialogService { get; set; } = default!;

     [Parameter] public Guid CourseId { get; set; }
     private CourseResponseDetailed? _course;
     private InstituteResponse? _institute;  

     private bool isInitialized = false;
     private bool isDataLoading = false;


     protected override void OnInitialized()
     {
          base.OnInitialized();
          StateService.InstituteState.OnChange += HandleStateChange;
     }

     protected virtual void HandleStateChange()
     {
          RequestRender();
     }

     protected override void OnDispose()
     {
          StateService.InstituteState.OnChange -= HandleStateChange;
          base.OnDispose();
     }

     protected override async Task OnInitializedAsync()
     {
          await LoadData();

          isInitialized = true;

          RequestRender();
     }

     private async Task LoadData(bool forceReload = false)
     {
          isDataLoading = true;

          await StateService.LoadActiveInstitutesData(InstitutionService, forceReload);
          await StateService.LoadActiveCoursesData(CourseService, forceReload);

          _course = StateService.InstituteState.Courses?.FirstOrDefault(c => c.CourseId == CourseId);
          _institute = StateService.InstituteState.Institutes?.FirstOrDefault(i => i.InstituteId == _course?.InstituteId);

          isDataLoading = false;
     }

     protected async void EnrollChild()
     {
          bool isAuthorized = await SessionService.IsAuthenticatedAsync();
          if (isAuthorized)
          {
               NavigationManager.NavigateTo(Constants.ParentDashboardRoute);
          }
          else
          {
               NavigationManager.NavigateTo(Constants.LoginRoute);
          }
     }
}
