@page "/courses/{CourseId:guid}"
@using Maktab.Consumer.Base
@using MaktabDataContracts.Responses.Course

@inherits LocalizeableBaseComponent<CourseDetails>


@inject IInstitutionService InstitutionService
@inject ICourseService CourseService

@inject NavigationManager Navigation

<MudContainer  Class="mt-8 mb-8">
    @if (_course is null)
    {
        <MudText Typo="Typo.h6">@L[MaktabResources.Msg_Loading_Course_Details]</MudText>
    }
    else
    {
        <MudPaper Class="pa-6">
            <!-- Back Navigation -->
            @* <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="BackToCourses" Class="mb-4">
                <MudIcon Icon="@Icons.Material.Filled.ArrowBack" /> Back to Courses
            </MudButton> *@

            <MudStack>
            <!-- Title + Category -->
                    <MudText Typo="Typo.h4" GutterBottom="true">@(GetCourseName())</MudText>
                    <MudText Typo="Typo.subtitle1" Color="Color.Info" Class="mb-2">
                         @(GetCourseDetails())
                    </MudText>
                    @* <MudText Typo="Typo.subtitle1" Color="Color.Secondary" Class="mb-2">
                    @_course.Instructor
               </MudText> *@


                    <!-- Image -->
                    <MudImage Src="images/courses/quran-recitation.jpg" Alt="@_course.Name" Width="300" Class="mb-4 rounded-lg" Elevation="2" />

            <!-- Description -->
                    <MudText Typo="Typo.body1" Class="mb-4">@(GetCourseDescription())</MudText>

                    @if (!string.IsNullOrEmpty(_course.PolicyHyperLink))
                    {
                         <MudLink Target="" Href="@_course.PolicyHyperLink">@L[MaktabResources.Policy]</MudLink>
                    }

            <MudDivider />

             <!-- Dates -->
            <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Center">
                <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Color="Color.Info" />
                <MudText Typo="Typo.subtitle1">
                              <b>@L[MaktabResources.Date_Start]</b> @_course.StartDate.ToString("dd MMM yyyy")
                </MudText>
                    <MudText Typo="Typo.subtitle1">
                              <b>@L[MaktabResources.Date_End]</b> @_course.EndDate.ToString("dd MMM yyyy")
                    </MudText>

                         @if(_course.IsRegistrationOpened)
                {
                              <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">@L[MaktabResources.Registration_Open]</MudChip>
                }
            </MudStack>


            <!-- Modules -->
           @*  <CourseModules Modules="@_course.Modules" /> *@

                    <CourseGroupList CourseGroups="@_course.CourseEnrollmentGroups" />

            <MudDivider Class="my-4" />

            
               </MudStack>
               <!-- CTA -->

@*                <MudChipSet T="string">
                    @foreach (var cat in _course.AcedemicGroups)
                    {
                         <MudChip Color="Color.Secondary" Variant="Variant.Outlined">@cat</MudChip>
                    }
               </MudChipSet> *@

@*                <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined">
                    @_course.Category
               </MudChip> *@

               <!-- Actions -->
               <MudDivider />

               <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" OnClick="@EnrollChild">
                    @L[MaktabResources.Enroll_Now]
               </MudButton>
        </MudPaper>
    }
</MudContainer>

@code {
     [Inject] private IDialogService DialogService { get; set; } = default!;

     [Parameter] public Guid CourseId { get; set; }
     private CourseResponseDetailed? _course;

     //private IEnumerable<CourseEnrollmentGroupResponse> _couseGroups;


     protected override async Task OnInitializedAsync()
     {
          _course = await CourseService.GetCourseByIdAsync(CourseId);
          RequestRender();
          //_couseGroups = await CourseGroupService.GetEnrollmentGroupsByCourseIdAsync(CourseId);
     }

     protected async void EnrollChild()
     {
          bool isAuthorized = await SessionService.IsAuthenticatedAsync();
          if (isAuthorized)
          {
              //await OpenAssignmentDialog(CourseId);
               NavigationManager.NavigateTo(Constants.ParentDashboardRoute);
          }
          else
          {
               NavigationManager.NavigateTo(Constants.LoginRoute);
          }

     }
     

    private void BackToCourses() => Navigation.NavigateTo("/");

     private async Task OpenAssignmentDialog(Guid courseId)
     {
          var parameters = new DialogParameters { ["CourseId"] = courseId };
          var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };

          var dialog = DialogService.Show<Dialogs.AssignChildrenToCourseDialog>( "Assign children to course" , parameters, options);
          var result = await dialog.Result;

          if (!result.Canceled )//&& result.Data is ChildResponse savedChild)
          {
               Snackbar.Add("Course assigned!", Severity.Success);

               // if (child == null)
               // {
               //      //Parent.Children.Add(savedChild);
               //      Snackbar.Add("Child added successfully!", Severity.Success);
               // }
               // else
               // {
               //      // var index = Parent.Children.FindIndex(c => c.Id == savedChild.Id);
               //      // if (index >= 0) Parent.Children[index] = savedChild;
               //      Snackbar.Add("Child updated successfully!", Severity.Success);
               // }
          }
     }

     private string GetCourseName()
     {
          if (GlobalizationService.CurrentCulture.TwoLetterISOLanguageName == "fr")
          {
               return _course.NameFr;
          }
          else
          {
               return _course.Name;
          }
     }

     private string GetCourseDetails()
     {
          if (GlobalizationService.CurrentCulture.TwoLetterISOLanguageName == "fr")
          {
               return _course.DetailsFr;
          }
          else
          {
               return _course.Details;
          }
     }

     private string GetCourseDescription()
     {
          if (GlobalizationService.CurrentCulture.TwoLetterISOLanguageName == "fr")
          {
               return _course.DescriptionFr;
          }
          else
          {
               return _course.Description;
          }
     }

}
