@inherits LayoutComponentBase

@inject IStringLocalizer<Shared_MainLayout> l
@inject ThemeService ThemeService

@* Required *@
<MudThemeProvider Theme="ThemeService.CurrentTheme" IsDarkMode="ThemeService.IsDarkMode" />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

@* Needed for snackbars *@
<MudSnackbarProvider />

<MudLayout>
     <MudAppBar Elevation="1" Color="Color.Primary">
          <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
          <MudText Typo="Typo.h5" Class="ml-3">Maktab</MudText>
          <MudSpacer />
          <MudToolBar Edge="Edge.End">
               @* <MudIconButton Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" Edge="Edge.End" /> *@

               <MudMenu Dense
                        Variant="Variant.Text"
                        Color="Color.Inherit"
                        Icon="@Icons.Material.TwoTone.MoreVert">

                    @* <MudMenu StartIcon="@Icons.Material.TwoTone.Settings"
                             IconColor="Color.Primary"
                             Label="Settings">
                         <MudMenuItem Icon="@Icons.Material.TwoTone.DarkMode"
                                      IconColor="Color.Secondary"
                                      Label="Dark Theme" />
                    </MudMenu> 

                    <MudDivider />*@

                    <MudMenuItem Href="/account/login"
                                 ForceLoad
                                 Icon="@Icons.Material.TwoTone.Login"
                                 IconColor="Color.Primary"
                                 Label="Sign In" />



               </MudMenu>
               <MudIconButton Icon="@Icons.Material.Filled.Brightness4" OnClick="@ToggleTheme" />
               <MudTooltip Text="Notification">
                    <MudBadge Dot="true" Visible="false" Class="mx-6 my-4" Overlap="true" Bordered="true">
                         <MudIconButton Icon="@Icons.Material.Outlined.Notifications" Color="Color.Inherit" Edge="Edge.End" />
                    </MudBadge>
               </MudTooltip>
               <MudMenu Dense>
                    <ActivatorContent>
                         <MudAvatar Color="Color.Inherit" Variant="Variant.Outlined">M</MudAvatar>
                    </ActivatorContent>
                    <ChildContent>
                         <MudMenuItem Href="/account/logout"
                                      ForceLoad
                                      Icon="@Icons.Material.TwoTone.Logout"
                                      IconColor="Color.Primary"
                                      Label="Sign Out" />
                    </ChildContent>
               </MudMenu>
          </MudToolBar>

     </MudAppBar>
     <MudDrawer @bind-Open="@_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
          <NavMenu />
     </MudDrawer>

     <MudMainContent>
          <ErrorBoundary>
               <MudAlert hidden="true" />
               <MudContainer MaxWidth="MaxWidth.Large">
                    <ChildContent>
                         @Body
                    </ChildContent>
               </MudContainer>
          </ErrorBoundary>
     </MudMainContent>
</MudLayout>


@code {
     bool _drawerOpen = false;

     void DrawerToggle()
     {
          _drawerOpen = !_drawerOpen;
     }

     private async Task ToggleTheme()
     {
          await ThemeService.ToggleThemeAsync();
          StateHasChanged();
     }
}
