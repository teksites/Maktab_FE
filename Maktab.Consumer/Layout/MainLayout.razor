@code {
     bool _drawerOpen = false;
     private bool _rightToLeft = false;
     private bool _isAuthenticated;
     private bool isInitialized = false;
     private string? _userName;
     private string? _userRole;
     private string _userInitials = "?";
     private string _defaultCulture = "en";
     private string _SelectedFlag = "/images/flag_canada.png";

     private string[] manifestName;
     private IStringLocalizer localizer;

     protected override async Task OnInitializedAsync()
     {
          _defaultCulture = await GlobalizationService.GetPersistedCultureName() ?? "en";
          UpdateLanguageFlag(_defaultCulture);

          var authState = await AuthStateProvider.GetAuthenticationStateAsync();
          var user = authState.User;

          _isAuthenticated = user?.Identity?.IsAuthenticated ?? false;

          if (_isAuthenticated)
          {
               if (string.IsNullOrEmpty(user.Identity?.Name) &&
                    AuthStateProvider is AuthStateProvider au)
               {
                    _userName = au.Username;
               }

               if (string.IsNullOrEmpty(_userName))
               {
                    _userName = "?";
               }

               _userRole = user.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value ?? "Unknown";
               _userInitials = new string(_userName
                   .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                   .Select(n => n[0])
                   .ToArray()).ToUpper();
          }

          AuthStateProvider.AuthenticationStateChanged += async task =>
         {
              var state = await task;
              _isAuthenticated = state.User.Identity?.IsAuthenticated ?? false;

              if (_isAuthenticated && AuthStateProvider is AuthStateProvider au)
              {
                   _userName = au.Username;
              }

              if (string.IsNullOrEmpty(_userName))
              {
                   _userName = "?";
              }

              _userRole = user.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value ?? "Unknown";
              _userInitials = new string(_userName
                  .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                  .Select(n => n[0])
                  .ToArray()).ToUpper();
              StateHasChanged();
         };

          isInitialized = true;
          StateHasChanged();
     }

     void DrawerToggle()
     {
          _drawerOpen = !_drawerOpen;
     }

     private async Task ToggleTheme()
     {
          await ThemeService.ToggleThemeAsync();
          StateHasChanged();
     }

     MudTheme IccBrossardTheme = new MudTheme()
     {
          PaletteLight = new PaletteLight()
          {
               Primary = Colors.BlueGray.Darken2,
          },
          PaletteDark = new PaletteDark()
          {
               Primary = Colors.BlueGray.Lighten1
          },

     };

     private async Task UpdateLanguageFlag(string lang)
     {
          if (!string.IsNullOrWhiteSpace(lang))
          {

               switch (lang)
               {
                    case "fr":
                         _SelectedFlag = "/images/flag_france.png";
                         break;
                    default:
                         _SelectedFlag = "/images/flag_canada.png";
                         break;
               }
          }
     }

     private async Task SelectLanguage(string lang)
     {
          if (!string.IsNullOrWhiteSpace(lang))
          {

               UpdateLanguageFlag(lang);

               await OnCultureChanged(lang);
          }
     }

     private async Task OnCultureChanged(string culture)
     {

          await GlobalizationService.SaveCultureAsync(culture);

          // var ci = new CultureInfo(culture);
          // CultureInfo.DefaultThreadCurrentCulture = ci;
          // CultureInfo.DefaultThreadCurrentUICulture = ci;

          // Force UI refresh
          //StateHasChanged();
     }
}
