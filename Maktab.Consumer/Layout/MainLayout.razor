                              <ActivatorContent>
                                   <MudImage Src="@_SelectedFlag" Style="width: 24px" />
                              </ActivatorContent>

                              <ChildContent>
                                   <MudMenuItem OnClick="@(async () => await SelectLanguage("en"))">
