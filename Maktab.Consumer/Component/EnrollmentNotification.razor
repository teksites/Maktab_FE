@inherits BaseFormComponent<EnrollmentNotification>
@using MaktabDataContracts.Responses.Course
@using MudBlazor

<MudPaper Class="pa-4 rounded-lg shadow-sm" Elevation="2">
    <div class="d-flex justify-space-between align-center mb-2">
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.NotificationsActive" Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.h6">Enrollment Notifications</MudText>
        </div>
        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ViewAll">
            View All
        </MudButton>
    </div>

    @if (Enrollments?.Any() == true)
    {
        <MudList T="StudentCourseEnrollmentResponse" Dense="true">
            @foreach (var enrollment in Enrollments.Take(5))
            {
                <MudListItem>
                     <AvatarContent>
                        <MudAvatar Color="Color.Info" Size="Size.Small" Icon="@Icons.Material.Filled.School" />
                         </AvatarContent>
                    <ChildContent>
                        <div>
                            <MudText Typo="Typo.subtitle2">@GetCourseTitle(enrollment.CourseId)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Enrolled on @enrollment.CreatedAt.ToShortDateString()
                            </MudText>
                        </div>
                    </ChildContent>
@*                     <MudListItemIcon>
                        <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowRight" Size="Size.Small"
                                       OnClick="() => ViewDetails(enrollment)" />
                    </MudListItemIcon> *@
                </MudListItem>
            }
        </MudList>
    }
    else
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">No recent enrollments.</MudText>
    }
</MudPaper>

@code {
    [Parameter] public IEnumerable<StudentCourseEnrollmentResponse>? Enrollments { get; set; }
    [Parameter] public EventCallback<StudentCourseEnrollmentResponse> OnViewDetails { get; set; }
    [Parameter] public EventCallback OnViewAll { get; set; }

    private void ViewDetails(StudentCourseEnrollmentResponse enrollment)
        => OnViewDetails.InvokeAsync(enrollment);

    private void ViewAll()
        => OnViewAll.InvokeAsync();

    // In a real app this would come from a cache or injected service
    private string GetCourseTitle(Guid courseId)
        => $"Course #{courseId.ToString().Substring(0, 5)}";
}
