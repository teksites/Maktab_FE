@code {
     [Parameter] public IEnumerable<StudentCourseEnrollmentResponse>? Enrollments { get; set; }
     [Parameter] public IEnumerable<ChildResponse>? Children { get; set; }
     [Parameter] public IEnumerable<CourseResponseDetailed>? Courses { get; set; }


     [Parameter] public EventCallback<StudentCourseEnrollmentResponse> OnViewDetails { get; set; }
     [Parameter] public EventCallback OnViewAll { get; set; }
     [Parameter] public int MaxItems { get; set; } = 5;

     private Task ViewDetails(StudentCourseEnrollmentResponse e) => OnViewDetails.InvokeAsync(e);
     private Task ViewAll() => OnViewAll.InvokeAsync();

     // placeholder - replace with a real resolver from services
     private CourseResponseDetailed GetCourse(Guid courseId)
     {
          var course = Courses?.FirstOrDefault(x => x.CourseId == courseId);

          // if(string.IsNullOrEmpty(courseName))
          // {
          //      return $"Course {courseId.ToString()[..5]}";
          // }

          return course;

     }

     private CourseEnrollmentGroupResponse GetCourseEnrollmentGroup(Guid groupId)
     {
          var group = Courses.SelectMany(x => x.CourseEnrollmentGroups).FirstOrDefault(y => y.CourseEnrollmentGroupId == groupId);

          // if(string.IsNullOrEmpty(courseName))
          // {
          //      return $"Course {courseId.ToString()[..5]}";
          // }

          return group;

     }

     private string GetChildName(Guid childId)
     {
          var child = Children?.FirstOrDefault(x => x.ChildId == childId);

          if (child == null)
          {
               return $"Child {childId.ToString()[..5]}";
          }

          return $"{child.FirstName} {child.LastName}";
     }

}


