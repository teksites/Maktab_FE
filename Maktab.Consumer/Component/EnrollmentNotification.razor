@code {
     private IReadOnlyCollection<StudentCourseEnrollmentResponse> Enrollments => StateService.ParentState.CourseEnrollments ?? Array.Empty<StudentCourseEnrollmentResponse>();
     private IReadOnlyCollection<ChildResponse>? Children => StateService.ParentState.Children ?? Array.Empty<ChildResponse>();
     private IReadOnlyCollection<CourseResponseDetailed>? Courses => StateService.InstituteState.Courses ?? Array.Empty<CourseResponseDetailed>();

     private int GetAwatingEnrollmentCount(IEnumerable<StudentCourseEnrollmentResponse> studentEnrollments)
     {
          return studentEnrollments?.Count(x => x.EnrollmentStatus == MaktabDataContracts.Enums.EnrollmentStatus.Awaiting) ?? 0;
     }

     [Parameter] public EventCallback<StudentCourseEnrollmentResponse> OnViewDetails { get; set; }
     //[Parameter] public EventCallback OnViewAll { get; set; }
     [Parameter] public int MaxItems { get; set; } = 5;

     private UserInformationResponse userInfo => StateService.ParentState.Profile;

     protected override void OnInitialized()
     {
          base.OnInitialized();
          StateService.ParentState.OnChange += HandleStateChange;
          StateService.InstituteState.OnChange += HandleStateChange;
     }

     protected virtual void HandleStateChange()
     {
          RequestRender();
     }

     public void OnDispose()
     {
          StateService.ParentState.OnChange -= HandleStateChange;
          StateService.InstituteState.OnChange -= HandleStateChange;

     }

     private Task ViewDetails(StudentCourseEnrollmentResponse e) => OnViewDetails.InvokeAsync(e);

     //private Task ViewAll() => OnViewAll.InvokeAsync();

     // placeholder - replace with a real resolver from services
     private string GetCourseName(Guid courseId)
     {
          var course = Courses?.FirstOrDefault(x => x.CourseId == courseId);

          if (course != null)
          {

               if (GlobalizationService.CurrentCulture.TwoLetterISOLanguageName == "fr")
               {
                    return course.NameFr;
               }
               else
               {
                    return course.Name;
               }
          }

          return string.Empty;

     }

     private CourseEnrollmentGroupResponse GetCourseEnrollmentGroup(Guid groupId)
     {
          var group = Courses.SelectMany(x => x.CourseEnrollmentGroups).FirstOrDefault(y => y.CourseEnrollmentGroupId == groupId);

          // if(string.IsNullOrEmpty(courseName))
          // {
          //      return $"Course {courseId.ToString()[..5]}";
          // }

          return group;
     }

     private string GetCourseEnrollmentGroupTitle(Guid groupId)
     {
          var group = GetCourseEnrollmentGroup(groupId);

          if (group != null)
          {

               if (GlobalizationService.CurrentCulture.TwoLetterISOLanguageName == "fr")
               {
                    return group.GroupTitleFr;
               }
               else
               {
                    return group.GroupTitle;
               }
          }

          return string.Empty;
     }


     private int GetDayCareFee(StudentCourseEnrollmentResponse enrollmentResponse)
     {
          if (!enrollmentResponse.WillUseDayCare)
          {
               return 0;
          }
          var group = Courses?.SelectMany(x => x.CourseEnrollmentGroups).FirstOrDefault(y => y.CourseEnrollmentGroupId == enrollmentResponse.CourseEnrollmentGroupId);
          if (group != null)
          {
               return group.DayCareFee;
          }

          return 0;
     }

     private string GetChildName(Guid childId)
     {
          var child = Children?.FirstOrDefault(x => x.ChildId == childId);

          if (child == null)
          {
               return $"Child {childId.ToString()[..5]}";
          }

          return $"{child.FirstName} {child.LastName}";
     }

     private string GetUseDayCareStatusText(StudentCourseEnrollmentResponse studentCourseEnrollment) => studentCourseEnrollment.WillUseDayCare ? L[MaktabResources.Yes] : L[MaktabResources.No];

     private async Task RemoveEnrollment(StudentCourseEnrollmentResponse e)
     {
          if (CanRemoveEnrollment(e))
          {
               bool? result = await DialogService.ShowMessageBox(
                      L[MaktabResources.Warning],
                     L[MaktabResources.Msg_Question_Remove_Enrollment],
                      yesText: L[MaktabResources.Remove], cancelText: L[MaktabResources.Cancel]);
               if (result.HasValue && result.Value)
               {
                    var enrollmentRemoved = await CourseEnrollmentService.RemoveCourseEnrollmentByIdAsync(e.StudentCourseEnrollmentId);
                    if (enrollmentRemoved)
                    {
                         await StateService.LoadCourseEnrollments(CourseEnrollmentService, userInfo.FamilyId, true);
                         await StateService.LoadCourseTransactionsByCourse(
                                   CourseEnrollmentTransactionService,
                                   Enrollments,
                                   userInfo.FamilyId,
                                   true);
                         Snackbar.Add(L[MaktabResources.Msg_Success_Remove_Enrollment], Severity.Success);
                    }
                    else
                    {
                         Snackbar.Add(L[MaktabResources.Msg_Error_Remove_Enrollment], Severity.Error);
                    }
               }
          }
          else
          {
               Snackbar.Add(L[MaktabResources.Msg_Error_Can_Only_Remove_Awaiting_Enrollment], Severity.Error);
          }
     }

     private bool CanRemoveEnrollment(StudentCourseEnrollmentResponse enrollment)
     {
          // Implement any logic to determine if the enrollment can be removed
          // For example, you might check if the enrollment is active or if there are any pending transactions
          return enrollment.IsActive && enrollment.EnrollmentStatus == MaktabDataContracts.Enums.EnrollmentStatus.Awaiting; // Placeholder - allow all removals for now
     }

     private IList<StudentCourseEnrollmentResponse> GetOrderedEnrollments(IEnumerable<StudentCourseEnrollmentResponse> enrollments)
     {
          if (enrollments?.Any() != true)
          {
               return Array.Empty<StudentCourseEnrollmentResponse>();
          }

          var sortedEnrollments =
           enrollments
           .Where(x => x.EnrollmentStatus != EnrollmentStatus.Awaiting)
           .OrderBy(x => x.GroupIndex)
           // .ThenBy(x => x.EnrollmentStatus.Equals(EnrollmentStatus.Awaiting) ? 1 : 0)
           //.ThenBy(x => x.EnrollmentStatus)
           .ToList();

          sortedEnrollments.AddRange(
                enrollments.Where(x => x.EnrollmentStatus == EnrollmentStatus.Awaiting)
           .OrderBy(x => x.GroupIndex)
          );

          return sortedEnrollments;
     }

     private string GetChildPanelTitle(IGrouping<string, StudentCourseEnrollmentResponse> group)
     {
          var countOfAwaitingEnrollments = group.Count(x => x.EnrollmentStatus == EnrollmentStatus.Awaiting);
          var countOfRegistedEnrollments = group.Count(x => x.EnrollmentStatus == EnrollmentStatus.Enrolled || x.EnrollmentStatus == EnrollmentStatus.Registered);
          var countOfCancelledEnrollments = group.Count(x => x.EnrollmentStatus == EnrollmentStatus.Refunded || x.EnrollmentStatus == EnrollmentStatus.Cancelled);

          var titleBuilder = new StringBuilder();

          if (countOfRegistedEnrollments > 0 || countOfCancelledEnrollments > 0 || countOfAwaitingEnrollments > 0)
          {
               //titleBuilder.Append(" (");
               bool addedSeparator = false;
               if (countOfRegistedEnrollments > 0)
               {
                    titleBuilder.Append($" {countOfRegistedEnrollments}: {L[MaktabResources.EnrollmentStatus_Enrolled]} ");
                    addedSeparator = true;
               }

               if (countOfAwaitingEnrollments > 0)
               {
                    if (addedSeparator)
                    {
                         titleBuilder.Append(" / ");
                         addedSeparator = false;
                    }

                    titleBuilder.Append($" {countOfAwaitingEnrollments}: {L[MaktabResources.EnrollmentStatus_Awaiting]} ");
               }

               if (countOfCancelledEnrollments > 0)
               {
                    if (addedSeparator)
                    {
                         titleBuilder.Append(" / ");
                         addedSeparator = false;
                    }

                    titleBuilder.Append($" {countOfCancelledEnrollments}: {L[MaktabResources.EnrollmentStatus_Cancelled]} ");
               }

               //titleBuilder.Append(" )");
          }

          return titleBuilder.ToString();
     }

     private string GetCoursePanelTitle(IGrouping<Guid, StudentCourseEnrollmentResponse> group)
     {
          var countOfAwaitingEnrollments = group.Count(x => x.EnrollmentStatus == EnrollmentStatus.Awaiting);
          var countOfRegistedEnrollments = group.Count(x => x.EnrollmentStatus == EnrollmentStatus.Enrolled || x.EnrollmentStatus == EnrollmentStatus.Registered);
          var countOfCancelledEnrollments = group.Count(x => x.EnrollmentStatus == EnrollmentStatus.Refunded || x.EnrollmentStatus == EnrollmentStatus.Cancelled);

          var titleBuilder = new StringBuilder();

          if (countOfRegistedEnrollments > 0 || countOfCancelledEnrollments > 0 || countOfAwaitingEnrollments > 0)
          {
               //titleBuilder.Append(" (");
               bool addedSeparator = false;
               if (countOfRegistedEnrollments > 0)
               {
                    titleBuilder.Append($" {countOfRegistedEnrollments}: {L[MaktabResources.EnrollmentStatus_Enrolled]} ");
                    addedSeparator = true;
               }

               if (countOfAwaitingEnrollments > 0)
               {
                    if (addedSeparator)
                    {
                         titleBuilder.Append(" / ");
                         addedSeparator = false;
                    }

                    titleBuilder.Append($" {countOfAwaitingEnrollments}: {L[MaktabResources.EnrollmentStatus_Awaiting]} ");
               }

               if (countOfCancelledEnrollments > 0)
               {
                    if (addedSeparator)
                    {
                         titleBuilder.Append(" / ");
                         addedSeparator = false;
                    }

                    titleBuilder.Append($" {countOfCancelledEnrollments}: {L[MaktabResources.EnrollmentStatus_Cancelled]} ");
               }

               //titleBuilder.Append(" )");
          }

          return titleBuilder.ToString();
     }
}


