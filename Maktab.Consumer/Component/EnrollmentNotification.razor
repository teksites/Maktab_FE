@inherits BaseComponent<EnrollmentNotification>
@using MaktabDataContracts.Responses.Course
@using MudBlazor

@* @typeparam TEnrollment *@

<MudPaper Class="pa-4 rounded-lg" Elevation="2">
    <MudStack Row="true" AlignItems="AlignItems.Center" JustifyContent="space-between" Class="mb-2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.NotificationsActive" Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.h6">Enrollment Notifications</MudText>
        </MudStack>
        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ViewAll">View All</MudButton>
    </MudStack>

    @if (Enrollments?.Any() == true)
    {
          <MudList T="StudentCourseEnrollmentResponse" Dense="true">
            @foreach (var enrollment in Enrollments.Take(MaxItems))
            {
                <MudListItem Class="py-2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="width:100%">
                        <MudAvatar Size="Size.Small" Color="Color.Info" Icon="@Icons.Material.Filled.School" />
                        <div style="flex:1; min-width:0">
                            <MudText Typo="Typo.subtitle2" Class="text-truncate">@GetCourseTitle(enrollment.CourseId)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@($"Enrolled on {enrollment.CreatedAt:d}")</MudText>
                        </div>

                        <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowRight" OnClick="@(() => ViewDetails(enrollment))" Edge="Edge.End" Color="Color.Default" />
                    </MudStack>
                </MudListItem>
            }
        </MudList>
    }
    else
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">No recent enrollments.</MudText>
    }
</MudPaper>

@code {
     [Parameter] public IEnumerable<StudentCourseEnrollmentResponse>? Enrollments { get; set; }
     [Parameter] public EventCallback<StudentCourseEnrollmentResponse> OnViewDetails { get; set; }
    [Parameter] public EventCallback OnViewAll { get; set; }
    [Parameter] public int MaxItems { get; set; } = 5;

     private Task ViewDetails(StudentCourseEnrollmentResponse e) => OnViewDetails.InvokeAsync(e);
    private Task ViewAll() => OnViewAll.InvokeAsync();

    // placeholder - replace with a real resolver from services
    private string GetCourseTitle(Guid courseId) => $"Course {courseId.ToString()[..5]}";
}


