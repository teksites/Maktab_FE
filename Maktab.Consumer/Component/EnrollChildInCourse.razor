@code {
     [Parameter] public EventCallback OnCompleted { get; set; }
     [Parameter] public ChildResponse? SelectedChild { get; set; }


     protected int ActiveStep { get; set; } = 0;
     private IReadOnlyCollection<ChildResponse> Children => StateService.ParentState.Children ?? Array.Empty<ChildResponse>();
     private IReadOnlyList<InstituteResponse> Institutes => StateService.InstituteState.Institutes ?? Array.Empty<InstituteResponse>();

     private IEnumerable<CourseResponseDetailed> Courses = Array.Empty<CourseResponseDetailed>();
     private UserInformationResponse userInfo => StateService.ParentState.Profile;

     protected InstituteResponse? SelectedInstitute { get; set; }
     protected CourseResponseDetailed SelectedCourse { get; set; }
     protected IReadOnlyCollection<CourseEnrollmentGroupResponse> SelectedCourseEnrollmentGroups { get; set; } = Array.Empty<CourseEnrollmentGroupResponse>(); 
     private CourseEnrollmentGroupResponse SelectedGroup { get; set; }
     protected HashSet<CourseEnrollmentGroupResponse> SelectedGroups { get; set; } = new();
     private IReadOnlyCollection<AddStudentCourseEnrollment> _StudentCourseEnrollments = Array.Empty<AddStudentCourseEnrollment>();

     private bool HasChildConsent = false;
     private bool HasCourseConsent = false;
     protected bool IsActive { get; set; } = true;
     protected bool IsSaving { get; set; }

     protected bool IsLoadingData = false;
     protected bool isInitialized = false;

     protected bool IsSuccess = false;
     protected bool IsError = false;

     protected override void OnInitialized()
     {
          base.OnInitialized();
          StateService.ParentState.OnChange += HandleStateChange;
          StateService.InstituteState.OnChange += HandleStateChange;
     }

     protected virtual void HandleStateChange()
     {
          RequestRender();
     }

     protected override void OnDispose()
     {
          StateService.ParentState.OnChange -= HandleStateChange;
          StateService.InstituteState.OnChange -= HandleStateChange;
          base.OnDispose();
     }

     protected override async Task OnInitializedAsync()
     {

          await base.OnInitializedAsync();

          var userId = await SessionService.GetLoggedInUserIdAsync();

          await LoadData(userId, true);

          isInitialized = true;
     }

     protected async Task LoadData(Guid userId, bool forceLoad = false)
     {
          IsLoadingData = true;

          await StateService.LoadUserProfileData(UserService, userId, forceLoad);
          await StateService.LoadChildrenData(ChildrenService, userInfo.FamilyId, forceLoad);
          await StateService.LoadActiveInstitutesData(InstitutionService, forceLoad);
          await StateService.LoadActiveCoursesData(CourseService, forceLoad);
          await StateService.LoadCourseEnrollments(CourseEnrollmentService, userInfo.FamilyId, forceLoad);

          IsLoadingData = false;
     }

     protected void Reset()
     {
          ActiveStep = 0;
          SelectedChild = null;
          SelectedCourse = null;
          SelectedGroups.Clear();
          IsSuccess = false;
          IsError = false;
     }

     protected async Task SubmitEnrollment()
     {
          try
          {
               IsSaving = true;
               RequestRender();
               await InvokeUserAction(RequestEnrollment);
          }
          finally
          {
               IsSaving = false;
               RequestRender();
          }
     }

     protected async Task RequestEnrollment()
     {
          if (SelectedCourse.CanSelectMultipleEnrollmentGroups)
          {
               if (SelectedGroups?.Any() != true)
               {
                    await DialogService.ShowMessageBox(
                   L[MaktabResources.Warning],
                   L[MaktabResources.Msg_Error_Not_All_Child_Valid_Group],
                   L[MaktabResources.OK]);
                    return;
               }
          }
          else
          {
               if (SelectedGroups == null)
               {
                    await DialogService.ShowMessageBox(
                         L[MaktabResources.Warning],
                         L[MaktabResources.Msg_Error_Not_All_Child_Valid_Group],
                         L[MaktabResources.OK]);
                    return;
               }
          }

          if (_StudentCourseEnrollments?.Any() == true)
          {
               try
               {
                    //Add enrollments.
                    var items = await CourseEnrollmentService.AddCourseEnrollmentsAsync(_StudentCourseEnrollments);
                    if (items?.Any() == true)
                    {
                         await StateService.LoadCourseEnrollments(CourseEnrollmentService, userInfo.FamilyId, true);
                         Snackbar.Add(L[MaktabResources.Msg_Success_Add_Enrollment], Severity.Success);

                         await OnCompletedClickedHandler();
                         IsSuccess = true;
                    }
                    else
                    {
                         IsError = true;
                         Snackbar.Add(L[MaktabResources.Msg_Error_Enrollment_Not_Added], Severity.Error);
                    }
               }
               catch (Exception ex)
               {
                    IsError = true;
                    Snackbar.Add(L[MaktabResources.Msg_Error_Enrollment_Not_Added], Severity.Error);
                    throw;
               }
          }
     }

     private void UpdateCoursesForInstitute()
     {
          if (SelectedCourse != null)
          {
               SelectedCourse = null;
               HasChildConsent =
               HasCourseConsent = false;
               SelectedCourseEnrollmentGroups = Array.Empty<CourseEnrollmentGroupResponse>();
          }

          if (SelectedInstitute != null)
          {
              var coursesWithRegistrationOpen = StateService.InstituteState.GetCoursesByInstituteId(SelectedInstitute.InstituteId);
               Courses = coursesWithRegistrationOpen.Where(c => c.IsRegistrationOpened).ToList();
          }

          if (Courses?.Any() == true)
          {
               var filteredCourse = new List<CourseResponseDetailed>();
               foreach (var course in Courses)
               {
                    if (course.CanSelectMultipleEnrollmentGroups == false)
                    {
                         var activeStudentCourseEnrollments = GetActiveStudentCourseEnrollments(
                                        StateService.ParentState.CourseEnrollments,
                                        course.CourseId,
                                        SelectedChild.ChildId);

                         if (activeStudentCourseEnrollments?.Any() != true)
                         {
                              filteredCourse.Add(course);
                         }
                    }
                    else
                    {
                         filteredCourse.Add(course);
                    }
               }

               Courses = filteredCourse;
          }
     }

     private void UpdateCourseGroupsForCourse()
     {
          if (SelectedGroup != null)
          {
               SelectedGroup = null;
          }

          if (SelectedGroups?.Any() == true)
          {
               SelectedGroups.Clear();
          }

          if (SelectedCourse != null)
          {
               var courseGroupsWithRegistrationOpen = SelectedCourse.CourseEnrollmentGroups.Where(c => c.IfRegistrationOpen).ToList();
               if (SelectedCourse.CanSelectMultipleEnrollmentGroups)
               {
                    var studentCourseGroupEnrollments = GetActiveStudentCourseEnrollments(StateService.ParentState.CourseEnrollments, SelectedCourse.CourseId, SelectedChild.ChildId);
                    if (studentCourseGroupEnrollments?.Any() == true)
                    {
                         foreach (var enrollment in studentCourseGroupEnrollments)
                         {
                              var group = courseGroupsWithRegistrationOpen.FirstOrDefault(g => g.CourseEnrollmentGroupId == enrollment.CourseEnrollmentGroupId);
                              if (group != null)
                              {
                                   courseGroupsWithRegistrationOpen.Remove(group);
                              }
                         }
                    }
               }

               SelectedCourseEnrollmentGroups = courseGroupsWithRegistrationOpen;
          }
          else
          {
               SelectedCourseEnrollmentGroups = Array.Empty<CourseEnrollmentGroupResponse>();
          }
     }


     private void UpdateSelectedGroupsForChild()
     {
          bool isSelectedGroupsAreValidForChild = true;

          if (SelectedCourse.CanSelectMultipleEnrollmentGroups)
          {
               foreach (var group in SelectedGroups)
               {
                    if (!IsChildEligibleForCourseGroup(SelectedChild, group))
                    {
                         isSelectedGroupsAreValidForChild = false;
                         break;
                    }
               }
          }
          else
          {
               if (SelectedGroup != null && !IsChildEligibleForCourseGroup(SelectedChild, SelectedGroup))
               {
                    isSelectedGroupsAreValidForChild = false;
               }
          }

          if(!isSelectedGroupsAreValidForChild)
          {
               DialogService.ShowMessageBox(
                    L[MaktabResources.Error],
                    L[MaktabResources.Msg_Error_Child_Age_Invalid_Group_Assigned],
                    L[MaktabResources.OK]);
          }
          else
          {
               UpdateCourseEnrollments(); 
               ActiveStep = 4;

          }

     }

     private bool IsChildEligibleForCourseGroup(ChildResponse child, CourseEnrollmentGroupResponse group)
     {
          if (group == null || child == null)
          {
               return false;
          }
          bool isEligible = group.IfRegistrationOpen;

          // Check age restrictions if they exist
          if(CourseGroupHasValidAgeRestriction(group))
          {
               var childAge = child.DateOfBirth.GetAge();
               isEligible = isEligible && (childAge >= group.MinAge.MonthToYearsAdjustedMidPoint() &&
                                           childAge <= group.MaxAge.MonthToYearsAdjustedMidPoint());
          }    

          return isEligible;
     }

     private void UpdateCourseEnrollments()
     {
          _StudentCourseEnrollments = GenerateCourseEnrollments();
     }

     private IReadOnlyCollection<AddStudentCourseEnrollment> GenerateCourseEnrollments()
     {
          List<AddStudentCourseEnrollment> addEnrollments = new();
          if (SelectedCourse.CanSelectMultipleEnrollmentGroups)
          {
               foreach (var enrollmentgroup in SelectedGroups)
               {
                    var studentEnrollment = new AddStudentCourseEnrollment()
                         {
                              ChildId = SelectedChild.ChildId,
                              FamilyId = userInfo.FamilyId,
                              CourseId = SelectedCourse.CourseId,
                              CourseEnrollmentGroupId = enrollmentgroup.CourseEnrollmentGroupId,
                         };

                    if (CanUseDayCare(enrollmentgroup))
                    {
                         studentEnrollment.WillUseDayCare = false;
                         studentEnrollment.DayCareDays = 5;
                    }

                    addEnrollments.Add(studentEnrollment);
               }
          }
          else
          {
               var studentEnrollment = new AddStudentCourseEnrollment()
                    {
                         ChildId = SelectedChild.ChildId,
                         FamilyId = userInfo.FamilyId,
                         CourseId = SelectedCourse.CourseId,
                         CourseEnrollmentGroupId = SelectedGroup.CourseEnrollmentGroupId,
                    };

               if (CanUseDayCare(SelectedGroup))
               {
                    studentEnrollment.WillUseDayCare = false;
                    studentEnrollment.DayCareDays = 5;
               }

               addEnrollments.Add(studentEnrollment);
          }

          return addEnrollments;
     }

     private AddStudentCourseEnrollment? GetStudentEnrollmentFromEnrollmentGroup(Guid groupEnrollmentId)
     {
          if (_StudentCourseEnrollments?.Any() == true)
          {
               var courseEnrollment = _StudentCourseEnrollments.FirstOrDefault(x => x.CourseEnrollmentGroupId == groupEnrollmentId);
               return courseEnrollment;
          }

          return null;
     }

     private async Task OnPreviewInteraction(StepperInteractionEventArgs arg)
     {
          if (arg.Action == StepAction.Complete)
          {
               // occurrs when clicking next
               if (arg.StepIndex == 2)
               {
                    UpdateCourseEnrollments();
               }
          }
          else if (arg.Action == StepAction.Activate)
          {
               // occurrs when clicking a step header with the mouse
          }
     }

     private async Task OnCompletedClickedHandler()
     {
          if (OnCompleted.HasDelegate)
          {
               await OnCompleted.InvokeAsync();
          }
     }

     /// <summary>
     /// Get CSS class for group card based on selection state
     /// </summary>
     private string GetGroupCardClass(bool isSelected)
     {
          if (isSelected)
          {
               return "pa-4 mud-border-success-3 border-2";
          }
          return "pa-4 mud-border-paper-1 border-1 hover:mud-elevation-8";
     }

     /// <summary>
     /// Toggle group selection for multi-select mode
     /// </summary>
     private void ToggleGroupSelection(CourseEnrollmentGroupResponse group)
     {
          if (SelectedGroups.Contains(group))
          {
               SelectedGroups.Remove(group);
          }
          else
          {
               SelectedGroups.Add(group);
          }
          StateHasChanged();
     }

     /// <summary>
     /// Select a single group for single-select mode
     /// </summary>
     private void SelectSingleGroup(CourseEnrollmentGroupResponse group)
     {
          SelectedGroup = group;
          SelectedGroups.Clear();
          SelectedGroups.Add(group);
          StateHasChanged();
     }

     /// <summary>
     /// Check if any groups are selected
     /// </summary>
     private bool HasGroupsSelected()
     {
          if (SelectedCourse?.CanSelectMultipleEnrollmentGroups == true)
          {
               return SelectedGroups.Any();
          }
          else
          {
               return SelectedGroup != null;
          }
     }

     private bool CanUseDayCare(CourseEnrollmentGroupResponse group)
     {
          if (group == null) return false;

          return this.SelectedCourse?.OfferDaycare == true;
     }

     protected Color GetCourseGroupRegistrationStatusColor(bool isRegistrationOpen)
     {
          switch (isRegistrationOpen)
          {
               case true:
                    return Color.Success;
               default:
                    return Color.Warning;
          }
     }

     protected bool CourseGroupHasValidAgeRestriction(CourseEnrollmentGroupResponse group)
     {
          if (group == null) return false;
          return group.MinAge > 0 || group.MaxAge > 0;
     }

     protected string GetCourseGroupRegistrationStatusLabel(bool isRegistrationOpen)
     {
          switch (isRegistrationOpen)
          {
               case true:
                    return L[MaktabResources.Open];
               default:
                    return L[MaktabResources.CourseGroup_Registration_Awaiting];
          }
     }

     protected bool HasRegistrationClosedForAnyCourseGroup()
     {
          if (SelectedCourse.CanSelectMultipleEnrollmentGroups)
          {
               return SelectedGroups?.Any(x => x.IfRegistrationOpen == false) == true;
          }
          else
          {
               return SelectedGroup?.IfRegistrationOpen == false;
          }
     }

     protected CourseEnrollmentGroupResponse GetCourseGroupNameFromId(AddStudentCourseEnrollment courseEnrollment)
     {
          if (SelectedCourse.CanSelectMultipleEnrollmentGroups)
          {
               var group = SelectedGroups.FirstOrDefault(x => x.CourseEnrollmentGroupId == courseEnrollment.CourseEnrollmentGroupId);
               return group;
          }
          else
          {
               var group = SelectedGroup;
               return group;
          }
     }

     private string GetMultiSelectionText(IReadOnlyList<string> selectedValues)
     {
          if (selectedValues == null || !selectedValues.Any())
          {
               return L[MaktabResources.Selected_Values_None_Text, "0 " + MaktabResources.Group];
          }

          if (selectedValues.Count == 1)
          {
               return L[MaktabResources.Selected_Values_Single_Text, selectedValues.Count + " " + MaktabResources.Group];
          }

          return L[MaktabResources.Selected_Values_Multiple_Text, selectedValues.Count + " " + MaktabResources.Groups];
     }

     private static IEnumerable<StudentCourseEnrollmentResponse> GetActiveStudentCourseEnrollments(IReadOnlyCollection<StudentCourseEnrollmentResponse> enrollments, Guid courseId, Guid studentId)
     {
          var activeStudentCourseEnrollments = enrollments?
               .Where(e =>
               e.CourseId == courseId &&
               e.ChildId == studentId &&
               (e.EnrollmentStatus == MaktabDataContracts.Enums.EnrollmentStatus.Registered ||
                    e.EnrollmentStatus == MaktabDataContracts.Enums.EnrollmentStatus.Enrolled ||
                    e.EnrollmentStatus == MaktabDataContracts.Enums.EnrollmentStatus.Awaiting));

          return activeStudentCourseEnrollments ?? Array.Empty<StudentCourseEnrollmentResponse>();
     }
}
