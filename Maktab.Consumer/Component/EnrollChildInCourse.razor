@using Maktab.Consumer.State
@using Maktab.Consumer.Extensions
@using MaktabDataContracts.Requests.Course
@using MaktabDataContracts.Responses.Children
@using MaktabDataContracts.Responses.Course
@using MaktabDataContracts.Responses.Institute
@using MaktabDataContracts.Responses.Users
@using Maktab.Core.Extensions;
@using Maktab.Domain.Extensions;

@inherits LocalizeableBaseComponent<EnrollChildInCourse>

@inject IChildrenService ChildrenService
@inject ICourseService CourseService
@inject IInstitutionService InstitutionService
@inject IUserService UserService
@inject ICourseEnrollmentService CourseEnrollmentService
@inject UserStateService StateService
@inject IDialogService DialogService 

<MudContainer MaxWidth="MaxWidth.Small" Class="py-8">

<!-- Success Screen -->
@if (@IsSuccess)
{
     <MudPaper Class="pa-8 text-center" Elevation="1">
          <MudStack Spacing="4" AlignItems="AlignItems.Center">
               <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                        Color="Color.Success" Size="Size.Large" />

               <MudText Typo="Typo.h5" GutterBottom="false">
                    @L[MaktabResources.Enrollment_Successful]
               </MudText>
                    
               <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @L[MaktabResources.Msg_Success_Child_Enrolled_Course_Variable, @SelectedChild?.FirstName, @SelectedCourse?.Name]
               </MudText>

               <MudStack Row="true" Spacing="2" Class="mt-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                               StartIcon="@Icons.Material.Filled.AddCircle"
                               OnClick="Reset">
                         @L[MaktabResources.Enroll_Another]
                    </MudButton>

                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Close"
                               OnClick="OnCompletedClickedHandler">
                         @L[MaktabResources.Close]
                    </MudButton>
               </MudStack>
          </MudStack>
     </MudPaper>

}
else if (IsError)
{
     <MudPaper Class="pa-8 text-center" Elevation="1">
          <MudStack Spacing="4" AlignItems="AlignItems.Center">
               <MudIcon Icon="@Icons.Material.Filled.ErrorOutline"
                        Color="Color.Error" Size="Size.Large" />

               <MudText Typo="Typo.h5" GutterBottom="false">
                    @L[MaktabResources.Enrollment_Failed]
               </MudText>

               <MudAlert Severity="Severity.Error" Elevation="0" Dense="true">
                    @L[MaktabResources.Msg_Error_Enrollment_Not_Added]
               </MudAlert>

               <MudButton Variant="Variant.Filled" Color="Color.Primary"
                          StartIcon="@Icons.Material.Filled.Close"
                          OnClick="OnCompletedClickedHandler"
                          FullWidth="true">
                    @L[MaktabResources.Close]
               </MudButton>
          </MudStack>
     </MudPaper>

}
     else
     {
          <!-- Loading Overlay -->
          <LoadingOverlay IsLoading="@IsLoadingData" />

          @if (isInitialized && !IsLoadingData)
          {
               <!-- Stepper -->
               <MudStepper @bind-ActiveIndex="ActiveStep"
                           Elevation="0"
                           Rounded="Rounded.Small"
                           OnPreviewInteraction="OnPreviewInteraction"
                           Class="mb-8">

                    <MudStep Label=@L[MaktabResources.Child] Icon="@Icons.Material.Filled.Person" />
                    <MudStep Label=@L[MaktabResources.School] Icon="@Icons.Material.Filled.MenuBook" Disabled="@(SelectedChild is null)" />
                    <MudStep Label=@L[MaktabResources.Course] Icon="@Icons.Material.Filled.MenuBook" Disabled="@(SelectedInstitute is null)" />
                    <MudStep Label=@L[MaktabResources.Groups] Icon="@Icons.Material.Filled.Groups" Disabled="@(SelectedCourse is null)" />
                    <MudStep Label=@L[MaktabResources.Acknowledgement] Icon="@Icons.Material.Filled.HealthAndSafety" Disabled="@(!HasGroupsSelected())" />
                    <MudStep Label=@L[MaktabResources.Review] Icon="@Icons.Material.Filled.CheckCircle" Disabled="@(!(HasChildConsent && HasCourseConsent))" />

               </MudStepper>

               <!-- STEP CONTENT -->
               @if (ActiveStep == 0)
               {
                    <!-- STEP 1: Choose Child -->
                    <MudPaper Class="pa-6" Elevation="0" Outlined="true">
                         <MudText Typo="Typo.h6" Class="mb-4" GutterBottom="true">
                              @L[MaktabResources.Select_Child]
                         </MudText>

                         @if (Children == null)
                         {
                              <MudStack Spacing="2">
                                   <MudSkeleton Height="56px" Width="100%" />
                                   <MudSkeleton Height="56px" Width="100%" />
                              </MudStack>
                         }
                         else
                         {
                              <MudSelect T="ChildResponse"
                                         @bind-Value="SelectedChild"
                                         Label=@L[MaktabResources.Children]
                                         Dense="false"
                                         Clearable="true"
                                         AnchorOrigin="Origin.BottomCenter"
                                         TransformOrigin="Origin.TopCenter">

                                   @foreach (var child in Children)
                                   {
                                        <MudSelectItem @key="child.ChildId" Value="@child">
                                             <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                                  <MudIcon Icon="@Icons.Material.Filled.PersonOutline" Size="Size.Small" />
                                                  <span>@child.FirstName @child.LastName</span>
                                                  <MudSpacer/>
                                                  <MudChip T="String" Color="Color.Info" Variant="Variant.Text" Size="Size.Small">@L[MaktabResources.Age]: @child.DateOfBirth.GetAge() </MudChip>

                                             </MudStack>
                                        </MudSelectItem>
                                   }
                              </MudSelect>

                              <MudStack Row="true" Spacing="2" Class="mt-6" Justify="Justify.FlexEnd">
                                   <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                              Disabled="@(SelectedChild is null)"
                                              OnClick="@(()=> ActiveStep = 1)"
                                              StartIcon="@Icons.Material.Filled.NavigateNext">
                                        @L[MaktabResources.Next]
                                   </MudButton>
                              </MudStack>
                         }
                    </MudPaper>
               }
               else if (ActiveStep == 1)
               {
                    <!-- STEP 2: Choose Institute -->
                    <MudPaper Class="pa-6" Elevation="0" Outlined="true">
                         <MudText Typo="Typo.h6" Class="mb-4" GutterBottom="true">
                              @L[MaktabResources.Select_School]
                         </MudText>

                         @if (Institutes == null)
                         {
                              <MudStack Spacing="2">
                                   <MudSkeleton Height="56px" Width="100%" />
                                   <MudSkeleton Height="56px" Width="100%" />
                              </MudStack>
                         }
                         else
                         {
                              <MudSelect T="InstituteResponse"
                                         @bind-Value="SelectedInstitute"
                                         Label=@L[MaktabResources.School]
                                         Dense="false"
                                         Clearable="true"
                                         AnchorOrigin="Origin.BottomCenter"
                                         TransformOrigin="Origin.TopCenter">

                                   @foreach (var c in Institutes)
                                   {
                                        <MudSelectItem @key="c.InstituteId" Value="@c">
                                             <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                                  <MudIcon Icon="@Icons.Material.Filled.School" Size="Size.Small" />
                                                  <span>@(GetInstituteName(c))</span>
                                             </MudStack>
                                        </MudSelectItem>
                                   }
                              </MudSelect>

                              @if (SelectedInstitute != null)
                              {
                                   <MudAlert Severity="Severity.Info" Elevation="0" Dense="true" Class="mt-4">
                                        @(GetInstituteDescription(SelectedInstitute))
                                   </MudAlert>
                              }

                              <MudStack Row="true" Spacing="2" Class="mt-6" Justify="Justify.FlexEnd">
                                   <MudButton Variant="Variant.Outlined" Color="Color.Default"
                                              OnClick="@(()=> ActiveStep = 0)"
                                              StartIcon="@Icons.Material.Filled.NavigateBefore">
                                        @L[MaktabResources.Back]
                                   </MudButton>
                                   <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                              Disabled="@(SelectedInstitute is null)"
                                              OnClick="@(()=>{ UpdateCoursesForInstitute(); ActiveStep = 2;})"
                                              StartIcon="@Icons.Material.Filled.NavigateNext">
                                        @L[MaktabResources.Next]
                                   </MudButton>
                              </MudStack>
                         }
                    </MudPaper>
               }

               else if (ActiveStep == 2)
               {
                    <!-- STEP 2: Choose Course -->
                    <MudPaper Class="pa-6" Elevation="0" Outlined="true">
                         <MudText Typo="Typo.h6" Class="mb-4" GutterBottom="true">
                              @L[MaktabResources.Select_Course]
                         </MudText>

                         @if (Courses == null)
                         {
                              <MudStack Spacing="2">
                                   <MudSkeleton Height="56px" Width="100%" />
                                   <MudSkeleton Height="56px" Width="100%" />
                              </MudStack>
                         }
                         else
                         {
                              @if (!Courses.Any())
                              {
                                   <MudAlert Severity="Severity.Warning" Elevation="0" Dense="true">
                                        @L[MaktabResources.Msg_Info_No_Active_Courses_Found_For_Institute]
                                   </MudAlert>
                              }
                              else
                              {
                              <MudSelect T="CourseResponseDetailed"
                                         @bind-Value="SelectedCourse"
                                         Label=@L[MaktabResources.Course]
                                         Dense="false"
                                         Clearable="true"
                                         AnchorOrigin="Origin.BottomCenter"
                                         TransformOrigin="Origin.TopCenter">

                                   @foreach (var c in Courses)
                                   {
                                             <MudSelectItem @key="c.CourseId" Value="@c">
                                             <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                                  <MudIcon Icon="@Icons.Material.Filled.MenuBook" Size="Size.Small" />
                                                  <span>@(GetCourseName(c))</span>
                                             </MudStack>
                                        </MudSelectItem>
                                   }
                              </MudSelect>

                              @if (SelectedCourse != null)
                              {
                                   <MudAlert Severity="Severity.Info" Elevation="0" Dense="true" Class="mt-4">
                                        <MudStack Row="true">
                                        <MudText Typo="Typo.body2">
                                             @(GetCourseDescription(SelectedCourse))
                                        </MudText>
                                             <MudText Typo="Typo.body2">
                                                  <span>@L[MaktabResources.Registration_Fee]</span>: <span>@(SelectedCourse?.RegistrationFee)</span>
                                             </MudText>
                                        </MudStack>
                                   </MudAlert>
                              }
                              }

                              <MudStack Row="true" Spacing="2" Class="mt-6" Justify="Justify.FlexEnd">
                                   <MudButton Variant="Variant.Outlined" Color="Color.Default"
                                              OnClick="@(()=> ActiveStep = 1)"
                                              StartIcon="@Icons.Material.Filled.NavigateBefore">
                                        @L[MaktabResources.Back]
                                   </MudButton>
                                   <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                              Disabled="@(SelectedCourse is null)"
                                              OnClick="@(()=> { UpdateCourseGroupsForCourse(); ActiveStep = 3;})"
                                              StartIcon="@Icons.Material.Filled.NavigateNext">
                                        @L[MaktabResources.Next]
                                   </MudButton>
                              </MudStack>
                         }
                    </MudPaper>
               }

               else if (ActiveStep == 3)
               {
                    <!-- STEP 3: Choose Groups as List/Cards -->
                    <MudPaper Class="pa-6" Elevation="0" Outlined="true">
                         <MudText Typo="Typo.h6" Class="mb-4" GutterBottom="true">
                              @L[MaktabResources.Select_Enrollment_Group]
                         </MudText>

                         @if (SelectedCourse?.CourseEnrollmentGroups is null || !SelectedCourse.CourseEnrollmentGroups.Any())
                         {
                              <MudAlert Severity="Severity.Warning" Elevation="0" Dense="true">
                                   @L[MaktabResources.Msg_Info_No_Course_Groups_Found]
                              </MudAlert>
                         }
                         else
                         {
                              @if (SelectedCourse?.CanSelectMultipleEnrollmentGroups == true)
                              {
                                   <!-- MULTI-SELECT: Checkbox cards -->
                                   <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
                                        @L[MaktabResources.Msg_Info_Select_One_More_Enrollment_Group]
                                   </MudText>

                                   <MudGrid Class="mt-4" Spacing="2">
                                        <MudSelect T="CourseEnrollmentGroupResponse"
                                        SelectAll="true"
                                        MultiSelectionTextFunc="@(new Func<IReadOnlyList<string>, string>(GetMultiSelectionText))"
                                                   MultiSelection="true"
                                                   SelectedValues="@SelectedGroups"
                                                   SelectedValuesChanged="@((IEnumerable<CourseEnrollmentGroupResponse> v) => SelectedGroups = v.ToHashSet() )"
                                                   Label=@L[MaktabResources.Groups]
                                                   AnchorOrigin="Origin.BottomCenter"
                                                   TransformOrigin="Origin.TopCenter"
                                                   Dense="true">

                                             @foreach (var g in SelectedCourseEnrollmentGroups)
                                             {
                                                  <MudSelectItem @key="g.CourseEnrollmentGroupId" Value="@g">
                                                       <MudStack Row="true" AlignItems="AlignItems.Center">
                                                            <MudIcon Icon="@Icons.Material.Filled.Groups" />
                                                            <strong>@(GetCourseGroupTitle(g))</strong>

                                                            @* <MudText Typo="Typo.caption" Class="ml-2">Fee: </MudText> *@
                                                            @* <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Class="mr-2" />*@
                                                            <MudText Typo="Typo.caption" Class="ml-2">
                                                                 @* (@g.StartTime - @g.EndTime) *@
                                                                 @g.Fee
                                                            </MudText>
                                                            @* <MudIcon Icon="@Icons.Material.Filled.ChildCare" Class="mr-2" />
                                              @* <MudText Typo="Typo.caption" Class="ml-2"> Day care Fee: </MudText> *@
                                                            @* <MudText Typo="Typo.caption" Class="ml-2"> *@
                                                            @* (@g.StartTime - @g.EndTime) *@
                                                            @* @g.DayCareFee
                                             </MudText> *@
                                                            <MudChip T="bool" Color="@(GetCourseGroupRegistrationStatusColor(g.IfRegistrationOpen))" Variant="Variant.Filled" Size="Size.Small">@(GetCourseGroupRegistrationStatusLabel(g.IfRegistrationOpen))</MudChip>

                                                            @if (CourseGroupHasValidAgeRestriction(g))
                                                            {
                                                                 <MudChip T="String" Color="Color.Info" Variant="Variant.Text" Size="Size.Small">@L[MaktabResources.Age]: @g.MinAge.MonthToYearsAdjustedMidPoint() - @g.MaxAge.MonthToYearsAdjustedMidPoint()</MudChip>
                                                            }
                                                            <MudChipSet T="CourseEnrollmentGroupResponse" ReadOnly="true">
                                                                 @foreach (var chipSet in g.AcedemicGroups)
                                                                 {
                                                                      <MudChip T="String" Text="@chipSet" Size="Size.Small" />
                                                                 }
                                                            </MudChipSet>
                                                       </MudStack>
                                                  </MudSelectItem>
                                             }
                                        </MudSelect>

                                        <MudStack Row Justify="Justify.Center" Style="width: 100%" Wrap="Wrap.Wrap">
                                             <MudChipSet T="CourseEnrollmentGroupResponse" ReadOnly="true" SelectionMode="SelectionMode.MultiSelection" Variant="Variant.Filled">
                                                  @foreach (var group in SelectedGroups)
                                                  {
                                                       <MudChip T="CourseEnrollmentGroupResponse" Text="@(GetCourseGroupTitle(group))" Value="@group" Size="Size.Small" />
                                                  }
                                             </MudChipSet>
                                        </MudStack>
                                   </MudGrid>
                              }
                              else
                              {
                                   <!-- SINGLE-SELECT: Radio button cards -->
                                   <MudList Class="mt-4" Spacing="2" T="CourseEnrollmentGroupResponse" @bind-SelectedValue="SelectedGroup" SelectionMode="SelectionMode.SingleSelection">
                                            
                                             @foreach (var g in SelectedCourseEnrollmentGroups)
                                             {
                                                  <MudListItem Value="@g">
                                                  <MudStack Row="true" AlignItems="AlignItems.Baseline" StretchItems="StretchItems.StartAndEnd">
                                                            <MudIcon Icon="@Icons.Material.Filled.Groups" />
                                                       @if (SelectedGroup?.CourseEnrollmentGroupId == g.CourseEnrollmentGroupId)
                                                       {
                                                            <strong>@(GetCourseGroupTitle(g))</strong>
                                                       }
                                                       else
                                                       {
                                                            @(GetCourseGroupTitle(g))
                                                       }

                                                            <MudText Typo="Typo.caption" Class="ml-2">
                                                                 @g.Fee
                                                            </MudText>

                                                       
                                                       <MudChip T="bool" Color="@(GetCourseGroupRegistrationStatusColor(g.IfRegistrationOpen))" Variant="Variant.Filled" Size="Size.Small">@(GetCourseGroupRegistrationStatusLabel(g.IfRegistrationOpen))</MudChip>

                                                       @if (CourseGroupHasValidAgeRestriction(g))
                                                       {
                                                            <MudChip T="String" Color="Color.Info" Variant="Variant.Text" Size="Size.Small">@L[MaktabResources.Age]: @g.MinAge.MonthToYearsAdjustedMidPoint() - @g.MaxAge.MonthToYearsAdjustedMidPoint()</MudChip>
                                                       }

                                                       <MudChipSet T="CourseEnrollmentGroupResponse" ReadOnly="true">
                                                                 @foreach (var chipSet in g.AcedemicGroups)
                                                                 {
                                                                      <MudChip T="String" Text="@chipSet" Size="Size.Small" />
                                                                 }
                                                            </MudChipSet>
                                                       </MudStack>
                                                  </MudListItem>
                                             }
                                        </MudList>
                              }

                              <MudStack Row="true" Spacing="2" Class="mt-6" Justify="Justify.FlexEnd">
                                   <MudButton Variant="Variant.Outlined" Color="Color.Default"
                                              OnClick="@(()=> ActiveStep = 2)"
                                              StartIcon="@Icons.Material.Filled.NavigateBefore">
                                        @L[MaktabResources.Back]
                                   </MudButton>
                                   <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                              Disabled="@(!HasGroupsSelected())"
                                              OnClick="@(()=>{ UpdateSelectedGroupsForChild();})"
                                              StartIcon="@Icons.Material.Filled.NavigateNext">
                                        @L[MaktabResources.Next]
                                   </MudButton>
                              </MudStack>
                         }
                    </MudPaper>
               }
               else if (ActiveStep == 4)
               {
                    <!-- STEP 4: Acknowledge consent -->
                    <MudPaper Class="pa-6" Elevation="0" Outlined="true">
                         <MudText Typo="Typo.h6" Class="mb-4" GutterBottom="true">
                              @L[MaktabResources.Acknowledgement]
                         </MudText>
                         
                         <MudStack Spacing="2">
                              <MudCheckBox @bind-Value="HasChildConsent">
                                   @L[MaktabResources.Msg_Acknowledge_Child_Consent_Completion]
                              </MudCheckBox>

                              <MudCheckBox @bind-Value="HasCourseConsent">
                                   <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                        <span>@L[MaktabResources.Msg_Acknowledge_Read_Course_Policy]</span>
                                        <MudLink Href="@SelectedCourse.PolicyHyperLink" Color="Color.Info" Target="_blank">[@L[MaktabResources.Policy]]</MudLink>
                                   </MudStack>
                              </MudCheckBox>

                         </MudStack>

                         <MudStack Row="true" Spacing="2" Class="mt-6" Justify="Justify.FlexEnd">
                              <MudButton Variant="Variant.Outlined" Color="Color.Default"
                                         OnClick="@(()=> ActiveStep = 3)"
                                         StartIcon="@Icons.Material.Filled.NavigateBefore">
                                   @L[MaktabResources.Back]
                              </MudButton>
                              <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                         Disabled="@(!(HasChildConsent && HasCourseConsent))"
                                         OnClick="@(()=>  ActiveStep = 5)"
                                         StartIcon="@Icons.Material.Filled.NavigateNext">
                                   @L[MaktabResources.Next]
                              </MudButton>
                         </MudStack>
                    </MudPaper>
               }

               else if (ActiveStep == 5)
               {
                    <!-- STEP 4: Review -->
                    <MudPaper Class="pa-6" Elevation="0" Outlined="true">
                         <MudText Typo="Typo.h6" Class="mb-6" GutterBottom="true">
                              @L[MaktabResources.Review_Enrollment]
                         </MudText>

                         <MudStack Spacing="3">
                              <!-- Child Info -->
                              <MudPaper Class="pa-4" Elevation="0" Outlined="true">
                                   <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                        <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Primary" />
                                        <MudText Typo="Typo.body2" Color="Color.Primary">
                                             <strong>@L[MaktabResources.Child]</strong>
                                        </MudText>
                                        <MudSpacer />
                                        <MudText Typo="Typo.body2">
                                             @SelectedChild.FirstName @SelectedChild.LastName
                                        </MudText>
                                   </MudStack>
                              </MudPaper>

                              <!-- Institute Info -->
                              <MudPaper Class="pa-4" Elevation="0" Outlined="true">
                                   <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                        <MudIcon Icon="@Icons.Material.Filled.School" Color="Color.Primary" />
                                        <MudText Typo="Typo.body2" Color="Color.Primary">
                                             <strong>@L[MaktabResources.School]</strong>
                                        </MudText>
                                        <MudSpacer />
                                        <MudStack Spacing="0">
                                             <MudText Typo="Typo.body2">
                                                  @(GetInstituteName(SelectedInstitute))
                                             </MudText>
                                        </MudStack>
                                   </MudStack>
                              </MudPaper>

                              <!-- Course Info -->
                              <MudPaper Class="pa-4" Elevation="0" Outlined="true">
                                   <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                        <MudIcon Icon="@Icons.Material.Filled.MenuBook" Color="Color.Primary" />
                                        <MudText Typo="Typo.body2" Color="Color.Primary">
                                             <strong>@L[MaktabResources.Course]</strong>
                                        </MudText>
                                        <MudSpacer />
                                        <MudStack Spacing="0">
                                        <MudText Typo="Typo.body2">
                                                  @(GetCourseName(SelectedCourse))
                                        </MudText>
                                             <MudText Typo="Typo.body2">
                                                  <span>@L[MaktabResources.Registration_Fee]</span>: <span>@(SelectedCourse?.RegistrationFee)</span>
                                             </MudText>
                                        </MudStack>
                                   </MudStack>
                              </MudPaper>

                              <!-- Groups Info -->
                              <MudPaper Class="pa-4" Elevation="0" Outlined="true">
                                   @* Class="pa-4" *@
                                  @*  <MudStack> *@
                                  @*  <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudIcon Icon="@Icons.Material.Filled.Groups" Color="Color.Primary" /> *@
                                       @*  <MudText Typo="Typo.body2" Color="Color.Secondary">
                                             <strong>@L[MaktabResources.Groups]</strong>
                                        </MudText> *@
                                        @* </MudStack> *@
                                       
                                        @* <MudSpacer /> *@
                                   @if (HasRegistrationClosedForAnyCourseGroup())
                                   {
                                        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="my-4">
                                             @L[MaktabResources.Msg_Info_CourseGroup_Registration_Full]
                                        </MudAlert>
                                   }

                                   <MudSimpleTable Outlined="false" Hover="false" Dense="true" Striped="true" FixedHeader="true">
                                             <thead>
                                                  <tr>
                                                       <th style="width:40%">
                                                            <MudStack Row="true">
                                                                 <MudIcon Icon="@Icons.Material.Filled.Groups" Color="Color.Primary" />
                                                                 @L[MaktabResources.Group]
                                                            </MudStack>
                                                            </th>
                                                       <th style="width:20%">@L[MaktabResources.Fee]</th>
                                                       <th style="width:20%">@L[MaktabResources.CourseGroup_Registration_Open]</th>

                                                  @if (SelectedCourse?.OfferDaycare == true)
                                                  {
                                                       <th style="width:20%">@L[MaktabResources.Daycare_Fee]</th>
                                                       <th style="width:20%">@L[MaktabResources.Use_Daycare]</th>
                                                       @* <th style="width:20%">@L[MaktabResources.Daycare]</th> *@
                                                  }

                                                   </tr>
                                             </thead>
                                             <tbody>

                                             @foreach (var g in _StudentCourseEnrollments)
                                             {
                                                  @* var e = GetStudentEnrollmentFromEnrollmentGroup(g.CourseEnrollmentGroupId) *@
                                                  <tr>
                                                       <td>@(GetCourseGroupTitle(GetCourseGroupNameFromId(g)))</td>
                                                       <td>@(GetCourseGroupNameFromId(g).Fee)</td>
                                                       <td>
                                                            <MudChip T="bool" Color="@(GetCourseGroupRegistrationStatusColor(GetCourseGroupNameFromId(g).IfRegistrationOpen))" Variant="Variant.Filled" Size="Size.Small">@(GetCourseGroupRegistrationStatusLabel(GetCourseGroupNameFromId(g).IfRegistrationOpen))</MudChip>
                                                       </td>
                                                                 
                                                       @if (SelectedCourse?.OfferDaycare == true)
                                                       {
                                                            <td>@GetCourseGroupNameFromId(g).DayCareFee</td>
                                                            <td>
                                                                 <MudSwitch T="bool"
                                                                            @bind-Value="g.WillUseDayCare"
                                                                            Color="Color.Primary"
                                                                            Size="Size.Small" />
                                                            </td>
                                                            @* <td>
                                                                      <MudNumericField  Variant="Variant.Text" Min="1" Max="5" 
                                                                                       @bind-Value="@(GetStudentEnrollmentFromEnrollmentGroup(g.CourseEnrollmentGroupId).DayCareDays)" />
