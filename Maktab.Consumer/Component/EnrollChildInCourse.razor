@using Maktab.Consumer.State
@using Maktab.Consumer.Extensions
@using MaktabDataContracts.Requests.Course
@using MaktabDataContracts.Responses.Children
@using MaktabDataContracts.Responses.Course
@using MaktabDataContracts.Responses.Users

@inherits BaseComponent<EnrollChildInCourse>

@inject IChildrenService ChildrenService
@inject ICourseService CourseService
@inject IUserService UserService
@inject ICourseEnrollmentService CourseEnrollmentService


@inject UserStateService StateService
@inject IDialogService DialogService 

<MudPaper Class="p-6 mx-auto max-w-3xl">

     <!-- Success Screen -->
     @if (@IsSuccess)
     {
          <MudPaper Class="p-6 text-center" Elevation="3">
               <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                        Color="Color.Success" Size="Size.Large" />

               <MudText Typo="Typo.h5" Class="mt-3">Enrollment Successful!</MudText>
               <MudText Typo="Typo.body1" Color="Color.Secondary">
                    @SelectedChild?.FirstName has been enrolled in @SelectedCourse?.Name
               </MudText>

               <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4"
                          OnClick="Reset">
                    Enroll Another
               </MudButton>

               <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4"
                          OnClick="OnCompletedClickedHandler">
                    Close
               </MudButton>
          </MudPaper>

     }
     else if (IsError)
     {
          <MudPaper Class="p-6 text-center" Elevation="3">
               <MudIcon Icon="@Icons.Material.Filled.Error"
                        Color="Color.Error" Size="Size.Large" />

               <MudText Typo="Typo.h5" Class="mt-3">Enrollment Failed!</MudText>
               @* <MudText Typo="Typo.body1" Color="Color.Secondary">
                    @SelectedChild?.FirstName has been enrolled in @SelectedCourse?.Name
               </MudText> *@

              @*  <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4"
                          OnClick="Reset">
                    Enroll Another
               </MudButton> *@

               <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4"
                          OnClick="OnCompletedClickedHandler">
                    Close
               </MudButton>
          </MudPaper>

     }
     else
     {


          <!-- Loading Overlay -->
          <LoadingOverlay IsLoading="@IsLoadingData" />

          @if (isInitialized && !IsLoadingData)
          {

          <!-- Stepper -->
          <MudStepper @bind-ActiveIndex="ActiveStep"
                      Elevation="1"
                      Rounded="Rounded.Small"
                      Class="mb-6">

               <MudStep Label="Child" Icon="@Icons.Material.Filled.Person" />
               <MudStep Label="Course" Icon="@Icons.Material.Filled.MenuBook" Disabled="@(SelectedChild is null)" />
               <MudStep Label="Groups" Icon="@Icons.Material.Filled.Groups" Disabled="@(SelectedCourse is null)" />
               <MudStep Label="Review" Icon="@Icons.Material.Filled.CheckCircle" Disabled="@(!SelectedGroups.Any())" />

          </MudStepper>

          <!-- STEP CONTENT -->
          @if (ActiveStep == 0)
          {
               <!-- STEP 1: Choose Child -->
               <MudPaper Class="p-4" Elevation="1">
                    <MudText Typo="Typo.h6">Select Child</MudText>

                    @if (Children == null)
                    {
                         <MudSkeleton Height="60px" Width="100%" Class="mb-2" />
                         <MudSkeleton Height="60px" Width="100%" />
                    }
                    else
                    {
                         <MudSelect T="ChildResponse"
                                    @bind-Value="SelectedChild"
                                    Label="Child"
                                    Dense="true"
                                    Clearable="true">

                              @foreach (var child in Children)
                              {
                                   <MudSelectItem Value="@child">
                                        <MudStack Row="true">
                                        @* <MudAvatar  Size="Size.Small" Class="mr-2"/> *@
                                        <MudIcon Icon="@Icons.Material.Filled.Person" />
                                        @child.FirstName @child.LastName
                                        </MudStack>
                                   </MudSelectItem>
                              }
                         </MudSelect>

                         <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                    Disabled="@(SelectedChild is null)"
                                    OnClick="@(()=> ActiveStep = 1)"
                                    Class="mt-4">Next</MudButton>
                    }
               </MudPaper>
          }

          else if (ActiveStep == 1)
          {
               <!-- STEP 2: Choose Course -->
               <MudPaper Class="p-4" Elevation="1">
                    <MudText Typo="Typo.h6">Select Course</MudText>

                    @if (Courses == null)
                    {
                         <MudSkeleton Height="50px" Width="100%" />
                    }
                    else
                    {
                         <MudSelect T="CourseResponseDetailed"
                                    @bind-Value="SelectedCourse"
                                    Label="Course"
                                    Dense="true"
                                    Clearable="true">

                              @foreach (var c in Courses)
                              {
                                   <MudSelectItem Value="@c">
                                        <MudIcon Icon="@Icons.Material.Filled.School" Class="mr-2" />
                                        @c.Name
                                   </MudSelectItem>
                              }
                         </MudSelect>

                         @if (SelectedCourse != null)
                         {
                              <MudPaper Class="p-3 mt-3" Elevation="1">
                                   <MudText Typo="Typo.subtitle1">@SelectedCourse.Name</MudText>
                                   <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        @SelectedCourse.Description
                                   </MudText>
                              </MudPaper>
                         }

                         <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                    Disabled="@(SelectedCourse is null)"
                                    OnClick="@(()=> ActiveStep = 2)"
                                    Class="mt-4">Next</MudButton>
                    }
               </MudPaper>
          }

          else if (ActiveStep == 2)
          {
               <!-- STEP 3: Choose Groups -->
               <MudPaper Class="p-4" Elevation="1">
                    <MudText Typo="Typo.h6">Select Enrollment Group(s)</MudText>

                    @if (SelectedCourse?.CourseEnrollmentGroups is null)
                    {
                         <MudText>No groups found for this course.</MudText>
                    }
                    else
                    {
                         if (SelectedCourse?.CanSelectMultipleEnrollmentGroups == true)
                         {
                              <MudSelect T="CourseEnrollmentGroupResponse"
                                         ToStringFunc="g => g.GroupTitle"
                                         MultiSelection="true"
                                         SelectedValues="@SelectedGroups"
                                         SelectedValuesChanged="@((IEnumerable<CourseEnrollmentGroupResponse> v) => SelectedGroups = v.ToHashSet() )"
                                         Label="Groups"
                                         Dense="true">

                                   @foreach (var g in SelectedCourse.CourseEnrollmentGroups)
                                   {
                                        <MudSelectItem Value="@g">
                                             <MudStack Row="true" AlignItems="AlignItems.Center">
                                             <MudIcon Icon="@Icons.Material.Filled.Groups" Class="mr-2" />
                                             <strong>@g.GroupTitle</strong>
                                              
                                             @* <MudText Typo="Typo.caption" Class="ml-2">Fee: </MudText> *@
                                             @* <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Class="mr-2" />*@
                                             <MudText Typo="Typo.caption" Class="ml-2"> 
                                                  @* (@g.StartTime - @g.EndTime) *@
                                                  @g.Fee
                                             </MudText>
                                             @* <MudIcon Icon="@Icons.Material.Filled.ChildCare" Class="mr-2" />
                                              @* <MudText Typo="Typo.caption" Class="ml-2"> Day care Fee: </MudText> *@
                                             @* <MudText Typo="Typo.caption" Class="ml-2"> *@
                                                  @* (@g.StartTime - @g.EndTime) *@
                                                  @* @g.DayCareFee
                                             </MudText> *@

                                              <MudChipSet  T="CourseEnrollmentGroupResponse" >
                                                  @foreach( var chipSet in g.AcedemicGroups)
                                                       {
                                                          <MudChip T="String" Text="@chipSet"/>
                                                       }
                                              </MudChipSet>
                                              </MudStack>
                                        </MudSelectItem>
                                   }
                              </MudSelect>
                         }
                         else
                         {
                              <MudSelect T="CourseEnrollmentGroupResponse"
                                         MultiSelection="false"
                                         @bind-Value="@SelectedGroup"
                                         Label="Groups"
                                         Dense="true">

                                   @foreach (var g in SelectedCourse.CourseEnrollmentGroups)
                                   {
                                        <MudSelectItem Value="@g">
                                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                             <MudIcon Icon="@Icons.Material.Filled.Groups" Class="mr-2" />
                                             <strong>@g.GroupTitle</strong>
                                              
                                             @* <MudText Typo="Typo.caption" Class="ml-2">Fee: </MudText> *@
                                             @* <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Class="mr-2" />*@
                                             <MudText Typo="Typo.caption" Class="ml-2"> 
                                                  @* (@g.StartTime - @g.EndTime) *@
                                                  @g.Fee
                                             </MudText>
                                             @* <MudIcon Icon="@Icons.Material.Filled.ChildCare" Class="mr-2" />
                                              @* <MudText Typo="Typo.caption" Class="ml-2"> Day care Fee: </MudText> *@
                                             @* <MudText Typo="Typo.caption" Class="ml-2"> *@
                                                  @* (@g.StartTime - @g.EndTime) *@
                                                  @* @g.DayCareFee
                                             </MudText> *@

                                              <MudChipSet  T="CourseEnrollmentGroupResponse" >
                                                  @foreach( var chipSet in g.AcedemicGroups)
                                                       {
                                                          <MudChip T="String" Text="@chipSet"/>
                                                       }
                                              </MudChipSet>
                                              </MudStack>
                                        </MudSelectItem>
                                   }
                              </MudSelect>
                         }

                         <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                    Disabled="@(!SelectedGroups.Any())"
                                    OnClick="@(()=> ActiveStep = 3)"
                                    Class="mt-4">Next</MudButton>
                    }
               </MudPaper>
          }

          else if (ActiveStep == 3)
          {
               <!-- STEP 4: Review -->
               <MudGrid Class="p-4" Elevation="1">
                    <MudItem xs="12">

                         <MudText Typo="Typo.h6">Review Enrollment</MudText>
                    </MudItem xs="12">


                    <MudItem>
                           <MudStack Row="true">
                                @* <MudText Typo="Typo.caption">Child</MudText> *@
                         <MudIcon Icon="@Icons.Material.Filled.Person" />
                         <MudText>@SelectedChild.FirstName @SelectedChild.LastName</MudText>
                           </MudStack>
                    </MudItem>

                    <MudItem xs="12">
                         <MudStack  Row="true">

                         <MudIcon Icon="@Icons.Material.Filled.School" />
                                @* <MudText Typo="Typo.caption">Course</MudText> *@

                         <MudText>@SelectedCourse.Name</MudText>

                         </MudStack>
                    </MudItem>

                    <MudItem xs="12">
                         <MudStack  Row="true">
                         <MudIcon Icon="@Icons.Material.Filled.Groups" />
                         <MudText>
                              @if (SelectedCourse?.CanSelectMultipleEnrollmentGroups == true)
                              {
                                   @string.Join(", ", SelectedGroups.Select(g => g.GroupTitle))
                              }
                              else
                              {
                                   @SelectedGroup?.GroupTitle
                              }
                         </MudText>
                         </MudStack>
                         </MudItem>

@*                     <MudItem xs="12">
                         <MudStack  Row="true">

                         <MudIcon Icon="@Icons.Material.Filled.AttachMoney" />

                         <MudText>
                              @if (SelectedCourse?.CanSelectMultipleEnrollmentGroups == true)
                              {
                                   @SelectedGroups.Sum(x=>x.Fee)
                                   @* @string.Join(", ", SelectedGroups.Select(g => g.GroupTitle)) *@
                            @*  }
                              else
                              {
                                   @SelectedGroup?.Fee
                              }
                         </MudText>
                         </MudStack>

                    </MudItem> *@
                    <MudItem xs="12">

                         <MudSwitch T="bool" @bind-Value="WillUseDayCare"  Color="Color.Primary" Class="mt-3">
                              Use Daycare
                         </MudSwitch>


                         @*  @if (WillUseDayCare)
                         {
                              <MudStack Row="true">
                         <MudIcon Icon="@Icons.Material.Filled.ChildCare" />
                          <MudText>
                              @if (SelectedCourse?.CanSelectMultipleEnrollmentGroups == true)
                              {
                                   @SelectedGroups.Sum(x=>x.DayCareFee) *@
                                   @* @string.Join(", ", SelectedGroups.Select(g => g.GroupTitle)) *@
                             @*  }
                              else
                              {
                                   @SelectedGroup?.DayCareFee
                              }
                         </MudText>
                              </MudStack> *@
                              @* <MudText Typo="Typo.caption">Day care fee: @Sel</MudText> *@
                              @*<MudNumericField T="int"
                                               Label="Daycare Days"
                                               @bind-Value="DayCareDays"
                                               Min="1" Max="7"
                                               Class="mt-2" />
                         } *@
                    </MudItem>
                    <MudItem xs="12">
                         <MudButton Color="Color.Success" Variant="Variant.Filled"
                                    OnClick="SubmitEnrollment"
                                    Class="mt-4">
                              Confirm Enrollment
                         </MudButton>
                    </MudItem>

               </MudGrid>
          }
          }
     }


</MudPaper>

@code {
     [Parameter] public EventCallback OnCompleted { get; set; }
     [Parameter] public ChildResponse? SelectedChild { get; set; }


     protected int ActiveStep { get; set; } = 0;
     private IReadOnlyCollection<ChildResponse> Children => StateService.ParentState.Children ?? Array.Empty<ChildResponse>();
     private IReadOnlyCollection<CourseResponseDetailed> Courses => StateService.InstituteState.Courses ?? Array.Empty<CourseResponseDetailed>();
     private UserInformationResponse userInfo => StateService.ParentState.Profile;

     protected CourseResponseDetailed? SelectedCourse { get; set; }
     private CourseEnrollmentGroupResponse SelectedGroup { get; set; }
     protected HashSet<CourseEnrollmentGroupResponse> SelectedGroups { get; set; } = new();

     protected bool WillUseDayCare { get; set; }
     protected int DayCareDays { get; set; } = 5;
     protected bool IsActive { get; set; } = true;
     protected bool IsSaving { get; set; }

     protected bool IsLoadingData = false;
     protected bool isInitialized = false;

     protected bool IsSuccess = false;
     protected bool IsError = false;

     protected override void OnInitialized()
     {
          base.OnInitialized();
          StateService.ParentState.OnChange += HandleStateChange;
          StateService.InstituteState.OnChange += HandleStateChange;
     }

     protected virtual void HandleStateChange()
     {
          RequestRender();
     }

     public void OnDispose()
     {
          StateService.ParentState.OnChange -= HandleStateChange;
          StateService.InstituteState.OnChange -= HandleStateChange;

     }


     protected override async Task OnInitializedAsync()
     {

          await base.OnInitializedAsync();

          var userId = await SessionService.GetLoggedInUserIdAsync();

          await LoadData(userId);

          isInitialized = true;
     }

     protected async Task LoadData(Guid userId, bool forceLoad = false)
     {
          IsLoadingData = true;

          await StateService.LoadUserProfileData(UserService, userId);
          await StateService.LoadChildrenData(ChildrenService, userInfo.FamilyId);
          await StateService.LoadActiveCoursesData(CourseService);

          IsLoadingData = false;


          //userInfo = await UserService.GetUserByIdAsync(userId);
          //Children = (await ChildrenService.GetChildrenByFamilyIdAsync(userInfo.FamilyId)).ToList();

          //Children = await ChildrenService.GetChildrenByFamilyIdAsync
          //Courses = (await CourseService.GetCurrentActiveCoursesAsync()).ToList();


     }

     protected void Reset()
     {
          ActiveStep = 0;
          SelectedChild = null;
          SelectedCourse = null;
          SelectedGroups.Clear();
          WillUseDayCare = false;
          DayCareDays = 0;
          IsSuccess = false;
          IsError = false;
     }

     protected async Task SubmitEnrollment()
     {
          try
          {
               IsSaving = true;
               RequestRender();
               await InvokeUserAction(RequestEnrollment);
          }
          finally
          {
               IsSaving = false;
               RequestRender();
          }

     }

     protected async Task RequestEnrollment()
     {

          List<AddStudentCourseEnrollment> addEnrollments = new();


          if (SelectedCourse.CanSelectMultipleEnrollmentGroups)
          {
               if (SelectedGroups?.Any() != true)
               {
                    await DialogService.ShowMessageBox(
                   "Warning",
                   "Not all child have valid group assigned.", "OK");
                    return;
               }

               //var addEnrollments = new List<AddStudentCourseEnrollment>();

               foreach (var enrollmentgroup in SelectedGroups)
               {
                    var studentEnrollment = new AddStudentCourseEnrollment()
                              {

                                   ChildId = SelectedChild.ChildId,
                                   FamilyId = userInfo.FamilyId,
                                   CourseId = SelectedCourse.CourseId,
                                   CourseEnrollmentGroupId = enrollmentgroup.CourseEnrollmentGroupId,
                                   WillUseDayCare = WillUseDayCare,
                                   DayCareDays = DayCareDays,
                              };
                    addEnrollments.Add(studentEnrollment);
               }
          }
          else
          {
               if (SelectedGroups == null)
               {
                    await DialogService.ShowMessageBox(
                         "Warning",
                         "Not all child have valid group assigned.", "OK");
                    return;
               }

               //addEnrollments = new List<AddStudentCourseEnrollment>();
               {

                    var studentEnrollment = new AddStudentCourseEnrollment()
                         {

                              ChildId = SelectedChild.ChildId,
                              FamilyId = userInfo.FamilyId,
                              CourseId = SelectedCourse.CourseId,
                              CourseEnrollmentGroupId = SelectedGroup.CourseEnrollmentGroupId,
                             WillUseDayCare = WillUseDayCare,
                                   DayCareDays = DayCareDays,
                         };

                    addEnrollments.Add(studentEnrollment);
               }
          }

          //Add enrollments.
          var items = await CourseEnrollmentService.AddCourseEnrollmentsAsync(addEnrollments);
          if (items?.Any() == true)
          {
               //StateService.ParentState.ClearCourseEnrollment();
               await StateService.LoadCourseEnrollments(CourseEnrollmentService, userInfo.FamilyId, true);
               Snackbar.Add("Enrollments have been added.", Severity.Success);

               await OnCompletedClickedHandler();
               IsSuccess = true;

               //MudDialog.Close(DialogResult.Ok(items));
          }
          else
          {
               IsError = true;
               Snackbar.Add("Enrollments can not be added for family. Please try in a moment or contact support.", Severity.Error);
          }
     }

     private async Task OnCompletedClickedHandler()
     {
          if (OnCompleted.HasDelegate)
          {
               await OnCompleted.InvokeAsync();
          }
     }
}
