@inherits LocalizeableBaseComponent<ChildList>

@using Maktab.Consumer.Dialogs
@using Maktab.Consumer.Helpers
@using Maktab.Consumer.State
@using Maktab.Consumer.Extensions
@using MaktabDataContracts.Requests.Children
@using MaktabDataContracts.Responses.Children
@using MudBlazor

@inject IDialogService DialogService
@inject IChildrenService ChildrenService
@inject UserStateService StateService

@if (ShowHeader)
{
     <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
          <MudText Typo="Typo.h6">@L[MaktabResources.Participants]</MudText>
          @if (ShowAddButton)
          {
               <MudSpacer />
               <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddChildDialog" Class="mb-4">
                    @L[MaktabResources.Add_Participant]
               </MudButton>
          }
     </MudStack>

}

<MudTable Items="Children" Elevation="1" Dense="true" Bordered="false" Hover="false">
     <HeaderContent>
          <MudTh>@L[MaktabResources.First_Name]</MudTh>
          <MudTh>@L[MaktabResources.Last_Name]</MudTh>
          <MudTh>@L[MaktabResources.Date_Of_Birth]</MudTh>
          <MudTh>@L[MaktabResources.Gender]</MudTh>
          <MudTh>@L[MaktabResources.RAMQ_Number]</MudTh>
          <MudTh>@L[MaktabResources.RAMQ_Expiry]</MudTh>
          @* <MudTh>Allergies</MudTh>
          <MudTh>Other Health</MudTh> *@
          <MudTh> </MudTh>
          @* <MudTh>Daycare</MudTh> *@
     </HeaderContent>
     <RowTemplate>
          <MudTd>@context.FirstName</MudTd>
          <MudTd>@context.LastName</MudTd>
          <MudTd>@GetValidDateOfBirth(context)</MudTd>
          <MudTd>@(GetGenderLabel(context.Gender))</MudTd>
          <MudTd>@context.RAMQNumber</MudTd>
          <MudTd>@GetValidRAMQExpiry(context)</MudTd>
          @* <MudTd>@context.Allergies</MudTd>
          <MudTd>@context.OtherHealthConditions</MudTd> *@
          <MudTd>
               <MudMenu Icon="@Icons.Material.Filled.MoreVert" Color="Color.Default">
                    <MudMenuItem OnClick="@(() => OpenEditChildDialog(context))" >@L[MaktabResources.Edit]</MudMenuItem>
                    @if (ShowEnrollMenu)
                    {
                         <MudMenuItem OnClick="@(() => OpenAssignCourseDialog(context))">@L[MaktabResources.Enroll]</MudMenuItem>
                    }
                    <MudMenuItem OnClick="@(() => RemoveChild(context))">@L[MaktabResources.Delete]</MudMenuItem>
               </MudMenu>

          </MudTd>
          @* <MudTd>@(context.WillUseDayCareServices ? "Yes" : "No")</MudTd> *@
     </RowTemplate>
</MudTable>

@code {
     [Parameter] public Guid FamilyId { get; set; } = Guid.Empty;
     protected  IReadOnlyCollection<ChildResponse> Children => StateService.ParentState.Children ?? Array.Empty<ChildResponse>();
     [Parameter] public bool ShowAddButton { get; set; } = true;
     [Parameter] public bool ShowHeader { get; set; } = true;
     [Parameter] public bool ShowEnrollMenu { get; set; } = false;
     [Parameter] public Func<Task<bool>> PreEnrollmentValidationTask { get; set; } = null;

     protected override void OnInitialized()
     {
          base.OnInitialized();
          StateService.ParentState.OnChange += HandleStateChange;
     }

     protected virtual void HandleStateChange()
     {
          RequestRender();
     }

     protected override void OnDispose()
     {
          StateService.ParentState.OnChange -= HandleStateChange;
          base.OnDispose();
     }

     private async Task OpenAddChildDialog()
     {
          var result = await OpenAddChildDialog(DialogService, FamilyId);

          if (result!= null && !result.Canceled && result.Data is ChildResponse child)
          {
               await StateService.LoadChildrenData(ChildrenService, FamilyId, true);
               RequestRender();
          }
     }

     private async Task OpenAssignCourseDialog(ChildResponse childResponse)
     {
          if (PreEnrollmentValidationTask != null)
          {
              var isErollmentValidated = await PreEnrollmentValidationTask.Invoke();
              if (!isErollmentValidated)
              {
                  return;
              }
          }

          var result = await OpenEnrollChildDialog(DialogService);

          //Updated enrollments if enrollment was successful, even if dialog was closed with close button
          RequestRender();
     }

     private bool HasCourseEnrollments(ChildResponse child)
     {
          return StateService.ParentState.CourseEnrollments?
                    .Any(enrollment => enrollment.IsActive && enrollment.ChildId == child.ChildId) == true;
     }

