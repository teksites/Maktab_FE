     private string GetValidDateOfBirth(ChildResponse childResponse)
     {
          var dob = childResponse.DateOfBirth == Constants.DefaultDateTime ? "-" : childResponse.DateOfBirth.ToShortDateString();
          return dob;
     }

     private string GetValidRAMQExpiry(ChildResponse childResponse)
     {
          var expiry = childResponse.RAMQExpiry == Constants.DefaultDateTime ? "-" : childResponse.RAMQExpiry.ToString("MM/yy");
          return expiry;
     }

     private async Task OpenEditChildDialog(ChildResponse childResponse)
     {
          var dialogResult = await this.OpenEditChildDialog(DialogService, childResponse);
          if (dialogResult != null && !dialogResult.Canceled && dialogResult.Data is ChildResponse child)
          {
               //await LoadChildrenData(userInfo.FamilyId, true);
               await StateService.LoadChildrenData(ChildrenService, child.FamilyId, true);
               RequestRender();
          }
     }
}
