@inherits BaseFormComponent<EditUserInfo>


@using MaktabDataContracts.Enums
@using MaktabDataContracts.Requests.Users
@using System.ComponentModel.DataAnnotations
@using MaktabDataContracts.Responses.Users

@inject IUserService UserService

@* <MudGrid> 
     <MudItem xs="12" sm="8">*@
<MudPaper Class="pa-12">
     <MudForm @ref="_form" @bind-IsValid="@_isValid" OnValidSubmit="@(HandleSaving)" Validated="@(OnFormValidated)" Spacing="2">
          <MudTextField T="string" @bind-Value="UserInformation.FirstName" Label=@L[MaktabResources.First_Name] Required="true" RequiredError=@L[MaktabResources.Msg_Info_Value_Is_Required, @L[MaktabResources.First_Name]] />
          <MudTextField T="string" @bind-Value="UserInformation.LastName" Label=@L[MaktabResources.Last_Name] Required="true" RequiredError=@L[MaktabResources.Msg_Info_Value_Is_Required, @L[MaktabResources.Last_Name]] />
          <MudTextField T="string" ReadOnly="true" @bind-Value="UserInformation.Email" Label=@L[MaktabResources.Email] Required="true" RequiredError=@L[MaktabResources.Msg_Info_Value_Is_Required, @L[MaktabResources.Email]]
                        Validation="@(new EmailAddressAttribute() {ErrorMessage =@L[MaktabResources.Email_Invalid]})" />
          <MudTextField T="string" @bind-Value="UserInformation.Phone" Label=@L[MaktabResources.Phone] Required="true" RequiredError=@L[MaktabResources.Msg_Info_Value_Is_Required, @L[MaktabResources.Phone]]
                        Validation="@(new PhoneAttribute() { ErrorMessage = @L[MaktabResources.Msg_Error_Phone_Number_Invalid]})" />

          <MudSelect @bind-Value="UserInformation.Relationship" Label=@L[MaktabResources.Relationship]>
               @foreach (var margin in relationShips)
               {
                    <MudSelectItem Value="margin">@margin</MudSelectItem>
               }
          </MudSelect>


          @if (!string.IsNullOrWhiteSpace(_errorMessage))
          {
               <MudAlert Severity="Severity.Error" Elevation="0" Class="my-4">
                    @_errorMessage
               </MudAlert>
          }

          <MudStack Direction="Row" Justify="Justify.FlexEnd" Spacing="2" Class="mt-4">
               <MudButton Type="Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!_isValid || isSaving)" StartIcon="@Icons.Material.Filled.Check" OnClick="@(HandleSaving)">
                    @if (isSaving)
                    {
                         <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                         <span>@L[MaktabResources.Msg_Processing]</span>
                    }
                    else
                    {
                         <span>@L[MaktabResources.Save]</span>
                    }
               </MudButton>

               <MudButton OnClick="@OnCancelClickedHandler" Color="Color.Secondary" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Close">@L[MaktabResources.Cancel]</MudButton>
          </MudStack>


     </MudForm>
</MudPaper>

@code {

     [Parameter, EditorRequired] public UserInformationResponse UserInformation { get; set; }

     [Parameter] public EventCallback<UserInformationResponse> OnSave { get; set; }
     [Parameter] public EventCallback OnCancel { get; set; }

     private bool isSaving = false;

     IEnumerable<Relationship> relationShips;

     protected override async Task OnInitializedAsync()
     {
          await base.OnInitializedAsync();

          relationShips = Enum.GetValues(typeof(Relationship)).Cast<Relationship>().Where(x => x == Relationship.Mother || x == Relationship.Father);
     }

     private async Task HandleSaving()
     {
          try
          {
               isSaving = true;
               RequestRender();
               await InvokeUserAction(RequestSaving);
          }
          finally
          {
               isSaving = false;
               RequestRender();
          }
     }

     private async Task RequestSaving()
     {
          UserInformation.Email = UserInformation.Email.ToLowerInvariant();
          UserInformation.UserName = UserInformation.Email;

          //Todo: Add logic to edit user info

          // if (FamilyId == Guid.Empty)
          // {
          //      _errorMessage = "Please provide valid family id to connect.";
          //      Snackbar.Add(_errorMessage, Severity.Error);
          //      return;
          // }

          // var isUserExists = await UserService.ValidateUsernameAsync(userInformation.UserName);
          // if (isUserExists)
          // {
          //      _errorMessage = "User is already registered with system. Please contact support";
          //      Snackbar.Add(_errorMessage, Severity.Error);
          //      return;
          // }

          // userInformation.FamilyId = FamilyId;
          // userInformation.Password = "Test1234!";

          //var result = await UserService.RegisterUserAsync(userInformation);
          // if (result == null)
          // {
          //      _errorMessage = "User can not be registered with system. Please try again in few minutes";
          //      Snackbar.Add(_errorMessage, Severity.Error);
          //      return;
          // }

          // Snackbar.Add("User has been linked.", Severity.Success);
          await OnSave.InvokeAsync(UserInformation);
     }

     private async Task OnCancelClickedHandler()
     {
          await OnCancel.InvokeAsync();
     }

}
