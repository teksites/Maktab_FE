@code {
     //[Parameter]
     public AddExtendedUserInformationRequest ExtendedModel { get; set; } = new();

     [Parameter] public EventCallback<ExtendedUserInformationResponse> OnSave { get; set; }
     [Parameter] public EventCallback OnCancel { get; set; }
     [Parameter, EditorRequired] public Guid FamilyId { get; set; }
     [Parameter, EditorRequired] public Guid AddessId { get; set; }
     [Parameter, EditorRequired] public Guid UserId { get; set; }

     private bool isSaving = false;

     protected override async Task OnInitializedAsync()
     {
          await base.OnInitializedAsync();
     }

     private async Task HandleExtendedInfoSave()
     {
          try
          {
               isSaving = true;
               RequestRender();
               await InvokeUserAction(RequestSaveExtendedInfo);
          }
          finally
          {
               isSaving = false;
               RequestRender();
          }
     }

     private async Task RequestSaveExtendedInfo()
     {
          if (FamilyId == Guid.Empty)
          {
               _errorMessage = @L[MaktabResources.Msg_Error_No_Family_Id];//"Please provide valid Family.";
               Snackbar.Add(_errorMessage, Severity.Error);
               return;
          }

          if (AddessId == Guid.Empty)
          {
               _errorMessage = @L[MaktabResources.Msg_Error_No_Address_Id];//"Please provide valid address Id.";
               Snackbar.Add(_errorMessage, Severity.Error);
               return;
          }


          this.ExtendedModel.FamilyId = FamilyId;
          this.ExtendedModel.AddressId = AddessId;
          var result = await this.UserService.SaveExtendedInfoAsync(this.UserId, this.ExtendedModel);
          if (result == null)
          {
               _errorMessage = @L[MaktabResources.Msg_Error_Add_ExtendedInfo_Save];//"Error saving extended info. please try in few moments.";
               Snackbar.Add(_errorMessage, Severity.Error);
               return;
          }


          await OnSave.InvokeAsync(result);
     }

     private async Task OnCancelClickedHandler()
     {
          await OnCancel.InvokeAsync();
     }

     

