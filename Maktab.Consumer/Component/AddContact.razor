@using MaktabDataContracts.Enums
@using MaktabDataContracts.Requests.OtherContacts
@using MaktabDataContracts.Responses.OtherContacts
@inherits BaseFormComponent<ContactForm>

@inject IContactService ContactService


<MudForm @ref="_form" @bind-IsValid="@_isValid" OnValidSubmit="@(HandleSaving)" Validated="@(OnFormValidated)">
     @if (isInitialized)
     {
          <MudStack Spacing="2">
               <MudTextField @bind-Value="Contact.FirstName" Label=@L[MaktabResources.First_Name] Required="true" />
               <MudTextField @bind-Value="Contact.LastName" Label=@L[MaktabResources.Last_Name] Required="true" />
               <MudTextField @bind-Value="Contact.Phone" Label=@L[MaktabResources.Phone] Required="true" />

               <MudSelect T="ContactType" Label=@L[MaktabResources.Contact_Type] @bind-Value="Contact.ContactType" Required="true">
                    @foreach (var contactType in Enum.GetValues<ContactType>())
                    {
                         <MudSelectItem @key="contactType" Value="@contactType">@(GetContactTypeLabel(contactType))</MudSelectItem>
                    }
               </MudSelect>

               <MudSelect T="Relationship" Label=@L[MaktabResources.Relationship] @bind-Value="Contact.Relationship" Required="true">
                    @foreach (var rel in Enum.GetValues<Relationship>())
                    {
                         <MudSelectItem @key="rel" Value="@rel">@(GetRelationshipLabel(rel))</MudSelectItem>
                    }
               </MudSelect>

               <MudStack Row="true" Spacing="2" Class="mt-6" Justify="Justify.FlexEnd">
                    @if (ShowCancelButton)
                    {
                         <MudButton Variant="Variant.Outlined" Color="Color.Default"
                         OnClick="@OnCancelClickedHandler"
                         StartIcon="@Icons.Material.Filled.Close">
                              @L[MaktabResources.Cancel]
                         </MudButton>
                    }
                    <MudButton Type="Submit" Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Check"
                               OnClick="@HandleSaving"
                               Disabled="@(!_isValid || isSaving)">
                         @if (isSaving)
                         {
                              <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                              <span>@L[MaktabResources.Msg_Processing]</span>
                         }
                         else
                         {
                              <span>@L[MaktabResources.Save]</span>
                         }
                    </MudButton>
               </MudStack>
          </MudStack>
     }
     else
     {
          <BusyContent DisplayText=@L[MaktabResources.Msg_Initializing] />
     }
</MudForm>

@code {
     private MudForm _form = default!;

     [Parameter] public AddOtherContact? Contact { get; set; } = new();
     [Parameter, EditorRequired] public Guid FamilyId { get; set; } = Guid.Empty;
     [Parameter] public ContactType ContactType { get; set; } = ContactType.Unknown;
     [Parameter] public bool ShowCancelButton { get; set; } = false;

     [Parameter] public EventCallback<OtherContactResponse> OnSave { get; set; }
     [Parameter] public EventCallback OnCancel { get; set; }

     private bool isSaving = false;
     private bool isInitialized = false;


     protected override async Task OnInitializedAsync()
     {
          await base.OnInitializedAsync();
          isInitialized = true;
          RequestRender();
     }

     protected override async Task OnParametersSetAsync()
     {
          await base.OnParametersSetAsync();

          if (ContactType != ContactType.Unknown)
          {
               Contact.ContactType = ContactType;
          }

          if (ContactType != ContactType.Unknown)
          {
               Contact.ContactType = ContactType;
          }

          if (FamilyId != Guid.Empty)
          {
               Contact.FamilyId = FamilyId;
          }
     }

     private async Task HandleSaving()
     {
          try
          {
               isSaving = true;
               RequestRender();
               await InvokeUserAction(RequestSaving);
          }
          finally
          {
               isSaving = false;
               RequestRender();
          }
     }

     // private async Task Save()
     // {
     //      await _form.Validate();
     //      if (_form.IsValid)
     //      {
     //           await OnValidSubmit.InvokeAsync(_contact);
     //      }
     // }

     private async Task RequestSaving()
     {
          if (FamilyId == Guid.Empty)
          {
               _errorMessage = L[MaktabResources.Msg_Error_No_Family_Id];
               Snackbar.Add(_errorMessage, Severity.Error);
               return;
          }

          var addedContact = await ContactService.SaveContactAsync(FamilyId, Contact);
          if (addedContact.ContactId == Guid.Empty)
          {
               _errorMessage = L[MaktabResources.Msg_Error_Add_Contact_Save];//"Contact can not be added with system. Please try again in few minutes";
               Snackbar.Add(_errorMessage, Severity.Error);
               return;
          }
          else
          {
               Snackbar.Add(L[MaktabResources.Msg_Success_Contact_Added], Severity.Success);
          }

          if (OnSave.HasDelegate)
          {
               await OnSave.InvokeAsync(addedContact);
          }
     }

     private async Task OnCancelClickedHandler()
     {
          await OnCancel.InvokeAsync();
     }
}
