@using Maktab.Consumer.Helpers
@using Maktab.Domain.Extensions
@using Maktab.Consumer.State
@using MaktabDataContracts.Responses.Course

@inherits LocalizeableBaseComponent<CourseCard>

@inject UserStateService StateService

<MudCard Class="d-flex flex-column flex-auto"
         Style="height: 100%; border: 1px solid var(--mud-palette-divider); border-radius: 12px; transition: box-shadow 0.2s ease;">
     <MudCardContent Class="flex-grow-1 pa-5">
          @* -- Icon + Title row -- *@
          <div class="d-flex align-start gap-3 mb-3">
               @* <MudAvatar Size="Size.Medium" Style="background-color: var(--mud-palette-primary-lighten);
                    color: var(--mud-palette-primary);"
                          Rounded="true">
                    <MudIcon Icon="@Icons.Material.Outlined.MenuBook" Size="Size.Small" />
               </MudAvatar> *@
               <MudText Typo="Typo.h6" Class="fw-semibold mt-1">
                    @GetCourseName(Course)
               </MudText>
          </div>

          @* -- Description -- *@
          <MudText Typo="Typo.body2"
                   Style="color: var(--mud-palette-text-secondary);"
                   Class="truncate-3">
               @GetCourseDescription(Course)
          </MudText>

          @* <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@Course.Instructor</MudText> *@

          @if (ShowInstituteName)
          {
               <!-- Institute -->
               <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Center">
                    <MudIcon Icon="@Icons.Material.Filled.School" Color="Color.Info" />
                    <MudText Typo="Typo.subtitle1">
                         <b>@L[MaktabResources.School]</b> @(GetInstituteName())
                    </MudText>
               </MudStack>
          }

          @if (ShowProgress)
          {
               <CourseProgress Course="@Course" />
               @* <MudStack>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">
                         Progress: @Course.GetProgress().ToString("0")%
                    </MudText>

                    <MudProgressLinear Value="@Course.GetProgress()" Color="Color.Primary"
                                       Rounded="true" Class="my-1" />

                    @if (Course.GetProgress() >= 100)
                    {
                         <MudChip T="string" Color="Color.Success" Variant="Variant.Filled">Completed</MudChip>
                    }
                    else
                    {
                         <MudText Typo="Typo.caption" Color="Color.Secondary">
                              Ends on @Course.EndDate.ToString("dd MMM yyyy")
                         </MudText>
                    }
               </MudStack> *@
          }



     </MudCardContent>

     <MudCardActions Class="pa-4">
          <MudButton Variant="@(HighlightButton ? Variant.Outlined : Variant.Text)"
                     Color="Color.Primary"
                     Size="Size.Small"
                     EndIcon="@Icons.Material.Outlined.ArrowForward"
                     OnClick="NavigateToDetails">
               @L[MaktabResources.View_Details]
          </MudButton>
     </MudCardActions>
</MudCard>

@code {
     [Parameter] public CourseResponseDetailed Course { get; set; } = new();
     [Parameter] public bool ShowProgress { get; set; } = false;
     [Parameter] public bool HighlightButton { get; set; } = false;
     [Parameter] public bool ShowInstituteName { get; set; } = false;


     protected override async Task OnInitializedAsync()
     {
          await base.OnInitializedAsync();
     }

     private void NavigateToDetails()
     {
          NavigationManager.NavigateTo(string.Format(Constants.CourseDetailsRoute, Course.CourseId));
     }

     private string GetInstituteName()
     {
          var institute = StateService.InstituteState.Institutes?.FirstOrDefault(i => i.InstituteId == Course.InstituteId);
          if(institute == null)
          {
               return string.Empty;
          }

          return GetInstituteName(institute);
     }
}
