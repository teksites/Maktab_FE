@using Maktab.Consumer.Helpers
@using Maktab.Domain.Extensions

@using MaktabDataContracts.Responses.Course

@inherits LocalizeableBaseComponent<CourseCard>

@inject NavigationManager Navigation

<MudCard Class="mb-4">
     @* <MudCardMedia Image="@Course.ImageUrl" Height="180" /> *@
     <MudCardContent>
          <MudText Typo="Typo.h6">@(GetCourseName())</MudText>
          @* <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@Course.Instructor</MudText> *@
          <MudText Typo="Typo.body2" Class="truncate-2">@(GetCourseDescription())</MudText>

          @if (ShowProgress)
          {
               <CourseProgress Course="@Course" />
               @* <MudStack>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">
                         Progress: @Course.GetProgress().ToString("0")%
                    </MudText>

                    <MudProgressLinear Value="@Course.GetProgress()" Color="Color.Primary"
                                       Rounded="true" Class="my-1" />

                    @if (Course.GetProgress() >= 100)
                    {
                         <MudChip T="string" Color="Color.Success" Variant="Variant.Filled">Completed</MudChip>
                    }
                    else
                    {
                         <MudText Typo="Typo.caption" Color="Color.Secondary">
                              Ends on @Course.EndDate.ToString("dd MMM yyyy")
                         </MudText>
                    }
               </MudStack> *@
          }



     </MudCardContent>
     <MudCardActions>
          @if (HighlightButton)
          {
               <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="NavigateToDetails">
                    @L[MaktabResources.View_Details]
               </MudButton>
          }
          else
          {
               <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="NavigateToDetails">
                    @L[MaktabResources.View_Details]
               </MudButton>
          }
     </MudCardActions>
</MudCard>

@code {
     [Parameter] public CourseResponseDetailed Course { get; set; } = new();
     [Parameter] public bool ShowProgress { get; set; } = false;
     //[Parameter] public string ViewDetailsButtonText { get; set; }// = this.L[MaktabResources.View_Details];
     [Parameter] public bool HighlightButton { get; set; } = false;


     protected override async Task OnInitializedAsync()
     {
          await base.OnInitializedAsync();
     }

     private void NavigateToDetails()
     {
          Navigation.NavigateTo(string.Format(Constants.CourseDetailsRoute, Course.CourseId));
     }

     private string GetCourseName()
     {
          if(GlobalizationService.CurrentCulture.TwoLetterISOLanguageName == "fr")
          {
               return Course.NameFr;
          }
          else
          {
               return Course.Name;
          }
     }

     private string GetCourseDetails()
     {
          if (GlobalizationService.CurrentCulture.TwoLetterISOLanguageName == "fr")
          {
               return Course.DetailsFr;
          }
          else
          {
               return Course.Details;
          }
     }

     private string GetCourseDescription()
     {
          if (GlobalizationService.CurrentCulture.TwoLetterISOLanguageName == "fr")
          {
               return Course.DescriptionFr;
          }
          else
          {
               return Course.Description;
          }
     }
}
