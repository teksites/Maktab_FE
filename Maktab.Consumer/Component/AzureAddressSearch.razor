@using Maktab.Consumer.Services
@inject IAzureAddressService AzureAddressService

<div style="position:relative;">
    <MudGrid Spacing="2" AlignItems="AlignItems.End">
        <MudItem xs="11" sm="11">
            <MudTextField @bind-Value="_query"
                          Label="Search Address"
                          Placeholder="Enter complete street address with postal code and hit search"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          OnKeyDown="@OnKeyDown"
                          Disabled="@_manualMode"
                          Class="@Class" />
        </MudItem>
        <MudItem xs="1" sm="1" Class="d-flex align-end pb-1">
            <MudIconButton Icon="@Icons.Material.Filled.Search"
                           Color="Color.Primary"
                           Variant="Variant.Filled"
                           OnClick="ExecuteSearch"
                           Disabled="@(_isSearching || _manualMode)"
                           title="Search" />
        </MudItem>
    </MudGrid>

    @if (_isSearching)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-1" />
    }

    @if (_results.Count > 0 && !_manualMode)
    {
        <MudPaper Elevation="4" Style="position:absolute; left:0; right:0; z-index:1000; max-height:260px; overflow-y:auto;" Class="mt-1">
            <MudList T="AzureAddressResult" Dense="true" Padding="false">
                @foreach (var r in _results)
                {
                    var result = r;
                    <MudListItem T="AzureAddressResult"
                                 OnClick="@(() => OnResultSelected(result))"
                                 Style="cursor:pointer;">
                        <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Class="me-2" Color="Color.Primary" />
                        @result.FormattedAddress
                    </MudListItem>
                    <MudDivider />
                }
            </MudList>
        </MudPaper>
    }

    @if (_tooShort && !_manualMode)
    {
        <MudText Typo="Typo.caption" Color="Color.Warning" Class="mt-1 ms-1">Enter complete street address to search.</MudText>
    }

    @if (_noResults && !_manualMode)
    {
        <MudText Typo="Typo.caption" Color="Color.Error" Class="mt-1 ms-1">No results found. Try a more specific address.</MudText>
    }
</div>

<div class="mt-4 d-inline-flex">
    <MudSwitch T="bool"
               Value="_manualMode"
               ValueChanged="OnManualToggleChanged"
               Color="Color.Primary"
               Label="Enter Address Manually"
               Size="Size.Small" />
</div>

@code {
    [Parameter] public EventCallback<AzureAddressResult> OnSelected    { get; set; }
    [Parameter] public EventCallback<bool>               OnManualToggle { get; set; }
    [Parameter] public string                            Class          { get; set; } = string.Empty;

    private string _query       = string.Empty;
    private bool   _isSearching = false;
    private bool   _noResults   = false;
    private bool   _tooShort    = false;
    private bool   _manualMode  = false;
    private List<AzureAddressResult> _results = new();

    private async Task OnManualToggleChanged(bool value)
    {
        _manualMode = value;
        _results.Clear();
        _noResults = false;
        _tooShort  = false;
        if (OnManualToggle.HasDelegate)
            await OnManualToggle.InvokeAsync(value);
    }

    private async Task ExecuteSearch()
    {
        _tooShort  = false;
        _noResults = false;

        if (string.IsNullOrWhiteSpace(_query) || _query.Trim().Length < 10)
        {
            _tooShort = !string.IsNullOrWhiteSpace(_query);
            _results.Clear();
            return;
        }

        _isSearching = true;
        _results.Clear();
        StateHasChanged();

        var results = await AzureAddressService.SearchAsync(_query);
        _results     = results.ToList();
        _noResults   = _results.Count == 0;
        _isSearching = false;
        StateHasChanged();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ExecuteSearch();
    }

    private async Task OnResultSelected(AzureAddressResult result)
    {
        if (result is null) return;
        _results.Clear();
        _noResults = false;
        _query     = result.FormattedAddress;
        StateHasChanged();
        if (OnSelected.HasDelegate)
            await OnSelected.InvokeAsync(result);
    }
}
