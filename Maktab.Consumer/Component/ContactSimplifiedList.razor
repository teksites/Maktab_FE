@using MaktabDataContracts.Responses.OtherContacts
@inherits LocalizeableBaseComponent<ContactSimplifiedList>

@if (ShowHeader)
{
     <MudStack Row="true" AlignItems="AlignItems.Center" JustifyContent="space-between" Class="mb-2">
          <MudText Typo="Typo.h6">@L[MaktabResources.Contacts]</MudText>
          @if (ShowAddButton)
          {
               <MudButton Variant="Variant.Outlined"
                          Color="Color.Primary"
                          StartIcon="@Icons.Material.Filled.Add"
                          OnClick="OnAddContact">
                    @L[MaktabResources.Add_Contact]
               </MudButton>
          }
     </MudStack>
}

<MudList T="OtherContactResponse">
     @foreach (var contact in Contacts)
     {
          <MudListItem>
               <MudStack Row="true"> 
               <MudIcon Icon="@Icons.Material.Filled.ContactPhone" />
               <MudText>@contact.FirstName @contact.LastName - @contact.Phone</MudText>
               </MudStack>
          </MudListItem>
     }
</MudList>


@code {
     [Parameter] public bool ShowAddButton { get; set; } = true;
     [Parameter] public bool ShowHeader { get; set; } = true;
     [Parameter] public IEnumerable<OtherContactResponse> Contacts { get; set; }
     [Parameter] public EventCallback OnAddContact { get; set; }
}
