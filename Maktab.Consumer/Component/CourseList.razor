@using Maktab.Models.Models
@inherits BaseComponent<CourseList>

<MudGrid>
     @if (Courses?.Any() == true)
     {
          @foreach (var course in Courses)
          {
               <MudItem xs="12" sm="6" md="4" lg="3">
                    <CourseCard Course="@course" />
               </MudItem>
          }
     }
     else
     {
          <MudItem xs="12">
               <MudPaper Class="pa-4 d-flex justify-center">
                    <MudText Typo="Typo.body1" Color="Color.Secondary">
                         No courses found.
                    </MudText>
               </MudPaper>
          </MudItem>
     }
</MudGrid>

@code {
     [Parameter] public IEnumerable<Course> Courses { get; set; }
}
