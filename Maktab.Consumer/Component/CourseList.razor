@using MaktabDataContracts.Responses.Course
@inherits LocalizeableBaseComponent<CourseList>

<MudGrid>
     @if (Courses?.Any() == true)
     {
          @foreach (var course in Courses)
          {
               <MudItem Class="d-flex flex-grow-1" xs="12" sm="6" md="4" lg="3">
                    <CourseCard HighlightButton="@HighlightButton" Course="@course" ShowProgress="@ShowProgress" ShowInstituteName="@ShowInstituteName" />
               </MudItem>
          }
     }
     else
     {
          <MudItem xs="12">
               <MudPaper Class="pa-4 d-flex justify-center">
                    <MudText Typo="Typo.body1" Color="Color.Secondary">
                         @L[MaktabResources.Msg_Info_No_Course_Found]
                    </MudText>
               </MudPaper>
          </MudItem>
     }
</MudGrid>

@code {
     [Parameter] public IEnumerable<CourseResponseDetailed> Courses { get; set; }
     [Parameter] public bool ShowProgress { get; set; } = false;
     [Parameter] public bool HighlightButton { get; set; } = false;
     [Parameter] public bool ShowInstituteName { get; set; } = false;
}
