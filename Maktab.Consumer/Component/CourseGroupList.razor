@using Maktab.Models.Models
@using MaktabDataContracts.Responses.Course
@inherits LocalizeableBaseComponent<CourseGroupList>

<MudPaper Class="pa-4 mt-4">
     @* <MudText Typo="Typo.h6" Class="mb-2">Course Groups</MudText> *@

     @if (CourseGroups?.Any() == true)
     {
          @* <MudList T="string" Dense="true">
               @foreach (var module in Modules)
               {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                         <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Primary" />
                         <MudText>@module</MudText>
                    </MudStack>
               }
          </MudList> *@

          @* <MudTimeline TimelinePosition="TimelinePosition.Start">
               @foreach (var module in CourseGroups)
               {
                    <MudTimelineItem TimelineAlign="TimelineAlign.Default">
                         <MudText>@module</MudText>
                    </MudTimelineItem>
               }
               </MudTimeline> *@


          <MudList T="CourseEnrollmentGroupResponse" Dense="true">
               @foreach (var group in CourseGroups)
               {
                    <MudListItem Icon="@Icons.Material.Outlined.Groups">
                         <ChildContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                         @* <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Primary" /> *@
                                   <MudText>@(GetCourseGroupTitle(group))</MudText>
                         @* <MudText>@group.Description</MudText> *@
                         <MudSpacer/> 
                         <MudChipSet  >
                              @foreach( var chipSet in group.AcedemicGroups)
                                   {
                                      <MudChip T="String" Text="@chipSet"/>
                                   }
                              </MudChipSet>
                    </MudStack>
                         </ChildContent>
                    </MudListItem>
               }
          </MudList>
     }
     else
     {
          <MudText Typo="Typo.body2" Color="Color.Secondary">No modules available</MudText>
     }
</MudPaper>

@code {
     [Parameter] public IEnumerable<CourseEnrollmentGroupResponse> CourseGroups { get; set; }


     private string GetCourseGroupTitle(CourseEnrollmentGroupResponse group)
     {
          if (GlobalizationService.CurrentCulture.TwoLetterISOLanguageName == "fr")
          {
               return group.GroupTitleFr;
          }
          else
          {
               return group.GroupTitle;
          }
     }

     private string GetCourseDetails(CourseEnrollmentGroupResponse group)
     {
          if (GlobalizationService.CurrentCulture.TwoLetterISOLanguageName == "fr")
          {
               return group.DetailsFr;
          }
          else
          {
               return group.Details;
          }
     }
}
