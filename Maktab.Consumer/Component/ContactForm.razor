@using MaktabDataContracts.Enums
@using MaktabDataContracts.Requests.OtherContacts
@inherits BaseFormComponent<ContactForm>

@inject IChildrenService ChildrenService


<MudForm @ref="_form" @bind-IsValid="@_isValid" OnValidSubmit="@(HandleSaving)" Validated="@(OnFormValidated)">
     <MudStack Spacing="2">
          <MudTextField @bind-Value="_contact.FirstName" Label="First Name" Required="true" />
          <MudTextField @bind-Value="_contact.LastName" Label="Last Name" Required="true" />
          <MudTextField @bind-Value="_contact.Phone" Label="Phone" Required="true" />

          <MudSelect T="ContactType" Label="Contact Type" @bind-Value="_contact.ContactType" Required="true">
               @foreach (var type in Enum.GetValues<ContactType>())
               {
                    <MudSelectItem Value="@type">@type</MudSelectItem>
               }
          </MudSelect>

          <MudSelect T="Relationship" Label="Relationship" @bind-Value="_contact.Relationship" Required="true">
               @foreach (var rel in Enum.GetValues<Relationship>())
               {
                    <MudSelectItem Value="@rel">@rel</MudSelectItem>
               }
          </MudSelect>

          <MudStack Row="true" JustifyContent="flex-end" Class="mt-4">
               <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!_isValid || isSaving)" OnClick="@HandleSaving">
                    Save
               </MudButton>
          </MudStack>
     </MudStack>
</MudForm>

@code {
     private MudForm _form = default!;
     private AddOtherContact _contact = new();

     [Parameter] public AddOtherContact? Contact { get; set; }
     [Parameter]
     public Guid FamilyId { get; set; } = Guid.Empty;

     [Parameter] public EventCallback<AddOtherContact> OnSave { get; set; }
     [Parameter] public EventCallback OnCancel { get; set; }

     private bool isSaving = false;

     protected override void OnParametersSet()
     {
          _contact = Contact != null
              ? new AddOtherContact
              {
                   FamilyId = Contact.FamilyId,
                   FirstName = Contact.FirstName,
                   LastName = Contact.LastName,
                   Phone = Contact.Phone,
                   ContactType = Contact.ContactType,
                   Relationship = Contact.Relationship
              }
              : new AddOtherContact { FamilyId = Guid.NewGuid() };
     }


     private async Task HandleSaving()
     {
          try
          {
               isSaving = true;
               RequestRender();
               await InvokeUserAction(RequestSaving);
          }
          finally
          {
               isSaving = false;
               RequestRender();
          }
     }

