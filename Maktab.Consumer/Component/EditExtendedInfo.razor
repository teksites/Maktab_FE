@inherits BaseFormComponent<EditExtendedInfo>

@using Maktab.Consumer.Dialogs

@using MaktabDataContracts.Requests.Users
@using MaktabDataContracts.Responses.Users
@using MudBlazor
@using System.ComponentModel.DataAnnotations

@inject IUserService UserService


@* <EditForm Model="@ExtendedModel" OnValidSubmit="HandleValidSubmit"> *@
     <MudPaper Class="pa-6" Elevation="0" Outlined="true">
          <MudText Typo="Typo.h6" Class="mb-4" GutterBottom="true">
          @L[MaktabResources.Extended_Info]
          </MudText>
     @if (isInitialized)
     {
          <MudForm @ref="_form" @bind-IsValid="@_isValid" OnValidSubmit="@(HandleExtendedInfoSave)" Validated="@(OnFormValidated)">

               <MudGrid Container="true" Spacing="3">
                    @*  <MudItem xs="12" sm="6">
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddAddressDialog" Class="mb-4">
                         Add Address
                    </MudButton>
                    <DisplayAddress Address="@SelectedAddress" />
               </MudItem> *@

                    <MudItem xs="12" sm="6">
                         <MudTextField @bind-Value="ExtendedModel.SIN"
                                       Label=@L[MaktabResources.SIN_Number]
                                       Required="true"
                                       Validation="@(new Func<string, IEnumerable<string>>(ValidateCanadianIndividualTaxCode))"
                                       For="@(() => ExtendedModel.SIN)" />
                    </MudItem>


                    <MudItem xs="12" sm="6" Class="d-flex align-center">
                         <MudSwitch @bind-Value="ExtendedModel.IsActiveTaxCreditRecipient"
                         T="bool"
                         Label=@L[MaktabResources.Active_Tax_Payer]
                         Color="Color.Primary" />
                    </MudItem>
               </MudGrid>


               @if (!string.IsNullOrWhiteSpace(_errorMessage))
               {
                    <MudAlert Severity="Severity.Error" Elevation="0" Class="my-4">
                         @_errorMessage
                    </MudAlert>
               }

               <MudStack Row="true" Spacing="2" Class="mt-6" Justify="Justify.FlexEnd">
                    <MudButton Variant="Variant.Outlined" Color="Color.Default"
                    OnClick="@OnCancelClickedHandler"
                    StartIcon="@Icons.Material.Filled.Close">
                         Cancel
                    </MudButton>
                    <MudButton Type="Submit" Variant="Variant.Filled" Color="Color.Primary" 
                    StartIcon="@Icons.Material.Filled.Check" 
                    OnClick="@(HandleExtendedInfoSave)"
                    Disabled="@(!_isValid || isSaving)">
                         @if (isSaving)
                         {
                              <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                              <span>@L[MaktabResources.Msg_Processing]</span>
                         }
                         else
                         {
                              <span>@L[MaktabResources.Update]</span>
                         }
                    </MudButton>
               </MudStack>
          </MudForm>
     }
     else
     {
          <BusyContent DisplayText=@L[MaktabResources.Msg_Initializing] />
     }
</MudPaper>

@* </EditForm> *@

@code {
     [Parameter, EditorRequired] public ExtendedUserInformationResponse ExtendedModel { get; set; }
     [Parameter] public EventCallback<ExtendedUserInformationResponse> OnSave { get; set; }
     [Parameter] public EventCallback OnCancel { get; set; }

     private bool isSaving = false;
     private bool isInitialized = false;


     protected override async Task OnInitializedAsync()
     {
          await base.OnInitializedAsync();
          this.isInitialized = true;
          RequestRender();
     }

     private async Task HandleExtendedInfoSave()
     {
          try
          {
               isSaving = true;
               RequestRender();
               await InvokeUserAction(RequestUpdateExtendedInfo);
          }
          finally
          {
               isSaving = false;
               RequestRender();
          }
     }

     private async Task RequestUpdateExtendedInfo()
     {
         
          var result = await this.UserService.UpdateExtendedInfoAsync(this.ExtendedModel.UserId, this.ExtendedModel);
          if (result == null)
          {
               _errorMessage = @L[MaktabResources.Msg_Error_Add_ExtendedInfo_Save];
               Snackbar.Add(_errorMessage, Severity.Error);
               return;
          }


          await OnSave.InvokeAsync(result);
     }

     private async Task OnCancelClickedHandler()
     {
          await OnCancel.InvokeAsync();
     }
}
