@using MaktabDataContracts.Responses.Users
@inherits BaseComponent<ParentInfoCard>

<MudCard Class="mb-4 pa-4">
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        <MudAvatar Size="Size.Large" Color="Color.Primary">@Initials</MudAvatar>
          <MudStack Spacing="1">
            <MudText Typo="Typo.h5">@Parent.FirstName @Parent.LastName</MudText>
            <MudText Typo="Typo.body2">@Parent.Email</MudText>
            <MudText Typo="Typo.body2">@Parent.Phone</MudText>
        </MudStack>

          @if (ShowEditButton)
          {
               <MudSpacer />
               <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit"
               OnClick="@(() => OnEdit.InvokeAsync(Parent))">
            Edit Profile
        </MudButton>
        }
    </MudStack>
</MudCard>

@code {
     [Parameter] public bool ShowEditButton { get; set; } = true;
     [Parameter] public UserInformationResponse Parent { get; set; } = default!;
     [Parameter] public EventCallback<UserInformationResponse> OnEdit { get; set; }

     private bool isInitialized = false;


     protected override async Task OnInitializedAsync()
     {
          await base.OnInitializedAsync();
          isInitialized = true;
          RequestRender();
     }


     private string Initials => string.Join("", Parent.FirstName.Split(' ').Select(n => n[0])).ToUpper();
}
