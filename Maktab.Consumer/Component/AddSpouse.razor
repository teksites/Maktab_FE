@inherits BaseFormComponent<AddSpouse>


@using MaktabDataContracts.Enums
@using MaktabDataContracts.Requests.Users
@using System.ComponentModel.DataAnnotations

@inject IUserService UserService

@* <MudGrid> 
     <MudItem xs="12" sm="8">*@
<MudPaper Class="pa-12">
     <MudForm @ref="_form" @bind-IsValid="@_isValid" OnValidSubmit="@(HandleSaving)" Validated="@(OnFormValidated)" Spacing="2">
          <MudTextField T="string" @bind-Value="Spouse.FirstName" Label="First name" Required="true" RequiredError="First name is required!" />
          <MudTextField T="string" @bind-Value="Spouse.LastName" Label="Last name" Required="true" RequiredError="Last name is required!" />
          <MudTextField T="string" @bind-Value="Spouse.Email" Label="Email" Required="true" RequiredError="Email is required!"
                        Validation="@(new EmailAddressAttribute() {ErrorMessage = "The email address is invalid"})" />
          <MudTextField T="string" @bind-Value="Spouse.Phone" Label="Phone" Required="true" RequiredError="Phone number is required!"
                        Validation="@(new PhoneAttribute() { ErrorMessage = "The phone number is invalid"})" />

          <MudSelect @bind-Value="Spouse.Relationship" Label="Relationship with children">
               @foreach (var margin in relationShips)
               {
                    <MudSelectItem Value="margin">@margin</MudSelectItem>
               }
          </MudSelect>

          @if (!string.IsNullOrWhiteSpace(_errorMessage))
          {
               <MudAlert Severity="Severity.Error" Elevation="0" Class="my-4">
                    @_errorMessage
               </MudAlert>
          }

          <MudStack Direction="Row" Justify="Justify.FlexEnd" Spacing="2" Class="mt-4">
               <MudButton Type="Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!_isValid || isSaving)" StartIcon="@Icons.Material.Filled.Check" OnClick="@(HandleSaving)">
                    @if (isSaving)
                    {
                         <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                         <span>Processing...</span>
                    }
                    else
                    {
                         <span>Save</span>
                    }
               </MudButton>

               <MudButton OnClick="@OnCancelClickedHandler" Color="Color.Secondary" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Close">Cancel</MudButton>
          </MudStack>


     </MudForm>
</MudPaper>

@code {
     [Parameter] public Guid FamilyId { get; set; } = Guid.Empty;
     [Parameter] public AddUserInformation Spouse { get; set; } = new AddUserInformation();

     [Parameter] public EventCallback<MaktabDataContracts.Responses.Users.UserInformationResponse> OnSave { get; set; }
     [Parameter] public EventCallback OnCancel { get; set; }

     private bool isSaving = false;

     IEnumerable<Relationship> relationShips;

     protected override async Task OnInitializedAsync()
     {
          await base.OnInitializedAsync();

          relationShips = Enum.GetValues(typeof(Relationship)).Cast<Relationship>().Where(x=> x == Relationship.Mother || x== Relationship.Father);
     }

     private async Task HandleSaving()
     {
          try
          {
               isSaving = true;
               RequestRender();
               await InvokeUserAction(RequestSaving);
          }
          
          finally
          {
               isSaving = false;
               RequestRender();
          }
     }

     private async Task RequestSaving()
     {
          Spouse.Email = Spouse.Email.ToLowerInvariant();
          Spouse.UserName = Spouse.Email;

          if (FamilyId == Guid.Empty)
          {
               _errorMessage = "Please provide valid family id to connect.";
               Snackbar.Add(_errorMessage, Severity.Error);
               return;
          }

          var isUserExists = await UserService.ValidateUsernameAsync(Spouse.UserName);
          if (isUserExists)
          {
               _errorMessage = "Email provided is already registered with system. Please contact support";
               Snackbar.Add(_errorMessage, Severity.Error);
               return;
          }

          Spouse.FamilyId = FamilyId;
          Spouse.Password = "Test1234!";

          var souseProfile = await UserService.RegisterUserAsync(Spouse);
          if (souseProfile == null)
          {
               _errorMessage = "User can not be registered with system. Please try again in few minutes";
               Snackbar.Add(_errorMessage, Severity.Error);
          }
          else
          {
               //await UserService.ForgotUserPasswordAsync(souseProfile.Email);
               Snackbar.Add("User has been linked.", Severity.Success);
               await OnSave.InvokeAsync(souseProfile);
          }
     }

     private async Task OnCancelClickedHandler()
     {
          await OnCancel.InvokeAsync();
     }
     
}
