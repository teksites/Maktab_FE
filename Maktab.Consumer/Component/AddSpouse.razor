@inherits BaseFormComponent<AddSpouse>


@using MaktabDataContracts.Enums
@using MaktabDataContracts.Requests.Users
@using System.ComponentModel.DataAnnotations

@inject IUserService UserService

@* <MudGrid> 
     <MudItem xs="12" sm="8">*@
<MudPaper Class="pa-12">
     <MudForm @ref="_form" @bind-IsValid="@_isValid" OnValidSubmit="@(HandleSaving)" Validated="@(OnFormValidated)" Spacing="2">
          <MudTextField T="string" @bind-Value="Spouse.FirstName" Label=@L[MaktabResources.First_Name] Required="true" RequiredError=@L[MaktabResources.Msg_Info_Value_Is_Required, MaktabResources.First_Name] />
          <MudTextField T="string" @bind-Value="Spouse.LastName" Label=@L[MaktabResources.Last_Name] Required="true" RequiredError=@L[MaktabResources.Msg_Info_Value_Is_Required, MaktabResources.Last_Name] />
          <MudTextField T="string" @bind-Value="Spouse.Email" Label=@L[MaktabResources.Email] Required="true" RequiredError=@L[MaktabResources.Msg_Info_Value_Is_Required, MaktabResources.Email]
                        Validation="@(new EmailAddressAttribute() {ErrorMessage =  @L[MaktabResources.Msg_Error_Email_Address_Invalid]})" />
          <MudTextField T="string" @bind-Value="Spouse.Phone" Label=@L[MaktabResources.Phone] Required="true" RequiredError=@L[MaktabResources.Msg_Info_Value_Is_Required, MaktabResources.Phone]
                        Validation="@(new PhoneAttribute() { ErrorMessage = @L[MaktabResources.Msg_Error_Phone_Number_Invalid]})" />

          <MudSelect @bind-Value="Spouse.Relationship" Label=@L[MaktabResources.Relashion_With_Children]>
               @foreach (var margin in relationShips)
               {
                    <MudSelectItem Value="margin">@(GetRelationshipLabel(margin))</MudSelectItem>
               }
          </MudSelect>

          @if (!string.IsNullOrWhiteSpace(_errorMessage))
          {
               <MudAlert Severity="Severity.Error" Elevation="0" Class="my-4">
                    @_errorMessage
               </MudAlert>
          }

          <MudStack Direction="Row" Justify="Justify.FlexEnd" Spacing="2" Class="mt-4">
               <MudButton Type="Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!_isValid || isSaving)" StartIcon="@Icons.Material.Filled.Check" OnClick="@(HandleSaving)">
                    @if (isSaving)
                    {
                         <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                         <span>@L[MaktabResources.Msg_Processing]</span>
                    }
                    else
                    {
                         <span>@L[MaktabResources.Save]</span>
                    }
               </MudButton>

               <MudButton OnClick="@OnCancelClickedHandler" Color="Color.Secondary" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Close">@L[MaktabResources.Cancel]</MudButton>
          </MudStack>


     </MudForm>
</MudPaper>

@code {
     [Parameter] public Guid FamilyId { get; set; } = Guid.Empty;
     [Parameter] public AddUserInformation Spouse { get; set; } = new AddUserInformation();
     [Parameter, EditorRequired] public Relationship RelationshipToAdd { get; set; } = Relationship.Mother;
     [Parameter] public EventCallback<MaktabDataContracts.Responses.Users.UserInformationResponse> OnSave { get; set; }
     [Parameter] public EventCallback OnCancel { get; set; }

     private bool isSaving = false;

     IEnumerable<Relationship> relationShips;

     protected override async Task OnInitializedAsync()
     {
          await base.OnInitializedAsync();

          relationShips = Enum.GetValues(typeof(Relationship)).Cast<Relationship>().Where(x => x == RelationshipToAdd);
     }

     private async Task HandleSaving()
     {
          try
          {
               isSaving = true;
               RequestRender();
               await InvokeUserAction(RequestSaving);
          }

          finally
          {
               isSaving = false;
               RequestRender();
          }
     }

     private async Task RequestSaving()
     {
          Spouse.Email = Spouse.Email.ToLowerInvariant();
          Spouse.UserName = Spouse.Email.Trim();

          if (FamilyId == Guid.Empty)
          {
               _errorMessage = @L[MaktabResources.Msg_Error_No_Family_Id];
               Snackbar.Add(_errorMessage, Severity.Error);
               return;
          }

          var isUserExists = await UserService.ValidateUsernameAsync(Spouse.UserName);
          if (isUserExists)
          {
               _errorMessage = L[MaktabResources.Msg_Error_Email_Already_Registered];//"Email provided is already registered with system. Please contact support";
               Snackbar.Add(_errorMessage, Severity.Error);
               return;
          }

          if (Spouse.Relationship == Relationship.Unknown)
          {
               _errorMessage = L[MaktabResources.Msg_Error_User_Resgister_No_RelationShip_Defined];
               Snackbar.Add(_errorMessage, Severity.Error);
               return;
          }

          Spouse.FamilyId = FamilyId;
          Spouse.Password = "Test1234!";

          var souseProfile = await UserService.RegisterUserAsync(Spouse);
          if (souseProfile == null)
          {
               _errorMessage = L[MaktabResources.Msg_Error_Spouse_Save];//"User can not be registered with system. Please try again in few minutes";
               Snackbar.Add(_errorMessage, Severity.Error);
          }
          else
          {
               //await UserService.ForgotUserPasswordAsync(souseProfile.Email);
               Snackbar.Add(L[MaktabResources.Msg_Success_Spouse_Save], Severity.Success);
               await OnSave.InvokeAsync(souseProfile);
          }
     }

     private async Task OnCancelClickedHandler()
     {
          await OnCancel.InvokeAsync();
     }
     
}
