@inherits BaseFormComponent<ChangePassword>


@inject IUserService UserService

@* <MudGrid Justify="Justify.Center">
     <MudItem xs="12" sm="7" md="5"> *@
          <MudPaper Class="pa-6" Elevation="0">

               @if (ShowHeader)
               {
                    <MudText Typo="Typo.h4" Class="mb-6 text-center">@L[MaktabResources.Change_Password]</MudText>
               }

               <MudForm @ref="_form" @bind-IsValid="@_isValid" OnValidSubmit="@(InitiateChangePasswordRequest)" Validated="@(OnFormValidated)">


                    <MudTextField T="string" Label=@L[MaktabResources.Old_Password] HelperText=@L[MaktabResources.Msg_Info_Provide_Old_Password] @ref="oldPwField"
                                  InputType="InputType.Password"
                                  Required="true"
                                  RequiredError=@L[MaktabResources.Msg_Info_Value_Is_Required, MaktabResources.Old_Password]/>

                    <MudTextField T="string" Label=@L[MaktabResources.New_Password] HelperText=@L[MaktabResources.Msg_Info_Choose_Strong_Password] @ref="newPwField"
                                  InputType="InputType.Password"
                                  Validation="@(new Func<string, IEnumerable<string>>(PasswordStrength))" Required="true"
                                  RequiredError=@L[MaktabResources.Msg_Info_Value_Is_Required, MaktabResources.Password] />
                    <MudTextField T="string"
                                  Label=@L[MaktabResources.Password] HelperText=@L[MaktabResources.Msg_Info_Repeat_Password] InputType="InputType.Password"
                                  Validation="@(new Func<string, string>(PasswordMatch))" />

                    @if (!string.IsNullOrWhiteSpace(_errorMessage))
                    {
                         <MudAlert Severity="Severity.Error" Elevation="0" Class="my-4">
                              @_errorMessage
                         </MudAlert>
                    }

                    <MudStack Direction="Row" Justify="Justify.FlexEnd" Spacing="2" Class="mt-6">
                         

                         <MudButton Type="Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@requestingToChangePassword" OnClick="@(InitiateChangePasswordRequest)">
                              @if (requestingToChangePassword)
                              {
                                   <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                                   <span>@L[MaktabResources.Msg_Processing]</span>
                              }
                              else
                              {
                                   <span>@L[MaktabResources.Update]</span>
                              }
                         </MudButton>

                         <MudButton OnClick="@OnCancelClickedHandler" Color="Color.Secondary" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Close">Cancel</MudButton>

                    </MudStack>

               </MudForm>

          </MudPaper>
@*      </MudItem>
</MudGrid> *@

@code {

     [Parameter, EditorRequired]
     public Guid UserId { get; set; }
     [Parameter] public EventCallback<bool> OnPasswordChanged { get; set; }
     [Parameter] public EventCallback OnCancel { get; set; }
     [Parameter] public bool ShowHeader { get; set; } = true;

     private bool requestingToChangePassword = false;
     MudTextField<string> oldPwField;
     MudTextField<string> newPwField;

     private async void HandleChangePasswordRequest()
     {
          requestingToChangePassword = true;
          RequestRender();
          await InitiateChangePasswordRequest();
          requestingToChangePassword = false;
          RequestRender();
     }

     private async Task InitiateChangePasswordRequest()
     {
          //var userId = await SessionService.GetLoggedInUserSessionIdAsync();

          var changeRequest = new MaktabDataContracts.Requests.Users.UpdateUserPasswordRequest
               {
                    OldPassword = oldPwField.Value,
                    NewPassword = newPwField.Value
               };

          var result = await UserService.ChangeUserPasswordAsync(UserId, changeRequest);
          if (result)
          {



               if (OnPasswordChanged.HasDelegate)
               {
                    await OnPasswordChanged.InvokeAsync(true);
               }


          }
          else
          {
               _errorMessage = L[MaktabResources.Msg_Error_Request_Not_Processed];
          }
     }




     private async Task OnCancelClickedHandler()
     {
          if (OnCancel.HasDelegate)
          {
               await OnCancel.InvokeAsync();
          }
     }

     private string PasswordNotMatch(string arg)
     {
          if (oldPwField.Value == arg)
          {
               return L[MaktabResources.Msg_Error_Use_Diffent_New_Password];
          }

          return string.Empty;
     }

     private string PasswordMatch(string arg)
     {
          if (newPwField.Value != arg)
               return L[MaktabResources.Msg_Error_New_Password_Not_Match];
          return string.Empty;
     }
}