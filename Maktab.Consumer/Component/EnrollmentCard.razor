@inherits LocalizeableBaseComponent<EnrollmentCard>

@using MaktabDataContracts.Responses.Course
@using MudBlazor

<MudCard Class="ma-2 pa-3" Style="max-width:360px">
    <MudCardHeader>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudAvatar Icon="@Icons.Material.Filled.School" Color="Color.Primary" />
            <MudText Typo="Typo.h6" Class="ma-0">@CourseTitle</MudText>
        </MudStack>

        <MudSpacer />
          <MudChip T="StudentCourseEnrollmentResponse" Color="@GetStatusColor()" Variant="Variant.Outlined" Size="Size.Small">
               @(Enrollment.IsActive ? @L[MaktabResources.Active] : @L[MaktabResources.Inactive])
        </MudChip>
    </MudCardHeader>

    <MudCardContent>
        <MudText Typo="Typo.body2">Child: <b>@ChildName</b></MudText>
          <MudText Typo="Typo.body2">
               Daycare: @(Enrollment.WillUseDayCare ? $"{@L[MaktabResources.Yes]} ({Enrollment.DayCareDays}d)" : @L[MaktabResources.No])
          </MudText>
        @* <MudText Typo="Typo.caption" Color="Color.Secondary">Created @Enrollment.CreatedAt:d</MudText> *@
    </MudCardContent>

    <MudCardActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => OnView.InvokeAsync(Enrollment))">View</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" OnClick="@(() => OnEdit.InvokeAsync(Enrollment))">Edit</MudButton>
    </MudCardActions>
</MudCard>

@code {
    [Parameter] public StudentCourseEnrollmentResponse Enrollment { get; set; } = default!;
    [Parameter] public string CourseTitle { get; set; } = "Untitled";
    [Parameter] public string ChildName { get; set; } = "Child";
    [Parameter] public EventCallback<StudentCourseEnrollmentResponse> OnView { get; set; }
    [Parameter] public EventCallback<StudentCourseEnrollmentResponse> OnEdit { get; set; }

    private Color GetStatusColor() => Enrollment.IsActive ? Color.Success : Color.Warning;
}
