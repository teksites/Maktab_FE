@using MaktabDataContracts.Requests.Children
@using MaktabDataContracts.Responses.Children
@using MudBlazor

<MudDialog>
    <DialogContent>
        <AddChild ChildModel="@child"
                           OnSave="SaveChild"
                           OnCancel="CancelDialog" />
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter]
    MudDialog MudDialog { get; set; }

    [Parameter]
    public Guid FamilyId { get; set; }

    private AddChildRequest child { get; set; } = new();

    protected override void OnInitialized()
    {
        child.FamilyId = FamilyId;
    }

     private async void SaveChild(ChildResponse child)
    {
        await MudDialog.CloseAsync(DialogResult.Ok(child));
    }

     private async void CancelDialog()
    {
          await MudDialog.CloseAsync(DialogResult.Cancel());
    }
}
