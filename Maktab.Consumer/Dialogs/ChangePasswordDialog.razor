@inherits BaseDialog<ChangePasswordDialog>
@using MaktabDataContracts.Enums
@using MudBlazor

<MudDialog>
    <DialogContent>
          <ChangePassword UserId="@(UserId)" OnPasswordChanged="PasswordChanged" OnCancel="CancelDialog" />
    </DialogContent>
</MudDialog>

@code {

     [Parameter] public Guid UserId { get; set; } = Guid.Empty;

     protected async override Task OnInitializedAsync()
     {
          await base.OnInitializedAsync();
     }

     private void PasswordChanged(bool passwordChanged)
     {
          MudDialog.Close(DialogResult.Ok(passwordChanged));
     }

     private void CancelDialog()
     {
          MudDialog.Cancel();
     }
}
