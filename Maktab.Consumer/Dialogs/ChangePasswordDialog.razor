@inherits BaseDialog<ChangePasswordDialog>
@using MudBlazor
@using Maktab.Consumer.Helpers

<MudDialog>
    <DialogContent>
          <ChangePassword UserId="@(UserId)" ShowHeader="false" OnPasswordChanged="PasswordChanged" OnCancel="CancelDialog" />
    </DialogContent>
</MudDialog>

@code {

     [Parameter] public Guid UserId { get; set; } = Guid.Empty;

     protected async override Task OnInitializedAsync()
     {
          await base.OnInitializedAsync();
     }

     private void PasswordChanged(bool passwordChanged)
     {
          // Redirect after successful login
          NavigationManager.NavigateTo(Constants.LogoutRoute);

          MudDialog.Close(DialogResult.Ok(passwordChanged));
     }

     private void CancelDialog()
     {
          MudDialog.Cancel();
     }
}
