@using MaktabDataContracts.Enums
@using MudBlazor

<MudDialog>
    <DialogContent>
        <AddAddress AddressModel="Address" AddressType="@(AddressType)" ConnectedId="@(ConnectedId)" OnSave="SaveAddress" OnCancel="CancelDialog" />
    </DialogContent>
</MudDialog>

@code {
     [CascadingParameter]
     IMudDialogInstance MudDialog { get; set; } = default!;


     [Parameter] public AddressType AddressType { get; set; }
     [Parameter] public Guid ConnectedId { get; set; } = Guid.Empty;

     private MaktabDataContracts.Requests.Addresses.AddAddress Address { get; set; } = new();

     protected override void OnInitialized()
     {
          Address.ConnectedId = ConnectedId;
     }

     private async Task SaveAddress(MaktabDataContracts.Responses.Addresses.AddressResponse address)
     {
          MudDialog.Close(DialogResult.Ok(address));
     }

     private async void CancelDialog()
     {
          MudDialog.Cancel();
     }
}
